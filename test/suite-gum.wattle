(import ./helper :prefix "" :exit true)
(start-suite)
(import ../src/gum/args :as args)

(defmacro is [expression] `(assert ~expression))
(defmacro deftest [_ & body] `(do ~|body))

(def config
  {:rules ["--verbose" {:kind :count :short "v"}
           "--quiet" {:kind :flag :short "q"}
           "--number" {:kind :single :short "n" :value :integer :default 2}
           "--include" {:kind :multi :short "i"}
           :source {:req? true}
           :extra {:splat? true}]
   :info {:about "A test command."}})

(deftest options-and-parameters
  (def result
    (args/parse-args "sample" config
      ["-vvq" "--number=3" "-i" "one" "--include" "two"
       "file" "other"]))
  (is (= "" (get result :err)))
  (is (= 2 (get-in result [:opts "verbose"])))
  (is (= true (get-in result [:opts "quiet"])))
  (is (= 3 (get-in result [:opts "number"])))
  (is (= "one" (get (get-in result [:opts "include"]) 0)))
  (is (= "two" (get (get-in result [:opts "include"]) 1)))
  (is (= "file" (get-in result [:params :source])))
  (is (= "other" (get (get-in result [:params :extra]) 0))))

(deftest defaults-and-stop-marker
  (def result (args/parse-args "sample" config ["--" "-q"]))
  (is (= 2 (get-in result [:opts "number"])))
  (is (= "-q" (get-in result [:params :source])))
  (def literal (args/parse-args "sample" config ["--" "-q" "tail"]))
  (is (= "-q" (get-in literal [:params :source])))
  (is (= "tail" (get (get-in literal [:params :extra]) 0))))

(deftest help-and-errors
  (def help (args/parse-args "sample" config ["-h"]))
  (is (= true (get-in help [:opts "help"])))
  (is (string/find "Usage: sample" (get help :help)))
  (is (string/find "--help" (get help :help)))
  (is (= "" (get help :err)))
  (def bad (args/parse-args "sample" config ["--number" "x" "file"]))
  (is (string/find "invalid value" (get bad :err)))
  (def missing (args/parse-args "sample" config []))
  (is (string/find "required" (get missing :err)))
  (def no-value (args/parse-args "sample" config ["-n"]))
  (is (string/find "no value" (get no-value :err))))

(deftest subcommands
  (def nested
    {:subs ["run" {:short "r"
                    :rules ["--force" {:kind :flag :short "f"}]
                    :help "Run it."}
            "raw" {:help "Pass through."}]})
  (def parsed (args/parse-args "sample" nested ["r" "-f"]))
  (is (= "run" (get-in parsed [:sub :cmd])))
  (is (= true (get-in parsed [:sub :opts "force"])))
  (def raw (args/parse-args "sample" nested ["raw" "-x"]))
  (is (= "-x" (get (get-in raw [:sub :args]) 0)))
  (def help (args/parse-args "sample" nested ["help" "run"]))
  (is (string/find "Usage: sample run" (get help :help)))
  (def bad (args/parse-args "sample" nested ["run" "--wrong"]))
  (is (string/find "sample run: unrecognized" (get bad :err)))
  (is (not (string/find "sample: sample" (get bad :err)))))

(deftest function-defaults-and-hidden-options
  (def settings
    {:rules ["--choice" {:kind :single :default (fn [] "chosen")}
             "--secret" {:kind :flag :hide? true}]})
  (def parsed (args/parse-args "sample" settings []))
  (is (= "chosen" (get-in parsed [:opts "choice"])))
  (def help (args/parse-args "sample" settings ["--help"]))
  (is (not (string/find "--secret" (get help :help)))))

(deftest required-splat
  (def settings {:rules [:files {:req? true :splat? true}]})
  (def missing (args/parse-args "sample" settings []))
  (is (string/find "required" (get missing :err)))
  (def present (args/parse-args "sample" settings ["one" "two"]))
  (is (= "one" (get (get-in present [:params :files]) 0)))
  (is (= "two" (get (get-in present [:params :files]) 1))))

(deftest rest-parameter
  (def settings
    {:rules ["--quiet" {:kind :flag :short "q"}
             "--name" {:kind :single}
             :script {:rest? true}]})
  (def result
    (args/parse-args "sample" settings
      ["-q" "--name=mine" "run.wattle" "-q" "--name=other" "--" "tail"]))
  (is (= "" (get result :err)))
  (is (= true (get-in result [:opts "quiet"])))
  (is (= "mine" (get-in result [:opts "name"])))
  (def captured (get-in result [:params :script]))
  (is (= ["run.wattle" "-q" "--name=other" "--" "tail"] (freeze captured)))
  (def marked (args/parse-args "sample" settings ["--" "-q" "tail"]))
  (is (= ["-q" "tail"] (freeze (get-in marked [:params :script]))))
  (def none (args/parse-args "sample" settings ["-q"]))
  (is (= "" (get none :err)))
  (is (= nil (get-in none [:params :script])))
  (def leading
    {:rules [:mode {} :script {:rest? true :req? true}]})
  (def after (args/parse-args "sample" leading ["fast" "y" "-x"]))
  (is (= "fast" (get-in after [:params :mode])))
  (is (= ["y" "-x"] (freeze (get-in after [:params :script]))))
  (def missing (args/parse-args "sample" leading ["fast"]))
  (is (string/find "script is required" (get missing :err)))
  (def [ordered?]
    (protect (args/parse-args "sample"
               {:rules [:script {:rest? true} :more {}]} [])))
  (is (not ordered?))
  (def [doubled?]
    (protect (args/parse-args "sample"
               {:rules [:a {:splat? true} :b {:rest? true}]} [])))
  (is (not doubled?))
  (def help (args/parse-args "sample" settings ["-h"]))
  (is (string/find "[<script...>]" (get help :help))))

(deftest validation-can-be-skipped
  (def bad {:rules ["--x" {:kind :bogus}]})
  (def [checked?] (protect (args/parse-args "sample" bad [])))
  (is (not checked?))
  (def [skipped?] (protect (args/parse-args "sample" (merge bad {:validate? false}) [])))
  (is skipped?))

(deftest option-normalisation
  (def settings
    {:rules ["--quiet" {:kind :flag}
             "--number" {:kind :single :short "n" :value :integer}
             :word {}]})
  (def equals (args/parse-args "sample" settings ["--quiet=extra"]))
  (is (= true (get-in equals [:opts "quiet"])))
  (is (= "extra" (get-in equals [:params :word])))
  (def unexpected
    (args/parse-args "sample" {:rules ["--quiet" {:kind :flag}]}
      ["--quiet=extra"]))
  (is (string/find "too many parameters" (get unexpected :err)))
  (def compact (args/parse-args "sample" settings ["-n3"]))
  (is (= 3 (get-in compact [:opts "number"])))
  (def empty-value (args/parse-args "sample" settings ["--number="]))
  (is (string/find "invalid value" (get empty-value :err)))
  (def stop-marker (args/parse-args "sample" settings ["-n" "--"]))
  (is (string/find "no value" (get stop-marker :err))))

(deftest short-value-does-not-shadow-reservation
  (def settings {:rules ["--host" {:kind :single :short "h"}]})
  (def result (args/parse-args "sample" settings ["-h" "example.com"]))
  (is (= "example.com" (get-in result [:opts "host"])))
  (is (= "" (get result :err))))

(deftest parent-defaults-survive-subcommand
  (def nested
    {:rules ["--level" {:kind :single :default "1"}]
     :subs ["run" {:rules []}]})
  (def result (args/parse-args "sample" nested ["run"]))
  (is (= "1" (get-in result [:opts "level"]))))

(deftest help-abbreviation
  (def nested {:subs ["run" {:short "r" :rules []}]})
  (def help (args/parse-args "sample" nested ["h" "r"]))
  (is (string/find "Usage: sample run" (get help :help)))
  (is (= "run" (get-in help [:sub :cmd])))
  (def taken {:subs ["hop" {:short "h" :rules []}]})
  (def result (args/parse-args "sample" taken ["h"]))
  (is (= "hop" (get-in result [:sub :cmd]))))

(deftest subcommand-named-help
  (def nested {:subs ["help" {:rules []}]})
  (def result (args/parse-args "sample" nested ["help"]))
  (is (= "help" (get-in result [:sub :cmd]))))

(def implicit-config
  {:rules ["--version" {:kind :flag :short "v"}]
   :implicit "run"
   :subs ["run" {:rules ["--eval" {:kind :multi :short "e"}
                          "--quiet" {:kind :flag :short "q"}
                          :script {:rest? true}]}
          "build" {:rules []
                   :subs ["img" {:rules [:source {:req? true}
                                         :output {}]}
                          "exe" {:rules []}]}]})

(deftest implicit-subcommand
  (def bare (args/parse-args "sample" implicit-config []))
  (is (= "" (get bare :err)))
  (is (= "run" (get-in bare [:sub :cmd])))
  (def script (args/parse-args "sample" implicit-config ["foo.wattle" "-x"]))
  (is (= "run" (get-in script [:sub :cmd])))
  (is (= "-x" (get (get-in script [:sub :params :script]) 1)))
  (is (= "foo.wattle" (get (get-in script [:sub :params :script]) 0)))
  (def eval-opt
    (args/parse-args "sample" implicit-config ["-e" "(+ 1 2)" "-q"]))
  (is (= "" (get eval-opt :err)))
  (is (= "(+ 1 2)" (get (get-in eval-opt [:sub :opts "eval"]) 0)))
  (def long-opt (args/parse-args "sample" implicit-config ["--eval=1"]))
  (is (= "1" (get (get-in long-opt [:sub :opts "eval"]) 0)))
  (def root-first (args/parse-args "sample" implicit-config ["-v" "foo"]))
  (is (= true (get-in root-first [:opts "version"])))
  (is (= "foo" (get (get-in root-first [:sub :params :script]) 0)))
  (def stop (args/parse-args "sample" implicit-config ["--" "-q"]))
  (is (= "-q" (get (get-in stop [:sub :params :script]) 0)))
  (def named (args/parse-args "sample" implicit-config ["run" "foo"]))
  (is (= "foo" (get (get-in named [:sub :params :script]) 0)))
  (def help (args/parse-args "sample" implicit-config ["-h"]))
  (is (string/find "Without a subcommand, 'run' is assumed." (get help :help)))
  (is (string/find "[<subcommand>]" (get help :help)))
  (def sub-help (args/parse-args "sample" implicit-config ["help" "nope"]))
  (is (string/find "unrecognized subcommand 'nope'" (get sub-help :err))))

(deftest implicit-must-name-a-subcommand
  (def [ok?]
    (protect (args/parse-args "sample"
               {:implicit "go" :subs ["run" {:rules []}]} [])))
  (is (not ok?)))

(deftest nested-subcommands
  (def img (args/parse-args "sample" implicit-config ["build" "img" "a" "b"]))
  (is (= "" (get img :err)))
  (is (= "build" (get-in img [:sub :cmd])))
  (is (= "img" (get-in img [:sub :sub :cmd])))
  (is (= "b" (get-in img [:sub :sub :params :output])))
  (def missing (args/parse-args "sample" implicit-config ["build" "img"]))
  (is (string/find "source is required" (get missing :err)))
  (def bare (args/parse-args "sample" implicit-config ["build"]))
  (is (string/find "no subcommand provided" (get bare :err)))
  (def inner-help (args/parse-args "sample" implicit-config ["build" "img" "-h"]))
  (is (string/find "Usage: sample build img" (get inner-help :help)))
  (def via-help (args/parse-args "sample" implicit-config ["help" "build" "img"]))
  (is (string/find "Usage: sample build img" (get via-help :help)))
  (def mid-help (args/parse-args "sample" implicit-config ["help" "build"]))
  (is (string/find "type 'sample help build <subcommand>'" (get mid-help :help)))
  (is (string/find "Usage: sample build <subcommand>" (get mid-help :help)))
  (def bad-help (args/parse-args "sample" implicit-config ["help" "build" "zip"]))
  (is (string/find "unrecognized subcommand 'zip'" (get bad-help :err))))

(deftest params-and-subs-rejected
  (def [ok?]
    (protect (args/parse-args "sample"
               {:rules [:target {}] :subs ["run" {:rules []}]} [])))
  (is (not ok?)))

(deftest false-converts-and-defaults
  (def settings
    {:rules ["--enabled" {:kind :single :value (fn [v] (= v "yes"))
                           :default false}]})
  (def defaulted (args/parse-args "sample" settings []))
  (is (= false (get-in defaulted [:opts "enabled"])))
  (def explicit (args/parse-args "sample" settings ["--enabled" "no"]))
  (is (= false (get-in explicit [:opts "enabled"]))))

(deftest invalid-short-and-value
  (def [dup-short?]
    (protect (args/parse-args "sample"
               {:rules ["--a" {:kind :flag :short "x"}
                        "--b" {:kind :flag :short "x"}]} [])))
  (def [long-short?]
    (protect (args/parse-args "sample"
               {:rules ["--a" {:kind :flag :short "xy"}]} [])))
  (def [bad-value?]
    (protect (args/parse-args "sample"
               {:rules ["--a" {:kind :single :value :float}]} [])))
  (is (not dup-short?))
  (is (not long-short?))
  (is (not bad-value?)))

(deftest invalid-config
  (def [valid-kind?]
    (protect (args/parse-args "sample"
               {:rules ["--bad" {:kind :unknown}]} [])))
  (def [valid-splat?]
    (protect (args/parse-args "sample"
               {:rules [:first {:splat? true}
                        :second {:splat? true}]} [])))
  (is (not valid-kind?))
  (is (not valid-splat?)))

(end-suite)
