(import ./helper :prefix "" :exit true)
(start-suite)

(assert true) ; smoke test

; This suite's setup resolves a real path and seeds from the system CSPRNG.
; Both functions still exist without JANET_REALPATH and JANET_CRYPTORAND, and
; only raise when called, so these are runtime checks rather than compwhen on
; the bindings.
(unless (and (first (protect (os/realpath ".")))
             (first (protect (os/cryptorand 1))))
  (end-suite)
  (os/exit 0))

; Testing here is stateful since we are manipulating the filesystem.

; Copy since not exposed in boot.wattle
(defn- pkg-rpath
  [path]
  (string/replace-all "\\" "/" (os/realpath path)))

; Test mkdir -> rmdir
(assert (os/mkdir "tempdir123"))
(rmrf "tempdir123")

; Setup a temporary prefix for manipultation
(math/seedrandom (os/cryptorand 16))
(def prefix (randdir))
(rmrf prefix)
(assert (os/mkdir prefix))
(put! root-env *prefix* (pkg-rpath prefix))
(unless (os/getenv "VERBOSE")
  (setdyn *out* !""))
(assert (empty? (pkg/list)) "initial pkg/list")
(assert (empty? (pkg/topolist)) "initial pkg/topolist")

; Try (and fail) to install sample-pkg (missing deps)
(assert-error "missing dependencies sample-dep1, sample-dep2"
              (pkg/install "./examples/sample-pkg"))
(assert (empty? (pkg/list)))

; Install deps (dep1 as :auto-remove)
(assert-no-error "sample-dep2"
                 (pkg/install "./examples/sample-dep2"))
(assert (= 1 (length (pkg/list))))
(assert-no-error "sample-dep1" (pkg/install "./examples/sample-dep1"))
(assert (= 2 (length (pkg/list))))

(assert-no-error "sample-dep2 reinstall" (pkg/reinstall "sample-dep2"))
(assert-no-error "sample-dep1 reinstall" (pkg/reinstall "sample-dep1" :auto-remove true))

(assert (= 2 (length (pkg/list))) "packages are listed correctly 1")
(assert (= 2 (length (pkg/topolist))) "packages are listed correctly 2")

; Now install sample-pkg
(assert-no-error "sample-pkg install" (pkg/install "./examples/sample-pkg"))

(assert-error "" (pkg/install "./examples/sample-dep11111"))

(assert (= 3 (length (pkg/list))) "packages are listed correctly 3")
(assert (= 3 (length (pkg/topolist))) "packages are listed correctly 4")

; Check topolist has not bad order
(def tlist (pkg/topolist))
(assert (> (index-of "sample-pkg" tlist) (index-of "sample-dep2" tlist)) "topolist 1")
(assert (> (index-of "sample-pkg" tlist) (index-of "sample-dep1" tlist)) "topolist 2")
(assert (> (index-of "sample-dep1" tlist) (index-of "sample-dep2" tlist)) "topolist 3")

; Prune should do nothing
(assert-no-error "first prune" (pkg/prune))
(assert (= 3 (length (pkg/list))) "packages are listed correctly 3")
(assert (= 3 (length (pkg/topolist))) "packages are listed correctly 4")

; Check that we can import the main dependency
(import mymod)
(assert (= 288 (mymod/myfn 12)) "using sample-pkg")

; The prefix is a root: modules go to lib/wattle under it.
(def root (pkg-rpath prefix))
(assert (os/stat (string root "/lib/wattle/mymod.wattle" ) :mode)
        "a module is installed under lib/wattle")
(assert (nil? (os/stat (string root "/mymod.wattle") :mode))
        "a module is not installed in the root")

; Manual uninstall of dep1 and dep2 shouldn't work either since that would break dependencies
(assert-error "cannot uninstall sample-dep1, breaks dependent packages @[\"sample-pkg\"]"
              (pkg/uninstall "sample-dep1"))

; Check package file aliases
(assert-no-error "sample-pkg-aliases install" (pkg/install "./examples/sample-pkg-aliases"))
(assert (= 4 (length (pkg/list))) "packages are listed correctly 5")
(assert-no-error "import aliases" (import aliases-mod))
(assert (deep= (range 12) (aliases-mod/fun 12)) "using sample-pkg-aliases")
(assert-no-error "aliases uninstall" (pkg/uninstall "sample-pkg-aliases"))

; Now re-install sample-pkg as auto-remove
(assert-no-error "sample-pkg install" (pkg/reinstall "sample-pkg" :auto-remove true))

; Reinstallation should also work without being concerned about breaking dependencies
(assert-no-error "reinstall dep" (pkg/reinstall "sample-dep2"))

; Now prune should get rid of everything except sample-dep2. It prints a count
; and then one line for each package as it is removed.
(def prune-out !"")
(assert-no-error "second prune" (with-dyns [*out* prune-out] (pkg/prune)))
(def prune-lines (string/split "\n" (string prune-out)))
(assert (= "pruning 2 packages" (first prune-lines)) "prune prints the count")
(assert (= 2 (length (filter #(string/has-prefix? "uninstalling " $) prune-lines)))
        "prune prints a line for each package it removes")
(assert (empty? (filter #(string/has-prefix? "uninstall " $) prune-lines))
        "prune prints no preview list")

; Now check that we exactly one package left, which is dep2
(assert (= 1 (length (pkg/list))) "packages are listed correctly 5")
(assert (= 1 (length (pkg/topolist))) "packages are listed correctly 6")

; Which we can uninstall manually
(assert-no-error "uninstall dep2" (pkg/uninstall "sample-dep2"))

; Now check package listing is again empty
(assert (= 0 (length (pkg/list))) "packages are listed correctly 7")
(assert (= 0 (length (pkg/topolist))) "packages are listed correctly 8")

; Programs and man pages go to bin and share/man under the root, and modules
; to lib/wattle. Reinstalling goes through pkg/pack, which recreates each kind.
(def hello (string root "/bin/hello"))
(def hello-man (string root "/share/man/man1/hello.1"))
(def bin-mod (string root "/lib/wattle/bin-mod.wattle"))
(assert-no-error "sample-pkg-bin install"
                 (with-dyns [*err* !""] (pkg/install "./examples/sample-pkg-bin")))
(assert (os/stat hello :mode) "a program is installed under bin")
(assert (os/stat hello-man :mode) "a man page is installed under share/man")
(assert (os/stat bin-mod :mode) "a module of the same package is under lib/wattle")
; WASI and Windows report no permission bits.
(unless (or (= :windows (os/which)) (= :wasi (os/which)))
  (assert (string/has-prefix? "rwx" (os/stat hello :permissions))
          "a program is executable"))
(assert (= "sample-pkg-bin" (pkg/whois hello)) "pkg/whois finds a program")
(assert-no-error "sample-pkg-bin reinstall"
                 (with-dyns [*err* !""] (pkg/reinstall "sample-pkg-bin")))
(assert (and (os/stat hello :mode) (os/stat hello-man :mode) (os/stat bin-mod :mode))
        "reinstalling recreates programs, man pages and modules")
(assert-no-error "sample-pkg-bin uninstall" (pkg/uninstall "sample-pkg-bin"))
(assert (and (nil? (os/stat hello :mode)) (nil? (os/stat hello-man :mode))
             (nil? (os/stat bin-mod :mode)))
        "uninstalling removes programs, man pages and modules")

; A package script's `dependencies` hook is not run, and add-bin records
; :has-exe and not :has-bin-script.
(def hook-dir (string prefix "-hook"))
(rmrf hook-dir)
(assert (os/mkdir hook-dir))
(assert (os/mkdir (string hook-dir "/pkg")))
(spit (string hook-dir "/hookbin") "#!/bin/sh\n")
(spit (string hook-dir "/pkg/info.edn") "{:name \"hook-pkg\"}")
(spit (string hook-dir "/pkg/init.wattle")
      (string "(defn dependencies [manifest &] (put! manifest :deps-hook-ran true))\n"
              "(defn install [manifest &] (pkg/add-bin manifest \"hookbin\"))\n"))
(assert-no-error "hook-pkg install"
                 (with-dyns [*err* !""] (pkg/install hook-dir)))
(def hook-manifest (pkg/manifest "hook-pkg"))
(assert (nil? (get hook-manifest :deps-hook-ran)) "the dependencies hook is not run")
(assert (get hook-manifest :has-exe) "add-bin records :has-exe")
(assert (nil? (get hook-manifest :has-bin-script)) "add-bin does not record :has-bin-script")
(assert-no-error "hook-pkg uninstall" (pkg/uninstall "hook-pkg"))
(rmrf hook-dir)

; With no usable prefix the pkg functions raise.
(with-dyns [*prefix* ""]
  (def [ok message] (protect (pkg/list)))
  (assert (not ok) "pkg/list raises with an empty prefix")
  (assert (and (string? message) (string/find "WATTLE_PREFIX" message))
          "the error names WATTLE_PREFIX"))

; Try installing a package that is missing package script
(assert-error-value "package missing package script"
                    "package must contain pkg.wattle, pkg/init.wattle or an info.edn that declares :artifacts or :man"
                    (pkg/install "./examples/sample-bad-pkg1"))
(assert (= 0 (length (pkg/list))) "check failure 0")
(assert (= 0 (length (pkg/topolist))) "check failure 1")

; Try installing a package that fails check
(assert-error-value "package check hook fails"
                    "Check failed!"
                    (pkg/install "./examples/sample-bad-pkg2" :check true))
(assert (= 0 (length (pkg/list))) "check failure 0")
(assert (= 0 (length (pkg/topolist))) "check failure 1")

; A package with no script is installed from its info file. The case has no
; :exe artifact, since building one needs a prefix that holds the runtime's
; source, so it covers the :man entries and the rejections.
(def info-dir (string prefix "-info"))
(defn- make-info-pkg
  [info-text]
  (rmrf info-dir)
  (assert (os/mkdir info-dir))
  (assert (os/mkdir (string info-dir "/docs")))
  (spit (string info-dir "/docs/man-pkg.1") ".TH MAN-PKG 1\n")
  (spit (string info-dir "/docs/man-pkg.7") ".TH MAN-PKG 7\n")
  (spit (string info-dir "/docs/man-pkg.txt") "not a manual page\n")
  (spit (string info-dir "/info.edn") info-text))

(make-info-pkg "{:name \"man-pkg\" :man [\"docs/man-pkg.1\" \"docs/man-pkg.7\"]}")
(assert-no-error "info-only install" (with-dyns [*err* !""] (pkg/install info-dir)))
(assert (string/find "MAN-PKG 1" (slurp (string prefix "/share/man/man1/man-pkg.1")))
        "a .1 file goes to man1")
(assert (string/find "MAN-PKG 7" (slurp (string prefix "/share/man/man7/man-pkg.7")))
        "a .7 file goes to man7")
(assert (= [] (get (pkg/manifest "man-pkg") :hooks)) "an info-only package has no hooks")
; The command line prints the message of an error and, for a package that is
; already installed, the command that installs it again. It prints no trace.
(do
  (def err-file (string prefix "-stderr"))
  (def f (file/open err-file :wb))
  (def status (os/execute [(dyn :executable) "-p" (dyn *prefix*) "pkg" "install" info-dir]
                          :p {:out f :err f}))
  (file/close f)
  (def text (string (slurp err-file)))
  (assert (= 1 status) "installing an installed package exits with status 1")
  (assert (= text (string "error: package \"man-pkg\" is already installed\n"
                          "use 'wattle pkg reinstall man-pkg' to install it again\n"))
          "the message is followed by the hint and nothing else")
  (rmrf err-file))
(assert-no-error "info-only reinstall" (with-dyns [*err* !""] (pkg/reinstall "man-pkg")))
(assert (string/find "MAN-PKG 1" (slurp (string prefix "/share/man/man1/man-pkg.1")))
        "reinstalling an info-only package installs its pages again")
(assert-no-error "info-only uninstall" (pkg/uninstall "man-pkg"))
(assert (nil? (os/stat (string prefix "/share/man/man1/man-pkg.1") :mode))
        "uninstalling removes the pages of an info-only package")

; A bug in a package script keeps its stack trace on the command line, since
; only the errors that pkg raises on purpose are printed as a message.
(do
  (def bug-dir (string prefix "-bug"))
  (def err-file (string prefix "-stderr"))
  (rmrf bug-dir)
  (assert (os/mkdir bug-dir))
  (assert (os/mkdir (string bug-dir "/pkg")))
  (spit (string bug-dir "/pkg/info.edn") "{:name \"bug-pkg\"}")
  (spit (string bug-dir "/pkg/init.wattle") "(defn install [manifest &] (+ 1 nil))\n")
  (def f (file/open err-file :wb))
  (def status (os/execute [(dyn :executable) "-p" (dyn *prefix*) "pkg" "install" bug-dir]
                          :p {:out f :err f}))
  (file/close f)
  (def text (string (slurp err-file)))
  (assert (= 1 status) "a hook that fails exits with status 1")
  (assert (string/has-prefix? "error: could not find method" text)
          "the message of the failure is printed")
  (assert (string/find "\n  in " text) "the stack trace of a failing hook is printed")
  (assert (= 0 (length (pkg/list))) "a package whose hook fails is not installed")
  (rmrf bug-dir)
  (rmrf err-file))

(make-info-pkg "{:name \"man-pkg\" :man [\"docs/man-pkg.1\" \"docs/man-pkg.txt\"]}")
(assert-error "a :man entry with no section" (with-dyns [*err* !""] (pkg/install info-dir)))
(assert (= 0 (length (pkg/list))) "a bad :man entry installs nothing")
(assert (nil? (os/stat (string prefix "/share/man/man1/man-pkg.1") :mode))
        "a bad :man entry leaves no page behind")

(make-info-pkg "{:name \"man-pkg\" :artifacts [{:type :lib :name \"x\" :root \"x.zig\"}]}")
(assert-error "a :lib artifact without a script" (with-dyns [*err* !""] (pkg/install info-dir)))
(assert (= 0 (length (pkg/list))) "a :lib artifact without a script installs nothing")

(make-info-pkg "{:name \"man-pkg\"}")
(assert-error-value "an info file that declares neither"
                    "package must contain pkg.wattle, pkg/init.wattle or an info.edn that declares :artifacts or :man"
                    (pkg/install info-dir))
(rmrf info-dir)

; Installing from a tarball or a Git repository. The sources are file:// URLs,
; so no network is used. The case is skipped where a tool is missing and on
; Windows, where a file:// URL has a different form.
(def- null (unless (= :windows (os/which)) (file/open "/dev/null" :wb)))

(defn- tool?
  [name]
  (def [ok status] (protect (os/execute [name "--version"] :p {:out null :err null})))
  (and ok (= 0 status)))

(defn- sh
  [& args]
  (assert (= 0 (os/execute args :p {:out null :err null})) (string/join " " args)))

(when (and (not= :windows (os/which)) (tool? "curl") (tool? "tar") (tool? "git"))
  (def src-dir (string (os/realpath prefix) "-src"))
  (def demo-dir (string src-dir "/demo"))
  (def demo-module (string prefix "/lib/wattle/demo.wattle"))
  (rmrf src-dir)
  (assert (os/mkdir src-dir))
  (assert (os/mkdir demo-dir))
  (assert (os/mkdir (string demo-dir "/pkg")))
  (spit (string demo-dir "/pkg/info.edn") "{:name \"demo\"}")
  (spit (string demo-dir "/pkg/init.wattle")
        "(defn install [manifest &] (pkg/add-file manifest \"demo.wattle\"))\n")
  (spit (string demo-dir "/demo.wattle") "; one\n")
  (defn- text [] (slurp demo-module))
  (defn- install-quietly [& args] (with-dyns [*err* !""] (pkg/install |args)))
  (defn- no-fetch-left [] (nil? (os/stat (string prefix "/lib/wattle/.fetch") :mode)))

  ; A tarball and a gzipped tarball each install, record only their source,
  ; reinstall from a new download and leave no temporary directory.
  (each [name flags] [["demo.tar" "-cf"] ["demo.tar.gz" "-czf"]]
    (def archive (string src-dir "/" name))
    (def url (string "file://" archive))
    (sh "tar" flags archive "-C" src-dir "demo")
    (assert-no-error (string name " install") (install-quietly url))
    (def manifest (pkg/manifest "demo"))
    (assert (= url (get manifest :source)) (string name " records its source"))
    (assert (nil? (get manifest :local-source)) (string name " records no temporary path"))
    (assert (string/find "one" (text)) (string name " installs the module"))
    (assert (no-fetch-left) (string name " leaves no temporary directory"))
    (spit demo-module "; changed\n")
    (assert-no-error (string name " reinstall") (with-dyns [*err* !""] (pkg/reinstall "demo")))
    (assert (string/find "one" (text)) (string name " reinstalls from a new download"))
    (assert-no-error (string name " uninstall") (pkg/uninstall "demo")))

  ; A tarball that fails to download raises and leaves nothing behind.
  (assert-error "a missing tarball" (install-quietly (string "file://" src-dir "/nothere.tar")))
  (assert (no-fetch-left) "a failed download leaves no temporary directory")
  (assert (= 0 (length (pkg/list))) "a failed download installs nothing")

  ; A Git repository installs at its default branch, or at the ref given.
  (def git ["git" "-C" demo-dir "-c" "commit.gpgsign=false" "-c" "user.name=t" "-c" "user.email=t@t"])
  (sh "git" "-C" demo-dir "init" "-q" "-b" "main")
  (sh "git" "-C" demo-dir "add" "-A")
  (sh |git "commit" "-q" "-m" "one")
  (sh "git" "-C" demo-dir "tag" "v1")
  (spit (string demo-dir "/demo.wattle") "; two\n")
  (sh |git "commit" "-q" "-a" "-m" "two")
  (def repo (string "file://" demo-dir))
  (assert-no-error "git install" (install-quietly repo))
  (assert (string/find "two" (text)) "git install reads the default branch")
  (assert (= repo (get (pkg/manifest "demo") :source)) "git install records its source")
  (assert-no-error "git uninstall" (pkg/uninstall "demo"))
  (assert-no-error "git install at a ref" (install-quietly repo :ref "v1"))
  (assert (string/find "one" (text)) "git install at a ref reads that ref")
  (assert (= "v1" (get (pkg/manifest "demo") :ref)) "git install records its ref")
  (spit demo-module "; changed\n")
  (assert-no-error "git reinstall" (with-dyns [*err* !""] (pkg/reinstall "demo")))
  (assert (string/find "one" (text)) "git reinstall keeps the ref")
  (assert (no-fetch-left) "git install leaves no temporary directory")
  (assert-no-error "git at a ref uninstall" (pkg/uninstall "demo"))
  (assert-error "a missing ref" (install-quietly repo :ref "no-such-ref"))
  (assert (= 0 (length (pkg/list))) "a missing ref installs nothing")

  ; A ref is accepted only for a Git repository.
  (assert-error "a ref with a directory" (install-quietly demo-dir :ref "v1"))
  (assert-error "a ref with a tarball"
                (install-quietly (string "file://" src-dir "/demo.tar") :ref "v1"))
  (rmrf src-dir))

(rmrf prefix)

(end-suite)
