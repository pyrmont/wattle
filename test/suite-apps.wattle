(import ./helper :prefix "" :exit true)
(start-suite)

(assert true) ; smoke test

; This suite's setup resolves a real path and seeds from the system CSPRNG.
; Both functions remain bound when realpath or cryptographic random support
; is disabled. They raise when called, so capability checks run at runtime.
(unless (and (first (protect (os/realpath ".")))
             (first (protect (os/cryptorand 1))))
  (end-suite)
  (os/exit 0))

; Testing here is stateful since we are manipulating the filesystem.

; Copy since not exposed in boot.wattle
(defn- app-rpath
  [path]
  (string/replace-all "\\" "/" (os/realpath path)))

; Test mkdir -> rmdir
(assert (os/mkdir "tempdir123"))
(rmrf "tempdir123")

; Setup a temporary prefix for manipultation
(math/seedrandom (os/cryptorand 16))
(def prefix (randdir))
(rmrf prefix)
(assert (os/mkdir prefix))
(put! root-env *prefix* (app-rpath prefix))
(unless (os/getenv "VERBOSE")
  (setdyn *out* !""))
(assert (empty? (app/list)) "initial app/list")

; Install app-dep1 and app-dep2.
(assert-no-error "app-dep2"
                 (app/install "./examples/app-dep2"))
(assert (= 1 (length (app/list))))
(assert-no-error "app-dep1" (app/install "./examples/app-dep1"))
(assert (= 2 (length (app/list))))

(assert-no-error "app-dep2 upgrade" (app/upgrade "app-dep2"))
(assert-no-error "app-dep1 upgrade" (app/upgrade "app-dep1"))

(assert (= 2 (length (app/list))) "applications are listed correctly 1")

; Now install app-composed
(assert-no-error "app-composed install" (app/install "./examples/app-composed"))

; A directory that does not exist is read as a Git repository, and the error
; carries what git wrote where processes can be run.
(compif (dyn 'os/execute)
  (let [message (try (app/install "./examples/app-dep111111") ([e] e))]
    (assert (and (string? message)
                 (string/has-prefix? "git exited with status 128\nfatal: repository" message)
                 (string/find "app-dep111111" message))
            "a missing directory is reported with the message of git"))
  (assert-error "a missing directory is an error" (app/install "./examples/app-dep111111")))

(assert (= 3 (length (app/list))) "applications are listed correctly 3")

; Check that we can import the main dependency
(import mymod)
(assert (= 288 (mymod/myfn 12)) "using app-composed")

; The prefix is a root: modules go to lib/wattle under it.
(def root (app-rpath prefix))
(assert (os/stat (string root "/lib/wattle/mymod.wattle" ) :mode)
        "a module is installed under lib/wattle")
(assert (nil? (os/stat (string root "/mymod.wattle") :mode))
        "a module is not installed in the root")

; Check application file aliases
(assert-no-error "app-alias install" (app/install "./examples/app-alias"))
(assert (= 4 (length (app/list))) "applications are listed correctly 5")
(assert-no-error "import aliases" (import aliases-mod))
(assert (deep= (range 12) (aliases-mod/fun 12)) "using app-alias")
(assert-no-error "aliases remove" (app/remove "app-alias"))

; With no name, upgrade installs every application again.
(assert-no-error "upgrade all" (app/upgrade))
(assert (= 3 (length (app/list))) "upgrading all keeps the applications")

; Remove each application in turn.
(assert-no-error "remove app-composed" (app/remove "app-composed"))
(assert-no-error "remove app-dep1" (app/remove "app-dep1"))
(assert (= 1 (length (app/list))) "applications are listed correctly 6")
(assert-no-error "remove app-dep2" (app/remove "app-dep2"))

; Now check application listing is again empty
(assert (= 0 (length (app/list))) "applications are listed correctly 7")

; Programs and man pages go to bin and share/man under the root, and modules
; to lib/wattle. Upgrading goes through app/pack, which recreates each kind.
(def hello (string root "/bin/hello"))
(def hello-man (string root "/share/man/man1/hello.1"))
(def bin-mod (string root "/lib/wattle/bin-mod.wattle"))
(assert-no-error "app-program install"
                 (with-dyns [*err* !""] (app/install "./examples/app-program")))
(assert (os/stat hello :mode) "a program is installed under bin")
(assert (os/stat hello-man :mode) "a man page is installed under share/man")
(assert (os/stat bin-mod :mode) "a module of the same application is under lib/wattle")
; WASI and Windows report no permission bits.
(unless (or (= :windows (os/which)) (= :wasi (os/which)))
  (assert (string/has-prefix? "rwx" (os/stat hello :permissions))
          "a program is executable"))
(assert (= "app-program" (app/whois hello)) "app/whois finds a program")
(assert-no-error "app-program upgrade"
                 (with-dyns [*err* !""] (app/upgrade "app-program")))
(assert (and (os/stat hello :mode) (os/stat hello-man :mode) (os/stat bin-mod :mode))
        "upgrading recreates programs, man pages and modules")
(assert-no-error "app-program remove" (app/remove "app-program"))
(assert (and (nil? (os/stat hello :mode)) (nil? (os/stat hello-man :mode))
             (nil? (os/stat bin-mod :mode)))
        "removing removes programs, man pages and modules")

; An application script's `dependencies` hook is not run, and add-bin records
; :has-exe and not :has-bin-script.
(def hook-dir (string prefix "-hook"))
(rmrf hook-dir)
(assert (os/mkdir hook-dir))
(assert (os/mkdir (string hook-dir "/pkg")))
(spit (string hook-dir "/hookbin") "#!/bin/sh\n")
(spit (string hook-dir "/info.edn") "{:name \"hook-app\"}")
(spit (string hook-dir "/pkg/init.wattle")
      (string "(defn dependencies [manifest &] (put! manifest :deps-hook-ran true))\n"
              "(defn install [manifest &] (app/add-bin manifest \"hookbin\"))\n"))
(assert-no-error "hook-app install"
                 (with-dyns [*err* !""] (app/install hook-dir)))
(def hook-manifest (app/manifest "hook-app"))
(assert (nil? (get hook-manifest :deps-hook-ran)) "the dependencies hook is not run")
(assert (get hook-manifest :has-exe) "add-bin records :has-exe")
(assert (nil? (get hook-manifest :has-bin-script)) "add-bin does not record :has-bin-script")
(assert-no-error "hook-app remove" (app/remove "hook-app"))
(rmrf hook-dir)

; With no usable prefix the app functions raise.
(with-dyns [*prefix* ""]
  (def [ok message] (protect (app/list)))
  (assert (not ok) "app/list raises with an empty prefix")
  (assert (and (string? message) (string/find "WATTLE_PREFIX" message))
          "the error names WATTLE_PREFIX"))

; Try installing an application that is missing a script
(assert-error-value "application missing script"
                    "application must contain pkg.wattle, pkg/init.wattle or an info.edn that declares :artifacts or :man"
                    (app/install "./examples/app-empty"))
(assert (= 0 (length (app/list))) "check failure 0")
(assert (= 0 (length (app/list))) "check failure 1")

; Try installing an application that fails check
(assert-error-value "application check hook fails"
                    "Check failed!"
                    (app/install "./examples/app-check" :check true))
(assert (= 0 (length (app/list))) "check failure 0")
(assert (= 0 (length (app/list))) "check failure 1")

; Runs the wattle executable with the prefix of this suite and args. Returns the
; exit status and what the command wrote to standard error, which has line-end
; for each newline. Standard output goes to its own file, so that the order of
; the two does not matter.
(compwhen (dyn 'os/execute)
(defn- run-cli
  [& args]
  (def out-file (string prefix "-cli-out"))
  (def err-file (string prefix "-cli-err"))
  (def out (file/open out-file :wb))
  (def err (file/open err-file :wb))
  (def status (os/execute [(dyn :executable) "-p" (dyn *prefix*) |args] :p {:out out :err err}))
  (file/close out)
  (file/close err)
  (def text (string (slurp err-file)))
  (rmrf out-file)
  (rmrf err-file)
  [status text]))

; An application with no script is installed from its info file. The case has no
; :exe artifact, since building one needs a prefix that holds the runtime's
; source, so it covers the :man entries and the rejections.
(def info-dir (string prefix "-info"))
(defn- make-info-app
  [info-text]
  (rmrf info-dir)
  (assert (os/mkdir info-dir))
  (assert (os/mkdir (string info-dir "/docs")))
  (spit (string info-dir "/docs/man-app.1") ".TH MAN-PKG 1\n")
  (spit (string info-dir "/docs/man-app.7") ".TH MAN-PKG 7\n")
  (spit (string info-dir "/docs/man-app.txt") "not a manual page\n")
  (spit (string info-dir "/info.edn") info-text))

(make-info-app "{:name \"man-app\" :man [\"docs/man-app.1\" \"docs/man-app.7\"]}")
(assert-no-error "info-only install" (with-dyns [*err* !""] (app/install info-dir)))
(assert (string/find "MAN-PKG 1" (slurp (string prefix "/share/man/man1/man-app.1")))
        "a .1 file goes to man1")
(assert (string/find "MAN-PKG 7" (slurp (string prefix "/share/man/man7/man-app.7")))
        "a .7 file goes to man7")
(assert (= [] (get (app/manifest "man-app") :hooks)) "an info-only application has no hooks")
; The command line prints the message of an error and, for an application that is
; already installed, the command that installs it again. It prints no trace.
(compwhen (dyn 'os/execute)
  (do
    (def [status text] (run-cli "apps" "install" info-dir))
    (assert (= 1 status) "installing an installed application exits with status 1")
    (assert (= text (string "error: application \"man-app\" is already installed" line-end
                            "use 'wattle apps upgrade man-app' to install it again" line-end))
            "the message is followed by the hint and nothing else")))
(assert-no-error "info-only upgrade" (with-dyns [*err* !""] (app/upgrade "man-app")))
(assert (string/find "MAN-PKG 1" (slurp (string prefix "/share/man/man1/man-app.1")))
        "upgrading an info-only application installs its pages again")
(assert-no-error "info-only remove" (app/remove "man-app"))
(assert (nil? (os/stat (string prefix "/share/man/man1/man-app.1") :mode))
        "removing removes the pages of an info-only application")

; A bug in an application script keeps its stack trace on the command line, since
; only the errors that the commands raise on purpose are printed as a message.
(compwhen (dyn 'os/execute)
  (do
    (def bug-dir (string prefix "-bug"))
    (rmrf bug-dir)
    (assert (os/mkdir bug-dir))
    (assert (os/mkdir (string bug-dir "/pkg")))
    (spit (string bug-dir "/info.edn") "{:name \"bug-app\"}")
    (spit (string bug-dir "/pkg/init.wattle") "(defn install [manifest &] (+ 1 nil))\n")
    (def [status text] (run-cli "apps" "install" bug-dir))
    (assert (= 1 status) "a hook that fails exits with status 1")
    (assert (string/has-prefix? "error: could not find method" text)
            "the message of the failure is printed")
    (assert (string/find (string line-end "  in ") text) "the stack trace of a failing hook is printed")
    (assert (= 0 (length (app/list))) "an application whose hook fails is not installed")
    (rmrf bug-dir)))

; The build of an :exe artifact is not captured, so its output reaches the
; command line as it is written. The prefix of this suite holds no source of the
; runtime, so the build fails, and the command line prints what the build wrote
; and then the failure of the build. `wattle build exe` needs `os/spawn`, and
; the command line runs on the same build as this suite, so the case is compiled
; where both bindings exist.
(compwhen (and (dyn 'os/execute) (dyn 'os/spawn))
  (do
    (make-info-app "{:name \"exe-app\" :artifacts [{:type :exe :name \"x\" :entry \"x.wattle\"}]}")
    (def [status text] (run-cli "apps" "install" info-dir))
    (assert (= 1 status) "a build that fails exits with status 1")
    (assert (string/find "the Wattle package is not at" text) "the output of the build is shown")
    (assert (string/has-suffix? (string "error: wattle build exe exited with status 1" line-end) text)
            "the failure of the build is the last line")
    (assert (= 0 (length (app/list))) "an application whose build fails is not installed")))

(make-info-app "{:name \"man-app\" :man [\"docs/man-app.1\" \"docs/man-app.txt\"]}")
(assert-error "a :man entry with no section" (with-dyns [*err* !""] (app/install info-dir)))
(assert (= 0 (length (app/list))) "a bad :man entry installs nothing")
(assert (nil? (os/stat (string prefix "/share/man/man1/man-app.1") :mode))
        "a bad :man entry leaves no page behind")

(make-info-app "{:name \"man-app\" :artifacts [{:type :lib :name \"x\" :root \"x.zig\"}]}")
(assert-error "a :lib artifact without a script" (with-dyns [*err* !""] (app/install info-dir)))
(assert (= 0 (length (app/list))) "a :lib artifact without a script installs nothing")

(make-info-app "{:name \"man-app\"}")
(assert-error-value "an info file that declares neither"
                    "application must contain pkg.wattle, pkg/init.wattle or an info.edn that declares :artifacts or :man"
                    (app/install info-dir))
(rmrf info-dir)

; Installing from a tarball or a Git repository. The sources are file:// URLs,
; so no network is used. The case is skipped where a tool is missing and on
; Windows, where a file:// URL has a different form.
(compwhen (dyn 'os/execute)
(def- null (unless (= :windows (os/which)) (file/open "/dev/null" :wb)))

(defn- tool?
  [name]
  (def [ok status] (protect (os/execute [name "--version"] :p {:out null :err null})))
  (and ok (= 0 status)))

(defn- sh
  [& args]
  (assert (= 0 (os/execute args :p {:out null :err null})) (string/join " " args)))

(when (and (not= :windows (os/which)) (tool? "curl") (tool? "tar") (tool? "git"))
  (def src-dir (string (os/realpath prefix) "-src"))
  (def demo-dir (string src-dir "/demo"))
  (def demo-module (string prefix "/lib/wattle/demo.wattle"))
  (rmrf src-dir)
  (assert (os/mkdir src-dir))
  (assert (os/mkdir demo-dir))
  (assert (os/mkdir (string demo-dir "/pkg")))
  (spit (string demo-dir "/info.edn") "{:name \"demo\"}")
  (spit (string demo-dir "/pkg/init.wattle")
        "(defn install [manifest &] (app/add-file manifest \"demo.wattle\"))\n")
  (spit (string demo-dir "/demo.wattle") "; one\n")
  (defn- module-text [] (slurp demo-module))
  (defn- install-quietly [& args] (with-dyns [*err* !""] (app/install |args)))
  (defn- no-fetch-left [] (nil? (os/stat (string prefix "/lib/wattle/.fetch") :mode)))

  ; A tarball and a gzipped tarball each install, record only their source,
  ; upgrade from a new download and leave no temporary directory.
  (each [name flags] [["demo.tar" "-cf"] ["demo.tar.gz" "-czf"]]
    (def archive (string src-dir "/" name))
    (def url (string "file://" archive))
    (sh "tar" flags archive "-C" src-dir "demo")
    (assert-no-error (string name " install") (install-quietly url))
    (def manifest (app/manifest "demo"))
    (assert (= url (get manifest :source)) (string name " records its source"))
    (assert (nil? (get manifest :local-source)) (string name " records no temporary path"))
    (assert (string/find "one" (module-text)) (string name " installs the module"))
    (assert (no-fetch-left) (string name " leaves no temporary directory"))
    (spit demo-module "; changed\n")
    (assert-no-error (string name " upgrade") (with-dyns [*err* !""] (app/upgrade "demo")))
    (assert (string/find "one" (module-text)) (string name " upgrades from a new download"))
    (assert-no-error (string name " remove") (app/remove "demo")))

  ; A tarball that fails to download raises and leaves nothing behind.
  (def missing-url (string "file://" src-dir "/nothere.tar"))
  (let [message (try (install-quietly missing-url) ([e] e))]
    (assert (and (string? message)
                 (string/has-prefix? "curl exited with status 37\ncurl: (37)" message)
                 (string/find "nothere.tar" message))
            "a missing tarball is reported with the message of curl"))
  (let [[status text] (run-cli "apps" "install" missing-url)]
    (assert (= 1 status) "a failed download exits with status 1")
    (assert (string/has-prefix? (string "error: curl exited with status 37" line-end "curl: (37)") text)
            "the command line prints the message of curl as the error"))
  (assert (no-fetch-left) "a failed download leaves no temporary directory")
  (assert (= 0 (length (app/list))) "a failed download installs nothing")

  ; A Git repository installs at its default branch, or at the ref given.
  (def git ["git" "-C" demo-dir "-c" "commit.gpgsign=false" "-c" "user.name=t" "-c" "user.email=t@t"])
  (sh "git" "-C" demo-dir "init" "-q" "-b" "main")
  (sh "git" "-C" demo-dir "add" "-A")
  (sh |git "commit" "-q" "-m" "one")
  (sh "git" "-C" demo-dir "tag" "v1")
  (spit (string demo-dir "/demo.wattle") "; two\n")
  (sh |git "commit" "-q" "-a" "-m" "two")
  (def repo (string "file://" demo-dir))
  (assert-no-error "git install" (install-quietly repo))
  (assert (string/find "two" (module-text)) "git install reads the default branch")
  (assert (= repo (get (app/manifest "demo") :source)) "git install records its source")
  (assert-no-error "git remove" (app/remove "demo"))
  (assert-no-error "git install at a ref" (install-quietly repo :ref "v1"))
  (assert (string/find "one" (module-text)) "git install at a ref reads that ref")
  (assert (= "v1" (get (app/manifest "demo") :ref)) "git install records its ref")
  (spit demo-module "; changed\n")
  (assert-no-error "git upgrade" (with-dyns [*err* !""] (app/upgrade "demo")))
  (assert (string/find "one" (module-text)) "git upgrade keeps the ref")
  (assert (no-fetch-left) "git install leaves no temporary directory")
  (assert-no-error "git at a ref remove" (app/remove "demo"))
  (let [message (try (install-quietly repo :ref "no-such-ref") ([e] e))]
    (assert (and (string? message)
                 (string/has-prefix? "git exited with status 128\n" message)
                 (string/find "no-such-ref" message))
            "a missing ref is reported with the message of git"))
  (assert (= 0 (length (app/list))) "a missing ref installs nothing")

  ; A ref is accepted only for a Git repository.
  (assert-error "a ref with a directory" (install-quietly demo-dir :ref "v1"))
  (assert-error "a ref with a tarball"
                (install-quietly (string "file://" src-dir "/demo.tar") :ref "v1"))
  (rmrf src-dir)))

; dep/vendor copies the :vendored entries of info.edn into a project. The
; sources are directories, which app/install reads the same way as a tarball
; or a Git repository.
(let [base (string (app-rpath prefix) "-vendor")
      src (string base "/src")
      proj (string base "/proj")
      s "/"]
  (rmrf base)
  (assert (os/mkdir base))
  (assert (os/mkdir src))
  (assert (os/mkdir (string src "/lib")))
  (assert (os/mkdir proj))
  (spit (string src "/a.wattle") "(def x 1)\n")
  (spit (string src "/lib/b.wattle") "(def y 2)\n")
  (spit (string src "/LICENSE") "licence\n")
  (defn info [vendored] (spit (string proj "/info.edn") (string/format "%y" {:vendored vendored})))
  (defn vendor [] (with-dyns [*out* !""] (dep/vendor proj)))
  (defn has [path] (os/stat (string proj s path) :mode))

  (info [{:name "whole" :url src :prefix "deps/whole"}
         {:name "some" :url src :prefix "deps/some"
          :paths ["a.wattle" ["lib" "sub"] ["LICENSE" "L"]]}])
  (assert (= 2 (vendor)) "vendor returns the number of entries")
  (assert (= :file (has "deps/whole/a.wattle")) "an entry without :paths copies the whole source")
  (assert (= :file (has "deps/whole/lib/b.wattle")) "an entry without :paths copies subdirectories")
  (assert (= :file (has "deps/some/a.wattle")) "a string in :paths keeps its name")
  (assert (= :file (has "deps/some/sub/b.wattle")) "a pair in :paths renames a directory")
  (assert (= :file (has "deps/some/L")) "a pair in :paths renames a file")
  (assert (nil? (has "deps/some/LICENSE")) "an entry copies only its :paths")
  (assert (empty? (app/list)) "vendor installs no application")

  (spit (string proj "/deps/whole/a.wattle") "changed\n")
  (vendor)
  (assert (= "(def x 1)\n" (string (slurp (string proj "/deps/whole/a.wattle"))))
          "vendor replaces a file that differs")

  (info [{:name "bad" :url src :paths ["../x"]}])
  (assert-error "a path above the project" (vendor))
  (info [{:name "bad" :url src :prefix "/tmp/x"}])
  (assert-error "an absolute prefix" (vendor))
  (info [{:name "bad" :url src :paths [["a.wattle" "../a"]]}])
  (assert-error "a destination above the project" (vendor))
  (info [{:name "bad" :url src :paths ["missing"]}])
  (assert-error "a path the source lacks" (vendor))
  (info [{:name "bad"}])
  (assert-error "an entry without a :url" (vendor))
  (info [{:name "first" :url src :prefix "deps/first"} {:name "bad" :paths ["x"]}])
  (assert-error "a later invalid entry" (vendor))
  (assert (nil? (has "deps/first")) "an invalid entry stops vendor before any copy")
  (info [])
  (assert-error "no entries" (vendor))
  (spit (string proj "/info.edn") "{:name \"p\" :dependencies [\"missing\"]}")
  (assert-error "no :vendored" (vendor))
  (rmrf base))

(rmrf prefix)

(end-suite)
