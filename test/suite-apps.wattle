(import ./helper :prefix "" :exit true)
(start-suite)

(assert true) ; smoke test

; This suite's setup resolves a real path and seeds from the system CSPRNG.
; Both functions remain bound when realpath or cryptographic random support
; is disabled. They raise when called, so capability checks run at runtime.
(unless (and (first (protect (os/realpath ".")))
             (first (protect (os/cryptorand 1))))
  (end-suite)
  (os/exit 0))

; Testing here is stateful since we are manipulating the filesystem.

; Copy since not exposed in boot.wattle
(defn- app-rpath
  [path]
  (string/replace-all "\\" "/" (os/realpath path)))

; Test mkdir -> rmdir
(assert (os/mkdir "tempdir123"))
(rmrf "tempdir123")

; Setup a temporary prefix for manipultation
(math/seedrandom (os/cryptorand 16))
(def prefix (randdir))
(rmrf prefix)
(assert (os/mkdir prefix))
(put! root-env *prefix* (app-rpath prefix))
(unless (os/getenv "VERBOSE")
  (setdyn *out* !""))
(assert (empty? (app/list)) "initial app/list")

; Install app-dep1 and app-dep2.
(assert-no-error "app-dep2"
                 (with-dyns [*err* !""] (app/install "./examples/app-dep2")))
(assert (= 1 (length (app/list))))
(assert-no-error "app-dep1" (with-dyns [*err* !""] (app/install "./examples/app-dep1")))
(assert (= 2 (length (app/list))))

(assert-no-error "app-dep2 upgrade" (with-dyns [*err* !""] (app/upgrade "app-dep2")))
(assert-no-error "app-dep1 upgrade" (with-dyns [*err* !""] (app/upgrade "app-dep1")))

(assert (= 2 (length (app/list))) "applications are listed correctly 1")

; Now install app-composed
(assert-no-error "app-composed install" (with-dyns [*err* !""] (app/install "./examples/app-composed")))

; A directory that does not exist is read as a Git repository, and the error
; carries what git wrote where processes can be run.
(compif (dyn 'os/execute)
  (let [message (try (app/install "./examples/app-dep111111") ([e] e))]
    (assert (and (string? message)
                 (string/has-prefix? "git exited with status 128\nfatal: repository" message)
                 (string/find "app-dep111111" message))
            "a missing directory is reported with the message of git"))
  (assert-error "a missing directory is an error" (app/install "./examples/app-dep111111")))

(assert (= 3 (length (app/list))) "applications are listed correctly 3")

; The prefix is a root: programs go to bin under it.
(def root (app-rpath prefix))
(assert (os/stat (string root "/bin/app-composed") :mode)
        "a program is installed under bin")
(assert (nil? (os/stat (string root "/app-composed") :mode))
        "a program is not installed in the root")

; Check application script aliases: hooks.wattle in place of hooks/init.wattle.
(assert-no-error "app-alias install" (with-dyns [*err* !""] (app/install "./examples/app-alias")))
(assert (= 4 (length (app/list))) "applications are listed correctly 5")
(assert (os/stat (string root "/bin/app-alias") :mode) "a hooks.wattle script runs")
(assert-no-error "aliases remove" (app/remove "app-alias"))
(assert (nil? (os/stat (string root "/bin/app-alias") :mode)) "removing removes the program")

; With no name, upgrade installs every application again.
(assert-no-error "upgrade all" (with-dyns [*err* !""] (app/upgrade)))
(assert (= 3 (length (app/list))) "upgrading all keeps the applications")

; Remove each application in turn.
(assert-no-error "remove app-composed" (app/remove "app-composed"))
(assert-no-error "remove app-dep1" (app/remove "app-dep1"))
(assert (= 1 (length (app/list))) "applications are listed correctly 6")
(assert-no-error "remove app-dep2" (app/remove "app-dep2"))

; Now check application listing is again empty
(assert (= 0 (length (app/list))) "applications are listed correctly 7")

; Programs and man pages go to bin and share/man under the root. Upgrading goes
; through app/pack, which recreates each kind.
(def hello (string root "/bin/hello"))
(def hello-man (string root "/share/man/man1/hello.1"))
(assert-no-error "app-program install"
                 (with-dyns [*err* !""] (app/install "./examples/app-program")))
(assert (os/stat hello :mode) "a program is installed under bin")
(assert (os/stat hello-man :mode) "a man page is installed under share/man")
; WASI and Windows report no permission bits.
(unless (or (= :windows (os/which)) (= :wasi (os/which)))
  (assert (string/has-prefix? "rwx" (os/stat hello :permissions))
          "a program is executable"))
(assert (= "app-program" (app/whois hello)) "app/whois finds a program")
(assert-no-error "app-program upgrade"
                 (with-dyns [*err* !""] (app/upgrade "app-program")))
(assert (and (os/stat hello :mode) (os/stat hello-man :mode))
        "upgrading recreates programs and man pages")
(assert-no-error "app-program remove" (app/remove "app-program"))
(assert (and (nil? (os/stat hello :mode)) (nil? (os/stat hello-man :mode)))
        "removing removes programs and man pages")

;; Placement: an application is in apps/<group>/<name> under lib/wattle, and the
; group directory goes with its last application.
(assert-no-error "app-dep1 install for placement" (with-dyns [*err* !""] (app/install "./examples/app-dep1")))
(def dep1-dir (string root "/lib/wattle/apps/org.wattle.examples/app-dep1"))
(assert (os/stat (string dep1-dir "/manifest.edn") :mode) "the manifest is in the application directory")
(assert (os/stat (string dep1-dir "/info.edn") :mode) "the info file is copied into the application directory")
(assert (os/stat (string dep1-dir "/hooks/init.wattle") :mode) "the hooks directory is copied")
(assert (= "org.wattle.examples" (get (app/manifest "app-dep1") :group)) "the manifest records the group")
(assert (app/installed? "app-dep1") "an installed application is found by its name")
(assert (nil? (os/stat (string root "/lib/wattle/pkg") :mode)) "nothing is installed in lib/wattle/pkg")

; A name is unique across groups.
(let [other (string prefix "-group")]
  (rmrf other)
  (assert (os/mkdir other))
  (spit (string other "/info.edn") "{:group \"org.wattle.other\" :name \"app-dep1\" :man []}")
  (assert-error-value "the same name in another group"
                      "application \"app-dep1\" is already installed"
                      (app/install other))
  (assert (and (= 1 (length (app/list))) (= "app-dep1" (first (app/list)))) "a refused install adds nothing")
  (rmrf other))
(assert-no-error "app-dep1 remove for placement" (app/remove "app-dep1"))
(assert (nil? (os/stat (string root "/lib/wattle/apps/org.wattle.examples") :mode))
        "the group directory is removed with its last application")
(assert (not (app/installed? "app-dep1")) "a removed application is not installed")

; The group is required, and the group and the name are each one directory name.
(let [bad (string prefix "-bad")]
  (defn- try-install [info-text]
    (rmrf bad)
    (assert (os/mkdir bad))
    (spit (string bad "/info.edn") info-text)
    (def result (protect (with-dyns [*err* !""] (app/install bad))))
    (rmrf bad)
    result)
  (let [[ok message] (try-install "{:name \"x\" :man []}")]
    (assert (and (not ok) (string/find "info.edn needs a :group" message))
            "an application with no group says that info.edn needs one"))
  (each [what text] [["an empty group" "{:group \"\" :name \"x\" :man []}"]
                     ["a group of .." "{:group \"..\" :name \"x\" :man []}"]
                     ["a group of ." "{:group \".\" :name \"x\" :man []}"]
                     ["a group with a slash" "{:group \"a/b\" :name \"x\" :man []}"]
                     ["a group with a backslash" "{:group \"a\\\\b\" :name \"x\" :man []}"]
                     ["a group that is not a string" "{:group 3 :name \"x\" :man []}"]
                     ["an empty name" "{:group \"g\" :name \"\" :man []}"]
                     ["a name of .." "{:group \"g\" :name \"..\" :man []}"]
                     ["a name with a slash" "{:group \"g\" :name \"a/b\" :man []}"]]
    (assert (not (first (try-install text))) (string what " is refused")))
  (assert (= 0 (length (app/list))) "a refused group or name installs nothing")
  (assert (empty? (os/dir (string root "/lib/wattle/apps"))) "a refused install leaves no directory behind"))

; An application script's `dependencies` hook is not run, and add-bin records
; :has-exe and not :has-bin-script.
(def hook-dir (string prefix "-hook"))
(rmrf hook-dir)
(assert (os/mkdir hook-dir))
(assert (os/mkdir (string hook-dir "/hooks")))
(spit (string hook-dir "/hookbin") "#!/bin/sh\n")
(spit (string hook-dir "/info.edn") "{:group \"org.wattle.tests\" :name \"hook-app\"}")
(spit (string hook-dir "/hooks/init.wattle")
      (string "(defn dependencies [manifest &] (put! manifest :deps-hook-ran true))\n"
              "(defn install [manifest &] (app/add-bin manifest \"hookbin\"))\n"))
(assert-no-error "hook-app install"
                 (with-dyns [*err* !""] (app/install hook-dir)))
(def hook-manifest (app/manifest "hook-app"))
(assert (nil? (get hook-manifest :deps-hook-ran)) "the dependencies hook is not run")
(assert (get hook-manifest :has-exe) "add-bin records :has-exe")
(assert (nil? (get hook-manifest :has-bin-script)) "add-bin does not record :has-bin-script")
(assert-no-error "hook-app remove" (app/remove "hook-app"))
(rmrf hook-dir)

; With no usable prefix the app functions raise.
(with-dyns [*prefix* ""]
  (def [ok message] (protect (app/list)))
  (assert (not ok) "app/list raises with an empty prefix")
  (assert (and (string? message) (string/find "WATTLE_PREFIX" message))
          "the error names WATTLE_PREFIX"))

; Try installing an application that is missing a script
(assert-error-value "application missing script"
                    "application must contain hooks.wattle, hooks/init.wattle or an info.edn that declares :artifacts or :man"
                    (app/install "./examples/app-empty"))
(assert (= 0 (length (app/list))) "check failure 0")
(assert (= 0 (length (app/list))) "check failure 1")

; Try installing an application that fails check
(assert-error-value "application check hook fails"
                    "Check failed!"
                    (app/install "./examples/app-check" :check true))
(assert (= 0 (length (app/list))) "check failure 0")
(assert (= 0 (length (app/list))) "check failure 1")

; Runs the wattle executable with the prefix of this suite and args. Returns the
; exit status and what the command wrote to standard error, which has line-end
; for each newline. Standard output goes to its own file, so that the order of
; the two does not matter.
(compwhen (dyn 'os/execute)
; The path of the executable is made absolute so that a case can change the
; working directory.
(def- cli-exe
  (let [exe (dyn :executable)]
    (if (or (string/find "/" exe) (string/find "\\" exe)) (os/realpath exe) exe)))

(defn- run-cli
  [& args]
  (def out-file (string prefix "-cli-out"))
  (def err-file (string prefix "-cli-err"))
  (def out (file/open out-file :wb))
  (def err (file/open err-file :wb))
  (def status (os/execute [cli-exe "-p" (dyn *prefix*) |args] :p {:out out :err err}))
  (file/close out)
  (file/close err)
  (def text (string (slurp err-file)))
  (rmrf out-file)
  (rmrf err-file)
  [status text]))

; An application with no script is installed from its info file. The case has no
; :exe artifact, since building one needs a prefix that holds the runtime's
; source, so it covers the :man entries and the rejections.
(def info-dir (string prefix "-info"))
(defn- make-info-app
  [info-text]
  (rmrf info-dir)
  (assert (os/mkdir info-dir))
  (assert (os/mkdir (string info-dir "/docs")))
  (spit (string info-dir "/docs/man-app.1") ".TH MAN-PKG 1\n")
  (spit (string info-dir "/docs/man-app.7") ".TH MAN-PKG 7\n")
  (spit (string info-dir "/docs/man-app.txt") "not a manual page\n")
  (spit (string info-dir "/info.edn") info-text))

(make-info-app "{:group \"org.wattle.tests\" :name \"man-app\" :man [\"docs/man-app.1\" \"docs/man-app.7\"]}")
(assert-no-error "info-only install" (with-dyns [*err* !""] (app/install info-dir)))
(assert (string/find "MAN-PKG 1" (slurp (string prefix "/share/man/man1/man-app.1")))
        "a .1 file goes to man1")
(assert (string/find "MAN-PKG 7" (slurp (string prefix "/share/man/man7/man-app.7")))
        "a .7 file goes to man7")
(assert (= [] (get (app/manifest "man-app") :hooks)) "an info-only application has no hooks")
; The command line prints the message of an error and, for an application that is
; already installed, the command that installs it again. It prints no trace.
(compwhen (dyn 'os/execute)
  (do
    (def [status text] (run-cli "apps" "install" info-dir))
    (assert (= 1 status) "installing an installed application exits with status 1")
    (assert (= text (string "error: application \"man-app\" is already installed" line-end
                            "use 'wattle apps upgrade man-app' to install it again" line-end))
            "the message is followed by the hint and nothing else")))
(assert-no-error "info-only upgrade" (with-dyns [*err* !""] (app/upgrade "man-app")))
(assert (string/find "MAN-PKG 1" (slurp (string prefix "/share/man/man1/man-app.1")))
        "upgrading an info-only application installs its pages again")
(assert-no-error "info-only remove" (app/remove "man-app"))
(assert (nil? (os/stat (string prefix "/share/man/man1/man-app.1") :mode))
        "removing removes the pages of an info-only application")

; A bug in an application script keeps its stack trace on the command line, since
; only the errors that the commands raise on purpose are printed as a message.
(compwhen (dyn 'os/execute)
  (do
    (def bug-dir (string prefix "-bug"))
    (rmrf bug-dir)
    (assert (os/mkdir bug-dir))
    (assert (os/mkdir (string bug-dir "/hooks")))
    (spit (string bug-dir "/info.edn") "{:group \"org.wattle.tests\" :name \"bug-app\"}")
    (spit (string bug-dir "/hooks/init.wattle") "(defn install [manifest &] (+ 1 nil))\n")
    (def [status text] (run-cli "apps" "install" bug-dir))
    (assert (= 1 status) "a hook that fails exits with status 1")
    (assert (string/has-prefix? "error: could not find method" text)
            "the message of the failure is printed")
    (assert (string/find (string line-end "  in ") text) "the stack trace of a failing hook is printed")
    (assert (= 0 (length (app/list))) "an application whose hook fails is not installed")
    (rmrf bug-dir)))

; The build of an :exe artifact is not captured, so its output reaches the
; command line as it is written. The prefix of this suite holds no source of the
; runtime, so the build fails, and the command line prints what the build wrote
; and then the failure of the build. `wattle build exe` needs `os/spawn`, and
; the command line runs on the same build as this suite, so the case is compiled
; where both bindings exist.
(compwhen (and (dyn 'os/execute) (dyn 'os/spawn))
  (do
    (make-info-app "{:group \"org.wattle.tests\" :name \"exe-app\" :artifacts [{:type :exe :name \"x\" :entry \"x.wattle\"}]}")
    (def [status text] (run-cli "apps" "install" info-dir))
    (assert (= 1 status) "a build that fails exits with status 1")
    (assert (string/find "the Wattle package is not at" text) "the output of the build is shown")
    (assert (string/has-suffix? (string "error: wattle build exe exited with status 1" line-end) text)
            "the failure of the build is the last line")
    (assert (= 0 (length (app/list))) "an application whose build fails is not installed")))

(make-info-app "{:group \"org.wattle.tests\" :name \"man-app\" :man [\"docs/man-app.1\" \"docs/man-app.txt\"]}")
(assert-error "a :man entry with no section" (with-dyns [*err* !""] (app/install info-dir)))
(assert (= 0 (length (app/list))) "a bad :man entry installs nothing")
(assert (nil? (os/stat (string prefix "/share/man/man1/man-app.1") :mode))
        "a bad :man entry leaves no page behind")

(make-info-app "{:group \"org.wattle.tests\" :name \"man-app\" :artifacts [{:type :lib :name \"x\" :root \"x.zig\"}]}")
(assert-error "a :lib artifact without a script" (with-dyns [*err* !""] (app/install info-dir)))
(assert (= 0 (length (app/list))) "a :lib artifact without a script installs nothing")

(make-info-app "{:group \"org.wattle.tests\" :name \"man-app\"}")
(assert-error-value "an info file that declares neither"
                    "application must contain hooks.wattle, hooks/init.wattle or an info.edn that declares :artifacts or :man"
                    (app/install info-dir))
(rmrf info-dir)

; Installing from a tarball or a Git repository. The sources are file:// URLs,
; so no network is used. The case is skipped where a tool is missing and on
; Windows, where a file:// URL has a different form.
(compwhen (dyn 'os/execute)
(def- null (unless (= :windows (os/which)) (file/open "/dev/null" :wb)))

(defn- tool?
  [name]
  (def [ok status] (protect (os/execute [name "--version"] :p {:out null :err null})))
  (and ok (= 0 status)))

(defn- sh
  [& args]
  (assert (= 0 (os/execute args :p {:out null :err null})) (string/join " " args)))

(when (and (not= :windows (os/which)) (tool? "curl") (tool? "tar") (tool? "git"))
  (def src-dir (string (os/realpath prefix) "-src"))
  (def demo-dir (string src-dir "/demo"))
  (def demo-module (string prefix "/bin/demo"))
  (rmrf src-dir)
  (assert (os/mkdir src-dir))
  (assert (os/mkdir demo-dir))
  (assert (os/mkdir (string demo-dir "/hooks")))
  (spit (string demo-dir "/info.edn") "{:group \"org.wattle.tests\" :name \"demo\"}")
  (spit (string demo-dir "/hooks/init.wattle")
        "(defn install [manifest &] (app/add-bin manifest \"demo\"))\n")
  (spit (string demo-dir "/demo") "; one\n")
  (defn- module-text [] (slurp demo-module))
  (defn- install-quietly [& args] (with-dyns [*err* !""] (app/install |args)))
  (defn- git-out [& args]
    (def path (string prefix "-git-out"))
    (def f (file/open path :wb))
    (os/execute ["git" "-C" demo-dir |args] :p {:out f :err null})
    (file/close f)
    (def text (string/trim (string (slurp path))))
    (rmrf path)
    text)
  (defn- no-fetch-left [] (nil? (os/stat (string prefix "/lib/wattle/.fetch") :mode)))

  ; A tarball and a gzipped tarball each install, record only their source,
  ; upgrade from a new download and leave no temporary directory.
  (each [name flags] [["demo.tar" "-cf"] ["demo.tar.gz" "-czf"]]
    (def archive (string src-dir "/" name))
    (def url (string "file://" archive))
    (sh "tar" flags archive "-C" src-dir "demo")
    (assert-no-error (string name " install") (install-quietly url))
    (def manifest (app/manifest "demo"))
    (assert (= url (get manifest :source)) (string name " records its source"))
    (assert (nil? (get manifest :local-source)) (string name " records no temporary path"))
    (assert (= "sha256:ba6d11c1cbbd2742f203a78023a872dd35fa5e7e7a4d7265044f9c158665c93e" (get manifest :rev))
            (string name " records the hash of the unpacked files"))
    (assert (string/find "one" (module-text)) (string name " installs the program"))
    (assert (no-fetch-left) (string name " leaves no temporary directory"))
    (spit demo-module "; changed\n")
    (assert-no-error (string name " upgrade") (with-dyns [*err* !""] (app/upgrade "demo")))
    (assert (string/find "one" (module-text)) (string name " upgrades from a new download"))
    (assert-no-error (string name " remove") (app/remove "demo")))

  ; A tarball that fails to download raises and leaves nothing behind.
  (def missing-url (string "file://" src-dir "/nothere.tar"))
  (let [message (try (install-quietly missing-url) ([e] e))]
    (assert (and (string? message)
                 (string/has-prefix? "curl exited with status 37\ncurl: (37)" message)
                 (string/find "nothere.tar" message))
            "a missing tarball is reported with the message of curl"))
  (let [[status text] (run-cli "apps" "install" missing-url)]
    (assert (= 1 status) "a failed download exits with status 1")
    (assert (string/has-prefix? (string "error: curl exited with status 37" line-end "curl: (37)") text)
            "the command line prints the message of curl as the error"))
  (assert (no-fetch-left) "a failed download leaves no temporary directory")
  (assert (= 0 (length (app/list))) "a failed download installs nothing")

  ; A Git repository installs at its default branch, or at the ref given.
  (def git ["git" "-C" demo-dir "-c" "commit.gpgsign=false" "-c" "user.name=t" "-c" "user.email=t@t"])
  (sh "git" "-C" demo-dir "init" "-q" "-b" "main")
  (sh "git" "-C" demo-dir "add" "-A")
  (sh |git "commit" "-q" "-m" "one")
  (sh "git" "-C" demo-dir "tag" "v1")
  (spit (string demo-dir "/demo") "; two\n")
  (sh |git "commit" "-q" "-a" "-m" "two")
  (def repo (string "file://" demo-dir))
  (assert-no-error "git install" (install-quietly repo))
  (assert (string/find "two" (module-text)) "git install reads the default branch")
  (assert (= repo (get (app/manifest "demo") :source)) "git install records its source")
  (assert (= (git-out "rev-parse" "HEAD") (get (app/manifest "demo") :rev))
          "git install records the commit hash")
  (spit (string demo-dir "/demo") "; three\n")
  (sh |git "commit" "-q" "-a" "-m" "three")
  (assert-no-error "git upgrade to a new commit" (with-dyns [*err* !""] (app/upgrade "demo")))
  (assert (= (git-out "rev-parse" "HEAD") (get (app/manifest "demo") :rev))
          "upgrading records the new commit hash")
  (assert-no-error "git remove" (app/remove "demo"))
  (assert-no-error "git install at a ref" (install-quietly repo :ref "v1"))
  (assert (string/find "one" (module-text)) "git install at a ref reads that ref")
  (assert (= "v1" (get (app/manifest "demo") :ref)) "git install records its ref")
  (assert (= (git-out "rev-parse" "v1") (get (app/manifest "demo") :rev))
          "git install at a ref records the commit hash of the ref")
  (spit demo-module "; changed\n")
  (assert-no-error "git upgrade" (with-dyns [*err* !""] (app/upgrade "demo")))
  (assert (string/find "one" (module-text)) "git upgrade keeps the ref")
  (assert (no-fetch-left) "git install leaves no temporary directory")
  (assert-no-error "git at a ref remove" (app/remove "demo"))
  (let [message (try (install-quietly repo :ref "no-such-ref") ([e] e))]
    (assert (and (string? message)
                 (string/has-prefix? "git exited with status 128\n" message)
                 (string/find "no-such-ref" message))
            "a missing ref is reported with the message of git"))
  (assert (= 0 (length (app/list))) "a missing ref installs nothing")

  ; A ref is accepted only for a Git repository.
  (assert-error "a ref with a directory" (install-quietly demo-dir :ref "v1"))
  (assert-error "a ref with a tarball"
                (install-quietly (string "file://" src-dir "/demo.tar") :ref "v1"))

  ; Vendoring needs no prefix. A tarball is unpacked under .wattle in the
  ; project, which is gone afterwards.
  (let [proj (string src-dir "/vendor-proj")]
    (assert (os/mkdir proj))
    (spit (string proj "/info.edn")
          (string/format "%y" {:vendored [{:name "fetched" :url (string "file://" src-dir "/demo.tar")
                                           :prefix "deps/fetched"}]}))
    (assert (= 1 (with-dyns [*prefix* "" *out* !""] (dep/vendor proj)))
            "vendor fetches a tarball with an empty prefix")
    (assert (os/stat (string proj "/deps/fetched/demo") :mode) "the fetched source is copied")
    (assert (nil? (os/stat (string proj "/.wattle") :mode)) "vendor leaves no .wattle directory behind")
    (assert (no-fetch-left) "vendor fetches nothing under the prefix"))
  (rmrf src-dir)))

; dep/vendor copies the :vendored entries of info.edn into a project. The
; sources are directories, which app/install reads the same way as a tarball
; or a Git repository.
(let [base (string (app-rpath prefix) "-vendor")
      src (string base "/src")
      proj (string base "/proj")
      s "/"]
  (rmrf base)
  (assert (os/mkdir base))
  (assert (os/mkdir src))
  (assert (os/mkdir (string src "/lib")))
  (assert (os/mkdir proj))
  (spit (string src "/a.wattle") "(def x 1)\n")
  (spit (string src "/lib/b.wattle") "(def y 2)\n")
  (spit (string src "/LICENSE") "licence\n")
  (defn info [vendored] (spit (string proj "/info.edn") (string/format "%y" {:vendored vendored})))
  (defn vendor [] (with-dyns [*out* !""] (dep/vendor proj)))
  (defn has [path] (os/stat (string proj s path) :mode))

  (info [{:name "whole" :url src :prefix "deps/whole"}
         {:name "some" :url src :prefix "deps/some"
          :paths ["a.wattle" ["lib" "sub"] ["LICENSE" "L"]]}])
  (assert (= 2 (vendor)) "vendor returns the number of entries")
  (assert (nil? (has "deps/manifest.edn")) "vendor writes no record of the revisions")
  ; Nothing is hashed, so a symbolic link in a source does not stop vendor.
  (when (first (protect (os/link (string src "/a.wattle") (string src "/link") true)))
    (info [{:name "linked" :url src :prefix "deps/linked"}])
    (assert (= 1 (vendor)) "vendor copies a source that has a symbolic link")
    (os/rm (string src "/link"))
    (info [{:name "whole" :url src :prefix "deps/whole"}
           {:name "some" :url src :prefix "deps/some"
            :paths ["a.wattle" ["lib" "sub"] ["LICENSE" "L"]]}]))
  (assert (= :file (has "deps/whole/a.wattle")) "an entry without :paths copies the whole source")
  (assert (= :file (has "deps/whole/lib/b.wattle")) "an entry without :paths copies subdirectories")
  (assert (= :file (has "deps/some/a.wattle")) "a string in :paths keeps its name")
  (assert (= :file (has "deps/some/sub/b.wattle")) "a pair in :paths renames a directory")
  (assert (= :file (has "deps/some/L")) "a pair in :paths renames a file")
  (assert (nil? (has "deps/some/LICENSE")) "an entry copies only its :paths")
  (assert (empty? (app/list)) "vendor installs no application")
  (with-dyns [*prefix* ""]
    (assert (= 2 (vendor)) "vendor copies local sources with an empty prefix"))
  (compwhen (dyn 'os/execute)
    (let [cwd (os/cwd)]
      (os/cd proj)
      (defer (os/cd cwd)
        (let [[status text] (with-dyns [*prefix* ""] (run-cli "deps" "vendor"))]
          (assert (= 0 status) "wattle deps vendor runs with an empty prefix")
          (assert (nil? (string/find "prefix" text)) "wattle deps vendor does not mention the prefix")))))

  (spit (string proj "/deps/whole/a.wattle") "changed\n")
  (vendor)
  (assert (= "(def x 1)\n" (string (slurp (string proj "/deps/whole/a.wattle"))))
          "vendor replaces a file that differs")

  (info [{:name "bad" :url src :paths ["../x"]}])
  (assert-error "a path above the project" (vendor))
  (info [{:name "bad" :url src :prefix "/tmp/x"}])
  (assert-error "an absolute prefix" (vendor))
  (info [{:name "bad" :url src :paths [["a.wattle" "../a"]]}])
  (assert-error "a destination above the project" (vendor))
  (info [{:name "bad" :url src :paths ["missing"]}])
  (assert-error "a path the source lacks" (vendor))
  (info [{:name "bad"}])
  (assert-error "an entry without a :url" (vendor))
  (info [{:name "first" :url src :prefix "deps/first"} {:name "bad" :paths ["x"]}])
  (assert-error "a later invalid entry" (vendor))
  (assert (nil? (has "deps/first")) "an invalid entry stops vendor before any copy")
  (let [src2 (string base "/src2")]
    (assert (os/mkdir src2))
    (spit (string src2 "/other.wattle") "(def z 3)\n")
    (info [{:name "dup" :url src :prefix "deps/one"} {:name "dup" :url src2 :prefix "deps/two"}])
    (let [[ok message] (protect (vendor))]
      (assert (and (not ok) (string/find "dup" message) (string/find "more than one" message))
              "two entries with one name are refused"))
    (assert (and (nil? (has "deps/one")) (nil? (has "deps/two")))
            "a duplicate name stops vendor before any copy")
    (rmrf src2))
  (info [])
  (assert-error "no entries" (vendor))
  (spit (string proj "/info.edn") "{:name \"p\" :dependencies [\"missing\"]}")
  (assert-error "no :vendored" (vendor))
  (rmrf base))

;;; Module path
;
; A bare import searches the directories of *modpath* in order. The command line
; sets it from the info.edn beside the script, or from the working directory for
; test and build.

(let [base (string (app-rpath prefix) "-modpath")
      proj (string base "/proj")
      deps (string proj "/deps")
      hidden (string proj "/.wattle")
      lib (string (app-rpath prefix) "/lib/wattle")]
  (rmrf base)
  (each dir [base proj deps hidden (string proj "/sub") (string proj "/test") (string base "/loose")]
    (assert (os/mkdir dir)))
  (spit (string proj "/info.edn") "{:group \"org.wattle.tests\" :name \"mp\"}")
  (spit (string deps "/depmod.wattle") "(def v 1)\n")
  (spit (string hidden "/depmod.wattle") "(def v 2)\n")
  (spit (string hidden "/hiddenmod.wattle") "(def v 3)\n")
  (assert (os/mkdir (string deps "/dirmod")))
  (spit (string deps "/dirmod/init.wattle") "(def v 4)\n")

  ; module/find with *modpath* set directly.
  (with-dyns [*modpath* [deps hidden]]
    (assert (= [(string deps "/depmod.wattle") :source] (module/find "depmod"))
            "an earlier directory of the module path wins")
    (assert (= [(string hidden "/hiddenmod.wattle") :source] (module/find "hiddenmod"))
            "a later directory of the module path is searched")
    (assert (= [(string deps "/dirmod/init.wattle") :source] (module/find "dirmod"))
            "a directory with init.wattle is found")
    (assert (nil? (first (module/find "./depmod"))) "a relative import does not use the module path")
    (assert (nil? (first (module/find "nothere"))) "a missing module is not found"))
  (with-dyns [*modpath* [hidden deps]]
    (assert (= [(string hidden "/depmod.wattle") :source] (module/find "depmod"))
            "the order of the module path decides"))
  (assert (nil? (first (module/find "depmod"))) "no module path finds nothing")
  (let [[found message] (module/find "depmod")]
    (assert (and (nil? found) (string/find "no info.edn beside the script" message))
            "a failed bare import without a module path names info.edn"))
  (with-dyns [*modpath* [deps]]
    (let [[_ message] (module/find "nothere")]
      (assert (nil? (string/find "no info.edn" message))
              "a failed bare import with a module path does not name info.edn")))
  (let [[_ message] (module/find "./nothere")]
    (assert (nil? (string/find "no info.edn" message))
            "a failed relative import does not name info.edn"))

  ; A native module is also found under the name that Zig gives a shared
  ; library, which begins with lib. The name without lib is found first.
  (let [ext (case (os/which) :windows ".dll" :macos ".dylib" ".so")
        plain (string deps "/natplain" ext)
        prefixed (string deps "/libnatplain" ext)
        only (string hidden "/libnatonly" ext)]
    (spit prefixed "")
    (spit only "")
    (with-dyns [*modpath* [deps hidden]]
      (assert (= [prefixed :native] (module/find "natplain")) "a lib-prefixed native module is found")
      (assert (= [only :native] (module/find "natonly")) "a lib-prefixed native module is found in a later directory")
      (spit plain "")
      (assert (= [plain :native] (module/find "natplain")) "a native module without lib is found first")
      (assert (= [only :native] (module/find "libnatonly")) "a lib-prefixed name is found as it is written")
      (assert (= [(string deps "/depmod.wattle") :source] (module/find "depmod"))
              "a source module is not found under a lib-prefixed name")
      (spit (string deps "/libwidget.wattle") "(def v 1)\n")
      (assert (nil? (first (module/find "widget"))) "only native modules are found under a lib-prefixed name")))

  ; The prefix is not a module root.
  (each dir [(string (app-rpath prefix) "/lib") lib] (os/mkdir dir))
  (spit (string lib "/libmod.wattle") "(def v 5)\n")
  (with-dyns [*prefix* (app-rpath prefix) *modpath* [deps]]
    (assert (nil? (first (module/find "libmod"))) "lib/wattle under the prefix is not searched"))

  ; The command line.
  (compwhen (dyn 'os/execute)
    (do
      (spit (string proj "/main.wattle")
            "(import depmod)\n(import hiddenmod)\n(import dirmod)\n(assert (= [1 3 4] [depmod/v hiddenmod/v dirmod/v]))\n")
      (spit (string proj "/sub/up.wattle") "(import depmod)\n")
      (spit (string base "/loose/loose.wattle") "(import depmod)\n")
      (spit (string base "/loose/rel.wattle") "(import ./sibling)\n(assert (= 9 sibling/v))\n")
      (spit (string base "/loose/sibling.wattle") "(def v 9)\n")
      (spit (string proj "/test/t.wattle") "(import depmod)\n(assert (= 1 depmod/v))\n")

      (let [[status _] (run-cli "run" (string proj "/main.wattle"))]
        (assert (= 0 status) "run sets the module path from the info.edn beside the script"))
      (let [old (os/cwd)]
        (os/cd proj)
        (let [[status _] (run-cli "run" "main.wattle")]
          (assert (= 0 status) "a script in the working directory uses ./info.edn"))
        (let [[status _] (run-cli "test")]
          (assert (= 0 status) "test sets the module path from the working directory"))
        (os/cd old))
      (let [[status text] (run-cli "run" (string proj "/sub/up.wattle"))]
        (assert (= 1 status) "run does not look in a parent directory")
        (assert (string/find "no info.edn beside the script" text)
                "the failure names info.edn"))
      (let [[status text] (run-cli "run" (string base "/loose/loose.wattle"))]
        (assert (= 1 status) "a script with no info.edn has no module path")
        (assert (string/find "no info.edn beside the script" text) "the failure names info.edn"))
      (let [[status _] (run-cli "run" (string base "/loose/rel.wattle"))]
        (assert (= 0 status) "a relative import needs no info.edn"))))
  (rmrf base))

;;; Revisions
;
; The manifest of an application records :rev, the commit hash of a Git
; repository and, for a directory or a tarball, `sha256:` and a hash of the files.

(let [dir (string (app-rpath prefix) "-rev")
      info "{:group \"org.wattle.tests\" :name \"rev-app\" :man []}"
      write (fn []
              (rmrf dir)
              (each d [dir (string dir "/sub") (string dir "/.git") (string dir "/zig-out")
                       (string dir "/.wattle") (string dir "/.zig-cache")]
                (assert (os/mkdir d)))
              (spit (string dir "/info.edn") info)
              (spit (string dir "/a") "one")
              (spit (string dir "/sub/b") "two")
              (each skipped ["/.git/x" "/zig-out/y" "/.wattle/z" "/.zig-cache/w"]
                (spit (string dir skipped) "skipped")))
      install #(with-dyns [*err* !""] (app/install dir))]
  (write)
  (assert-no-error "install a directory" (install))
  (assert (= "sha256:7227ca7add27d7ec142377ed6b8ad91001329151c552ea0d3be6c5afbc5a2b44"
             (get (app/manifest "rev-app") :rev))
          "a directory records the hash of its files, without .git, zig-out, .wattle and .zig-cache")
  (assert (nil? (get (app/manifest "rev-app") :source)) "a directory records no source")
  (spit (string dir "/a") "one!")
  (assert-no-error "upgrade a directory" (with-dyns [*err* !""] (app/upgrade "rev-app")))
  (assert (= "sha256:a11fc8b86771909ccd7d3ad8ea4fd023eb6aaeadbf7d1df3070c3896dcdc4aa5"
             (get (app/manifest "rev-app") :rev))
          "upgrading a directory records the hash of the files now there")
  (assert-no-error "remove a directory" (app/remove "rev-app"))

  ; The order is the byte order of the relative paths, so a file beside a directory
  ; sorts as its path does.
  (write)
  (spit (string dir "/a.txt") "x")
  (assert-no-error "install a directory with a sibling name" (install))
  (assert (= "sha256:6c61e80dfeba58ab0876265c732fe4d9a5f8ab591bc3456673c26217ca38f0ae"
             (get (app/manifest "rev-app") :rev))
          "files are hashed in the byte order of their paths")
  (assert-no-error "remove again" (app/remove "rev-app"))

  ; A symbolic link has no revision, and nothing is installed. The case is
  ; skipped where a link cannot be made: WASI refuses it, and Windows needs a
  ; privilege for it.
  (write)
  (when (first (protect (os/link (string dir "/a") (string dir "/link") true)))
    (let [[ok message] (protect (install))]
      (assert (and (not ok) (string/find "which is a symbolic link" message) (string/find "/link" message))
              "a symbolic link in a source is refused")
      (assert (= 0 (length (app/list))) "a source with a symbolic link installs nothing")))
  (rmrf dir))

;;; Source applications
;
; A :src artifact installs its :files into the application directory and a
; program in bin that calls app/run.

(let [base (string (app-rpath prefix) "-src-app")
      proj (string base "/proj")
      s "/"
      app-path (string root "/lib/wattle/apps/org.wattle.tests/sprog")
      binscript (string root "/bin/sprog-bin")
      info-of (fn [artifact]
                (string/format "%m" {:group "org.wattle.tests" :name "sprog" :artifacts [artifact]}))
      src-artifact {:type :src :name "sprog-bin" :entry "main.wattle"
                    :files ["main.wattle" "lib" "deps"]}
      try-install (fn [info-text]
                    (spit (string proj "/info.edn") info-text)
                    (protect (with-dyns [*err* !""] (app/install proj))))]
  (rmrf base)
  (each dir [base proj (string proj "/lib") (string proj "/lib/zig-out")
             (string proj "/deps") (string proj "/zig-out") (string proj "/zig-out/lib")
             (string proj "/.wattle")]
    (assert (os/mkdir dir)))
  (spit (string proj "/main.wattle")
        (string "(import ./lib/helper)\n(import depmod)\n"
                "(defn main [& args]\n"
                "  (spit (get args 1) (string (string/join \";\" (slice args 2)) \",\" depmod/v \",\" helper/w)))\n"))
  (spit (string proj "/lib/helper.wattle") "(def w 3)\n")
  (spit (string proj "/lib/zig-out/nested") "skipped\n")
  (spit (string proj "/deps/depmod.wattle") "(def v 7)\n")
  (spit (string proj "/zig-out/lib/stale") "skipped\n")
  (spit (string proj "/.wattle/stale") "skipped\n")

  ; Windows has no shebang lines, so it refuses a :src artifact and nothing else
  ; in this section applies.
  (when (= :windows (os/which))
    (let [[ok message] (try-install (info-of src-artifact))]
      (assert (and (not ok) (string/find "Windows" message))
              "a :src artifact is refused on Windows")
      (assert (= 0 (length (app/list))) "a refused :src artifact installs nothing")))
  (unless (= :windows (os/which))
    (let [[ok _] (try-install (info-of src-artifact))]
      (assert ok "a :src artifact installs"))
    (each file ["main.wattle" "lib/helper.wattle" "deps/depmod.wattle" "info.edn" "manifest.edn"]
      (assert (os/stat (string app-path s file) :mode) (string file " is in the application directory")))
    (assert (nil? (os/stat (string app-path "/zig-out") :mode)) "zig-out is not copied")
    (assert (nil? (os/stat (string app-path "/lib/zig-out") :mode)) "a nested zig-out is not copied")
    (assert (nil? (os/stat (string app-path "/.wattle") :mode)) ".wattle is not copied")
    (assert (nil? (os/stat (string app-path "/.binscript") :mode)) "the temporary binscript is removed")
    (let [lines (string/split "\n" (string (slurp binscript)))]
      (assert (= "#!/usr/bin/env wattle" (first lines)) "the program starts with a shebang line")
      (assert (= "(app/run \"org.wattle.tests\" \"sprog\" \"main.wattle\")" (get lines 1))
              "the program calls app/run with the group, the name and the entry"))
    (unless (or (= :windows (os/which)) (= :wasi (os/which)))
      (assert (string/has-prefix? "rwx" (os/stat binscript :permissions)) "the program is executable"))
    (assert (= "sprog" (app/whois binscript)) "app/whois finds the program of a :src artifact")

    (compwhen (dyn 'os/execute)
      (do
        (def out (string base "/out.txt"))
        (let [[status _] (run-cli binscript out "x" "y")]
          (assert (= 0 status) "the program runs the entry")
          (assert (= "x;y,7,3" (string (slurp out)))
                  "the entry gets its arguments, a relative import and the deps of its directory"))
        (rmrf out)))

    (assert-no-error "upgrade a :src application" (with-dyns [*err* !""] (app/upgrade "sprog")))
    (assert (and (os/stat binscript :mode) (os/stat (string app-path "/main.wattle") :mode))
            "upgrading installs the files and the program again")

    ; An upgrade that fails restores the application as it was.
    (let [manifest-before (app/manifest "sprog")
          main-before (string (slurp (string app-path "/main.wattle")))
          binscript-before (string (slurp binscript))]
      (spit (string proj "/info.edn") (info-of (assoc src-artifact :files ["main.wattle" "nothere"])))
      (let [[ok _] (protect (with-dyns [*err* !""] (app/upgrade "sprog")))]
        (assert (not ok) "an upgrade whose source is missing a file fails"))
      (assert (app/installed? "sprog") "a failed upgrade leaves the application installed")
      (assert (= main-before (string (slurp (string app-path "/main.wattle"))))
              "a failed upgrade restores the source files")
      (assert (= binscript-before (string (slurp binscript))) "a failed upgrade restores the program")
      (assert (= manifest-before (app/manifest "sprog")) "a failed upgrade restores the manifest")
      (assert (nil? (os/stat (string root "/lib/wattle/sprog.backup") :mode))
              "a failed upgrade leaves no backup")
      (spit (string proj "/info.edn") (info-of src-artifact)))
    (assert-no-error "remove a :src application" (app/remove "sprog"))
    (assert (nil? (os/stat binscript :mode)) "removing removes the program")
    (assert (nil? (os/stat app-path :mode)) "removing removes the application directory")

    ; Refusals leave nothing installed.
    (defn nothing-left [what]
      (assert (and (= 0 (length (app/list))) (nil? (os/stat binscript :mode))) what))
    (let [[ok message] (try-install (info-of (assoc src-artifact :files ["lib"])))]
      (assert (and (not ok) (string/find ":entry main.wattle of sprog-bin is not among its :files" message))
              "an :entry outside the :files is refused")
      (nothing-left "a refused :entry installs nothing"))
    (let [[ok message] (try-install (info-of (dissoc src-artifact :files)))]
      (assert (and (not ok) (string/find ":files is required" message))
              "a :src artifact needs :files")
      (nothing-left "a :src artifact without :files installs nothing"))
    (let [[ok message] (try-install (info-of (assoc src-artifact :files ["main.wattle" "nothere"])))]
      (assert (and (not ok) (string/find ":files names" message) (string/find "nothere" message))
              "a :files entry that does not exist is refused")
      (nothing-left "a missing :files entry installs nothing"))
    (let [[ok message] (try-install (string/format "%m" {:group "org.wattle.tests" :name "sprog"
                                                         :artifacts [src-artifact
                                                                     {:type :lib :name "l" :root "l.zig"}]}))]
      (assert (and (not ok) (string/find "names it in :libs" message))
              "a :lib that no :src artifact names is refused")
      (nothing-left "an unnamed :lib installs nothing"))
    ; A :lib that a :src artifact names is built, and the build fails here: the
    ; prefix of this suite holds no source of the runtime.
    (compwhen (and (dyn 'os/execute) (dyn 'os/spawn))
      (do
        (spit (string proj "/l.zig") "")
        (let [[ok _] (try-install (string/format "%m" {:group "org.wattle.tests" :name "sprog"
                                                       :artifacts [(assoc src-artifact :files ["main.wattle" "lib" "deps" "l.zig"]
                                                                                       :libs ["l"])
                                                                   {:type :lib :name "l" :root "l.zig"}]}))]
          (assert (not ok) "a :src artifact whose :libs fail to build is refused")
          (nothing-left "a failed :libs build installs nothing"))))

    ; app/run
    (with-dyns [*prefix* ""]
      (let [[ok message] (protect (app/run "g" "n" "main.wattle"))]
        (assert (and (not ok) (string/find "WATTLE_PREFIX" message)) "app/run names WATTLE_PREFIX without a prefix")))
    (let [[ok message] (protect (app/run "org.wattle.tests" "nothere" "main.wattle"))]
      (assert (and (not ok) (string/find "does not exist" message)) "app/run refuses an application that is not installed")))
  (rmrf base))

(rmrf prefix)

(end-suite)
