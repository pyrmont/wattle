(import ./helper :prefix "" :exit true)
(start-suite)

(defmacro is [expression] `(assert ~expression))
(defmacro deftest [_ & body] `(do ~|body))

(defn- refusal
  "Returns the message of the error `pkg/artifacts` raises for info, or nil."
  [info]
  (def [ok message] (protect (pkg/artifacts info)))
  (if ok nil message))

(defn- refuses
  "Checks that `pkg/artifacts` raises for info with a message holding text."
  [info text]
  (def message (refusal info))
  (is (string? message))
  (is (string/find text message)))

(def blueshift
  {:name "blueshift"
   :artifacts [{:type :lib :name "blues_http" :root "lib/http.zig"}
               {:type :exe :name "blues" :entry "lib/cli.wattle"
                :libs ["blues_http"]}]})

(defn- extend
  "Returns base with the key and value pairs of fields added."
  [base fields]
  (if (empty? fields) base (apply assoc base fields)))

(defn- exe [& fields] (extend {:type :exe :name "a" :entry "m"} fields))
(defn- lib [& fields] (extend {:type :lib :name "z" :root "r"} fields))
(defn- declares [& artifacts] {:artifacts (vec artifacts)})

(deftest valid-info
  (is (nil? (refusal blueshift)))
  (is (= 2 (length (pkg/artifacts blueshift))))
  (is (nil? (refusal (declares (exe)))))
  (is (nil? (refusal (declares (lib))))))

(deftest top-level
  (refuses [] "must hold a map")
  (refuses {:name "x"} "no :artifacts are declared")
  (refuses {:artifacts {}} ":artifacts must be a vector")
  (refuses {:artifacts [1]} "artifact 0 must be a map"))

(deftest type-and-name
  (refuses (declares {:name "a" :entry "m"})
           "artifact 0 (a): :type must be :exe or :lib")
  (refuses (declares (exe :type :dll)) ":type must be :exe or :lib")
  (refuses (declares {:type :exe :entry "m"})
           "artifact 0: :name must be a non-empty string")
  (refuses (declares (exe :name "")) ":name must be a non-empty string")
  (refuses (declares (exe :name 3)) ":name must be a non-empty string")
  (refuses (declares (exe :name "a b")) "may hold only letters, digits"))

(deftest entry-and-root
  (refuses (declares {:type :exe :name "a"})
           "artifact 0 (a): :entry must be a non-empty string")
  (refuses (declares (exe :entry "")) ":entry must be a non-empty string")
  (refuses (declares {:type :lib :name "a"})
           "artifact 0 (a): :root must be a non-empty string"))

(deftest unknown-keys
  (refuses (declares (exe :link ["b"])) ":link is not a key of an :exe")
  (refuses (declares (lib :libs [])) ":libs is not a key of an :lib")
  (refuses (declares (exe :root "r")) ":root is not a key of an :exe"))

(deftest duplicate-names
  (refuses (declares (exe) (exe :entry "n"))
           "artifact 1 (a): :name is already used by artifact 0")
  (refuses (declares (exe) (lib :name "a"))
           ":name is already used by artifact 0"))

(deftest libs
  (defn libs-of [libs] (declares (lib) (exe :libs libs)))
  (is (nil? (refusal (libs-of ["z"]))))
  (is (nil? (refusal (libs-of []))))
  (refuses (libs-of "z") ":libs must be a vector of names")
  (refuses (libs-of [3]) ":libs must hold strings")
  (refuses (libs-of ["z" "z"]) ":libs names z twice")
  (refuses (libs-of ["q"]) ":libs names q, which no artifact declares")
  (refuses (libs-of ["a"]) ":libs names a, which is not a :lib")
  (refuses (libs-of [{:system "curl"}]) "reserved for an external library"))

(deftest select
  (def exes (pkg/artifacts blueshift :exe))
  (is (= 1 (length exes)))
  (is (= "blues" (get (first exes) :name)))
  (def libs (pkg/artifacts blueshift :lib))
  (is (= "blues_http" (get (first libs) :name)))
  (is (= "blues"
         (get (first (pkg/artifacts blueshift :exe "blues")) :name)))
  (def two (declares (exe :name "b") (lib) (exe :name "a" :entry "n")))
  (is (= ["b" "a"] (vec (map #(get $ :name) (pkg/artifacts two :exe)))))
  (is (= "a" (get (first (pkg/artifacts two :exe "a")) :name)))
  (defn message [& args] (get (protect (pkg/artifacts |args)) 1))
  (is (string/find "no :exe artifact is called c" (message two :exe "c")))
  (is (string/find "no :exe artifact is called z" (message two :exe "z")))
  (is (string/find "no :lib artifact is declared"
                   (message (declares (exe)) :lib))))

(def gen-opts {:dir "/proj" :srcpath "/opt/w/share/wattle"
               :gen "/proj/.zig-cache/wattle-build"})

(defn- has [text fragment] (not (nil? (string/find fragment text))))

(deftest zig-files-exe
  (def files (pkg/zig-files blueshift :exe gen-opts))
  (is (= (string
           "const std = @import(\"std\");\n"
           "const wattle = @import(\"wattle\");\n\n"
           "pub fn build(b: *std.Build) void {\n"
           "    const target = b.standardTargetOptions(.{});\n"
           "    const optimize = b.standardOptimizeOption(.{});\n"
           "    const dep = b.dependency(\"wattle\", .{ .target = target, .optimize = optimize });\n"
           "    const host = b.dependency(\"wattle\", .{ .target = b.graph.host, .optimize = .Debug });\n"
           "    const exe0 = wattle.wattleExecutable(dep, host, .{\n"
           "        .name = \"blues\",\n"
           "        .source = .{ .cwd_relative = \"/proj/lib/cli.wattle\" },\n"
           "        .natives = &.{\n"
           "            .{ .name = \"blues_http\", .root = .{ .cwd_relative = \"/proj/lib/http.zig\" } },\n"
           "        },\n"
           "        .target = target,\n"
           "        .optimize = optimize,\n"
           "    });\n"
           "    b.installArtifact(exe0);\n"
           "}\n")
         (get files :build)))
  (is (= (string
           ".{\n"
           "    .name = .wattle_project,\n"
           "    .version = \"0.0.0\",\n"
           "    .fingerprint = 0x73d368c0c079d65,\n"
           "    .dependencies = .{\n"
           "        .wattle = .{ .path = \"../../../opt/w/share/wattle\" },\n"
           "    },\n"
           "    .paths = .{ \"build.zig\", \"build.zig.zon\" },\n"
           "}\n")
         (get files :zon))))

(deftest zig-files-lib
  (def text (get (pkg/zig-files blueshift :lib gen-opts) :build))
  (is (has text "const mod0 = b.createModule(.{"))
  (is (has text ".root_source_file = .{ .cwd_relative = \"/proj/lib/http.zig\" },"))
  (is (has text "mod0.addImport(\"wattle\", wattle.wattleModule(dep, target, optimize));"))
  (is (has text ".name = \"blues_http\","))
  (is (has text ".linkage = .dynamic,"))
  (is (has text "lib0.linker_allow_shlib_undefined = true;"))
  (is (not (has text "wattleExecutable")))
  (is (not (has text "b.graph.host"))))

(deftest zig-files-dependency-path
  (defn dep-path [opts]
    (def zon (get (pkg/zig-files blueshift :exe opts) :zon))
    (def start (+ 9 (get (string/find-all ".path = \"" zon) 0)))
    (slice zon start (string/find "\"" zon start)))
  (is (= "../../../pkg" (dep-path {:dir "/a/proj" :srcpath "/a/pkg"
                                  :gen "/a/proj/.zig-cache/wattle-build"})))
  (is (= "../../vendor/w" (dep-path {:dir "/a/proj" :srcpath "/a/proj/vendor/w"
                                    :gen "/a/proj/.zig-cache/wattle-build"})))
  (is (= "../../../../../usr/local/share/wattle"
         (dep-path {:dir "/home/u/p" :srcpath "/usr/local/share/wattle"
                    :gen "/home/u/p/.zig-cache/wattle-build"}))))

(deftest zig-files-paths
  (def info {:artifacts [{:type :exe :name "a" :entry "/abs/main.wattle"}]})
  (is (has (get (pkg/zig-files info :exe gen-opts) :build)
           ".source = .{ .cwd_relative = \"/abs/main.wattle\" },"))
  (def quoted {:artifacts [{:type :exe :name "a" :entry "m\"x.wattle"}]})
  (is (has (get (pkg/zig-files quoted :exe {:dir "/pr oj" :srcpath "/p" :gen "/g"}) :build)
           ".cwd_relative = \"/pr oj/m\\\"x.wattle\""))
  (def windows {:artifacts [{:type :exe :name "a" :entry "C:\\src\\m.wattle"}]})
  (is (has (get (pkg/zig-files windows :exe gen-opts) :build)
           ".cwd_relative = \"C:\\\\src\\\\m.wattle\"")))

(deftest zig-files-selection
  (def many
    {:artifacts [{:type :lib :name "z" :root "z.zig"}
                 {:type :exe :name "b" :entry "b.wattle" :libs ["z"]}
                 {:type :exe :name "a" :entry "a.wattle"}]})
  (def all (get (pkg/zig-files many :exe gen-opts) :build))
  (is (has all "const exe0 = wattle.wattleExecutable"))
  (is (has all "const exe1 = wattle.wattleExecutable"))
  (is (< (string/find ".name = \"b\"," all) (string/find ".name = \"a\"," all)))
  (is (has all ".{ .name = \"z\", .root = .{ .cwd_relative = \"/proj/z.zig\" } },"))
  (def one (get (pkg/zig-files many :exe "a" gen-opts) :build))
  (is (not (has one "exe1")))
  (is (not (has one "\"z\"")))
  (def [ok message] (protect (pkg/zig-files many :exe "nosuch" gen-opts)))
  (is (not ok))
  (is (has message "no :exe artifact is called nosuch"))
  (def [ok2 message2] (protect (pkg/zig-files {:artifacts [{:type :lib :name "z" :root "z.zig"}]}
                                                :exe gen-opts)))
  (is (not ok2))
  (is (has message2 "no :exe artifact is declared")))

(end-suite)
