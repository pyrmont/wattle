; The core wattle library

;;;
;;;
;;; Macros and Basic Functions
;;;
;;;

(def defn :macro :flycheck {:sigs "(defn name & more)"}
  """
  Defines a function. Equivalent to `(def name (fn name [args] ...))`.
  """
  (fn defn [name & more]
    (def len (length more))
    (def modifiers ![])
    (var docstr "")
    (def fstart
      (fn recur [i]
        (def {ith i} more)
        (def t (type ith))
        (if (= t :tuple)
          i
          (if (= t :vector)
            i
            (do
              (if (= t :string)
                (set docstr ith)
                (array/push! modifiers ith))
              (if (< i len) (recur (+ i 1))))))))
    (def start (fstart 0))
    (def args (in more start))
    ; Record the function signatures under `:sigs`
    (def clauses? (= (type args) :tuple))
    (def buf (buffer))
    (var clause-index start)
    (while (< clause-index len)
      (def params
        (if clauses?
          (do
            (def clause (in more clause-index))
            (if (= (type clause) :tuple)
              (do
                (def params (in clause 0))
                (if (= (type params) :vector)
                  params
                  (error "expected clause parameter vector")))
              (error "expected function clause")))
          args))
      (var index 0)
      (def arglen (length params))
      (buffer/format! buf "(%w" name)
      (while (< index arglen)
        (buffer/push-string! buf " ")
        (buffer/format! buf "%w" (in params index))
        (set index (+ index 1)))
      (buffer/push-string! buf ")\n")
      (set clause-index (if clauses? (+ clause-index 1) len)))
    (array/push! modifiers docstr)
    (array/push! modifiers {:sigs (string/slice buf 0 (- (length buf) 1))})
    (if (dyn :debug) (array/push! modifiers {:source-form (dyn :macro-form)}))
    ; Build return value
    `(def ~name ~|modifiers (fn ~name ~|(tuple/slice more start)))))

(defn defmacro :macro :flycheck
  "Defines a macro."
  [name & more]
  (apply defn name :macro more))

(defmacro as-macro
  """
  Uses a function or macro literal f as a macro. This lets
  any function be used as a macro. Inside a quasiquote, the
  idiom `(as-macro ,my-custom-macro arg1 arg2...)` can be used
  to avoid unwanted variable capture of `my-custom-macro`.
  """
  [f & args]
  (f |args))

(defmacro defmacro- :flycheck
  "Defines a private macro that will not be exported."
  [name & more]
  (apply defn name :macro :private more))

(defmacro defn- :flycheck
  "Defines a private function that will not be exported."
  [name & more]
  (apply defn name :private more))

(defmacro def-
  "Defines a private value that will not be exported."
  [name & more]
  `(def ~name :private ~|more))

(defmacro var-
  "Defines a private var that will not be exported."
  [name & more]
  `(var ~name :private ~|more))

(defmacro toggle
  "Sets a value to its boolean inverse. Same as `(set val (not val))`."
  [val]
  `(set ~val (~not ~val)))

(defn defglobal
  "Dynamically creates a global def."
  [name val]
  (def name* (symbol name))
  (setdyn name* !{:value val})
  nil)

(defn varglobal
  "Dynamically creates a global var."
  [name init]
  (def name* (symbol name))
  (setdyn name* !{:ref ![init]})
  nil)

; Basic predicates
(defn nan? "Checks whether x is NaN." [x] (not= x x))
(defn number? "Checks whether x is a number." [x] (= (type x) :number))
(defn fiber? "Checks whether x is a fiber." [x] (= (type x) :fiber))
(defn string? "Checks whether x is a string." [x] (= (type x) :string))
(defn symbol? "Checks whether x is a symbol." [x] (= (type x) :symbol))
(defn keyword? "Checks whether x is a keyword." [x] (= (type x) :keyword))
(defn buffer? "Checks whether x is a buffer." [x] (= (type x) :buffer))
(defn function? "Checks whether x is a function (not an nfunction)." [x] (= (type x) :function))
(defn nfunction? "Checks whether x is an nfunction." [x] (= (type x) :nfunction))
(defn table? "Checks whether x is a table." [x] (= (type x) :table))
(defn map? "Checks whether x is a map." [x] (= (type x) :map))
(defn array? "Checks whether x is an array." [x] (= (type x) :array))
(defn vector? "Checks whether x is a vector." [x] (= (type x) :vector))
(defn tuple? "Checks whether x is a tuple." [x] (= (type x) :tuple))
(defn boolean? "Checks whether x is a boolean." [x] (= (type x) :boolean))
(defn truthy? "Checks whether x is truthy." [x] (if x true false))
(defn true? "Checks whether x is true." [x] (= x true))
(defn false? "Checks whether x is false." [x] (= x false))
(defn nil? "Checks whether x is nil." [x] (= x nil))
(defn empty? "Checks whether coll, an iterable, is empty." [coll] (= nil (next coll nil)))

; For macros, we define an incomplete odd? function that will be overridden.
(defn odd? [x] (= 1 (mod x 2)))

(def- non-atomic-types
  {:array true
   :tuple true
   :vector true
   :table true
   :map true
   :buffer true
   :symbol true})

(defn idempotent?
  "Checks whether x is a value that evaluates to itself when compiled."
  [x]
  (not (in non-atomic-types (type x))))

; C style macros and functions for imperative sugar. No bitwise though.
(defn inc "Returns x + 1." [x] (+ x 1))
(defn dec "Returns x - 1." [x] (- x 1))
(defmacro ++ "Increments the var x by 1." [x] `(set ~x (~+ ~x ~1)))
(defmacro -- "Decrements the var x by 1." [x] `(set ~x (~- ~x ~1)))
(defmacro += "Increments the var x by n." [x & ns] `(set ~x (~+ ~x ~|ns)))
(defmacro -= "Decrements the var x by n." [x & ns] `(set ~x (~- ~x ~|ns)))
(defmacro *= "Shorthand for (set x (\\* x n))." [x & ns] `(set ~x (~* ~x ~|ns)))
(defmacro /= "Shorthand for (set x (/ x n))." [x & ns] `(set ~x (~/ ~x ~|ns)))
(defmacro %= "Shorthand for (set x (% x n))." [x & ns] `(set ~x (~% ~x ~|ns)))

(defmacro assert :flycheck ; should top level assert flycheck?
  "Raises an error if x is not truthy. Will not evaluate err if x is truthy."
  ([x] (def self assert) (self x nil))
  ([x err]
    (def v (gensym))
    `(do
       (def ~v ~x)
       (if ~v
         ~v
         (~error ~(if err err (string/format "assert failure in %w" x)))))))

(defmacro defdyn :flycheck
  """
  Defines an alias for a keyword that is used as a dynamic binding. The
  alias is a normal, lexically scoped binding that can be used instead of
  a keyword to prevent typos. ^defdyn does not set dynamic bindings or otherwise
  replace ^dyn and ^setdyn. The alias *must* start and end with the ^* character, usually
  called "earmuffs".
  """
  [alias & more]
  (assert (symbol? alias) "alias must be a symbol")
  (assert (> (length alias) 2) "name must have leading and trailing '*' characters")
  (assert (= 42 (get alias 0) (get alias (- (length alias) 1))) "name must have leading and trailing '*' characters")
  (def prefix (dyn :defdyn-prefix))
  (def kw (keyword prefix (slice alias 1 -2)))
  `(def ~alias :dyn ~|more ~kw))

(defdyn *macro-form*
  """
  The source form that invoked a macro. Visible inside a macro.
  """)

(defdyn *flychecking*
  """
  Indicates whether the current form is being evaluated inside ^flycheck. Will
  be true while flychecking.
  """)

(defdyn *lint-error*
  """
  The current lint error level. The error level is the lint level at which
  compilation will exit with an error and not continue.
  """)

(defdyn *lint-warn*
  """
  The current lint warning level. The warning level is the lint level at which
  and error will be printed but compilation will continue as normal.
  """)

(defdyn *lint-levels*
  """
  A table of keyword alias to numbers denoting a lint level. Can be used to
  provided custom aliases for numeric lint levels.
  """)

(defdyn *macro-lints*
  """
  An array of lint messages that will be reported by the compiler inside a
  macro. To indicate an error or warning, a macro author should use ^maclintf.
  """)

(defn maclintf
  """
  Adds a linter warning when called inside a macro. fmt formats the message and
  works the same as the formatting argument to ^string/format.
  """
  [level fmt & vals]
  (def lints (dyn *macro-lints*))
  (if lints
    (do
      (def form (dyn *macro-form*))
      (def [l c] (if (tuple? form) (tuple/sourcemap form) [nil nil]))
      (def l (if (not= -1 l) l))
      (def c (if (not= -1 c) c))
      (def msg (string/format fmt |vals))
      (array/push! lints [level l c msg])))
  nil)

(defn errorf
  """
  Raises an error. fmt formats the message and works the same as the formatting
  argument to ^string/format. Same as `(error (string/format fmt |vals))`.
  """
  [fmt & vals]
  (error (string/format fmt |vals)))

(defmacro assertf
  """
  Raises an error if x is not truthy. Will not evaluate err if x is truthy. fmt
  formats the message and works the same as the formatting argument to
  ^string/format.
  """
  [x fmt & vals]
  (def v (gensym))
  `(do
     (def ~v ~x)
     (if ~v
       ~v
       (~errorf ~fmt ~|vals))))

(defmacro default
  """
  Defines a default value for an optional argument.
  Expands to `(def sym :shadow (if (= nil sym) val sym))`.
  """
  [sym val]
  `(def ~sym :shadow (if (~= nil ~sym) ~val ~sym)))

(defmacro comment
  "Ignores the body of the comment."
  [&])

(defmacro if-not
  "Shorthand for `(if (not test) then else)`."
  ([test then] (def self if-not) (self test then nil))
  ([test then else]
    `(if ~test ~else ~then)))

(defmacro when
  "Evaluates the body when test is truthy. Otherwise returns nil."
  [test & body]
  `(if ~test (do ~|body)))

(defmacro unless
  "Shorthand for `(when (not test) |body)`."
  [test & body]
  `(if ~test nil (do ~|body)))

(defmacro cond
  """
  Evaluates conditions sequentially until the first true condition
  is found, and then executes the corresponding body. If there are an
  odd number of forms, and no forms are matched, the last expression
  is executed. If there are no matches, returns nil.
  """
  [& clauses]
  (defn aux [i]
    (def restlen (- (length clauses) i))
    (if (= restlen 0) nil
      (if (= restlen 1) (in clauses i)
        (tuple 'if (in clauses i)
               (in clauses (+ i 1))
               (aux (+ i 2))))))
  (aux 0))

(defmacro case
  """
  Selects the body that equals the dispatch value. When clauses
  has an odd number of elements, the last is the default expression.
  If no match is found, returns nil.
  """
  [dispatch & clauses]
  (def atm (idempotent? dispatch))
  (def sym (if atm dispatch (gensym)))
  (defn aux [i]
    (def restlen (- (length clauses) i))
    (if (= restlen 0) nil
      (if (= restlen 1) (in clauses i)
        (tuple 'if (tuple = sym (in clauses i))
               (in clauses (+ i 1))
               (aux (+ i 2))))))
  (if atm
    (aux 0)
    (tuple 'do
           (tuple 'def sym dispatch)
           (aux 0))))

(defmacro let
  """
  Creates a scope and binds values to symbols. Each pair in bindings is
  assigned as if with def, and the body of the ^let form returns the last
  value.
  """
  [bindings & body]
  (if (odd? (length bindings)) (error "expected even number of bindings to let"))
  (def len (length bindings))
  (var i 0)
  (var accum !['do])
  (while (< i len)
    (def {k i v (+ i 1)} bindings)
    (array/push! accum (tuple 'def k v))
    (+= i 2))
  (array/concat! accum body)
  (tuple/slice accum 0))

(defmacro protect
  """
  Evaluates expressions, while capturing any errors. Evaluates to a tuple
  of two elements. The first element is true if successful, false if an
  error, and the second is the return value or error.
  """
  [& body]
  (let [f (gensym) r (gensym)]
    `(let [~f (~fiber/new (fn :protect [] ~|body) :ie)
           ~r (~resume ~f)]
       [(~not= :error (~fiber/status ~f)) ~r])))

(defmacro and
  """
  Evaluates to the last argument if all preceding arguments are truthy,
  otherwise evaluates to the first falsey argument.
  """
  [& forms]
  (var ret true)
  (def len (length forms))
  (var i len)
  (while (> i 0)
    (-- i)
    (def v (in forms i))
    (set ret (if (= i (- len 1))
               v
               (if (idempotent? v)
                 (tuple 'if v ret v)
                 (do (def s (gensym))
                   (tuple 'if (tuple 'def s v) ret s))))))
  ret)

(defmacro or
  """
  Evaluates to the last argument if all preceding arguments are falsey,
  otherwise evaluates to the first truthy element.
  """
  [& forms]
  (def len (length forms))
  (var i (- len 1))
  (var ret (get forms i))
  (while (> i 0)
    (-- i)
    (def fi (in forms i))
    (set ret (if (idempotent? fi)
               (tuple 'if fi fi ret)
               (do
                 (def $fi (gensym))
                 (tuple 'do (tuple 'def $fi fi)
                        (tuple 'if $fi $fi ret))))))
  ret)

(defmacro try
  """
  Tries something and catches errors. body is any expression, and catch should
  be a form, the first element of which is a vector. This tuple should contain
  a binding for errors and an optional binding for the fiber wrapping the body.
  Returns the result of body if no error, or the result of catch if an error.
  """
  [body catch]
  (assert (and (not (empty? catch)) (indexed? (catch 0))) "the first element of `catch` must be a tuple or array")
  (let [[err fib] (catch 0)
        r (gensym)
        f (gensym)]
    `(let [~f (~fiber/new (fn :try [] ~body) :ie)
           ~r (~resume ~f)]
       (if (~= (~fiber/status ~f) :error)
         (do
           ~(if err `(def ~err ~r))
           ~(if fib `(def ~fib ~f))
           ~|(tuple/slice catch 1))
         ~r))))

(defmacro with-syms
  "Evaluates body with each symbol in syms bound to a generated, unique symbol."
  [syms & body]
  (var i 0)
  (def len (length syms))
  (def accum ![])
  (while (< i len)
    (array/push! accum (in syms i) (tuple gensym))
    (++ i))
  `(let (~|accum) ~|body))

(defn- defer-impl
  "Defers but allows custom name for stack traces."
  [name form body]
  (with-syms [f r]
    `(do
       (def ~f (~fiber/new (fn ~name [] ~|body) :ti))
       (def ~r (~resume ~f))
       ~form
       (if (= (~fiber/status ~f) :dead)
         ~r
         (~propagate ~r ~f)))))

(defmacro defer
  """
  Runs form unconditionally after body, even if body throws an error. Also runs
  form if a user signal 0-4 is received.
  """
  [form & body]
  (defer-impl :defer form body))

(defmacro edefer
  """
  Runs form after body in the case that body terminates abnormally (an error or
  user signal 0-4). Otherwise, returns last form in body.
  """
  [form & body]
  (with-syms [f r]
    `(do
       (def ~f (~fiber/new (fn :edefer [] ~|body) :ti))
       (def ~r (~resume ~f))
       (if (= (~fiber/status ~f) :dead)
         ~r
         (do ~form (~propagate ~r ~f))))))

(defmacro prompt
  """
  Sets up a checkpoint that can be returned to. tag should be a value that is
  used in a ^return statement, like a keyword.
  """
  [tag & body]
  (with-syms [res target payload fib]
    `(do
       (def ~fib (~fiber/new (fn :prompt [] [~tag (do ~|body)]) :i0))
       (def ~res (~resume ~fib))
       (def [~target ~payload] ~res)
       (if (~= ~tag ~target)
         ~payload
         (~propagate ~res ~fib)))))

(defmacro chr
  "Converts a string of length 1 to its byte (ascii) value at compile time."
  [c]
  (unless (and (string? c) (= (length c) 1))
    (error (string/format "expected string of length 1, got %v" c)))
  (c 0))

(defmacro label
  """
  Sets a label point that is lexically scoped. name should be a symbol that
  will be bound to the label.
  """
  [name & body]
  `(do
     (def ~name !"")
     ~(apply prompt name body)))

(defn return
  "Returns to a prompt point."
  ([to] (return to nil))
  ([to val]
    (signal 0 [to val])))

(defmacro with
  """
  Evaluates body with some resource, which will be automatically cleaned up if
  there is an error in body. binding is bound to the expression ctor, and dtor
  is a function or callable that is called with binding at the end of
  evaluation. If no dtor is given, `(:close binding)` is called instead.
  """
  [[binding ctor dtor] & body]
  `(do
     (def ~binding ~ctor)
     ~(defer-impl :with (tuple (or dtor :close) binding) body)))

; declare ahead of time
(var- macexvar nil)

(defmacro if-let
  """
  Makes multiple bindings, and if all are truthy, evaluates the then form. If
  any are false or nil, evaluates the else form. Bindings have the same syntax
  as ^let.
  """
  ([bindings then] (def self if-let) (self bindings then nil))
  ([bindings then else]
    (def len (length bindings))
    (if (= 0 len) (error "expected at least 1 binding"))
    (if (odd? len) (error "expected an even number of bindings"))
    (def else2 (if macexvar (macexvar else) else))
    (defn aux [i]
      (if (>= i len)
        then
        (do
          (def bl (in bindings i))
          (def br (in bindings (+ 1 i)))
          (if (symbol? bl)
            `(if (def ~bl ~br) ~(aux (+ 2 i)) ~else2)
            `(if (def ~(def sym (gensym)) ~br)
               (do (def ~bl ~sym) ~(aux (+ 2 i)))
               ~else2)))))
    (aux 0)))

(defmacro when-with
  """
  Similar to ^with, but if binding is false or nil, returns nil without
  evaluating the body. Otherwise, the same as ^with.
  """
  [[binding ctor dtor] & body]
  `(as-macro ~if-let [~binding ~ctor]
     ~(defer-impl :when-with (tuple (or dtor :close) binding) body)))

(defmacro if-with
  """
  Similar to ^with, but if binding is false or nil, evaluates the else form.
  Otherwise, evaluates the then form. In both cases, ctor is bound to
  binding.
  """
  ([head then] (if-with head then nil))
  ([[binding ctor dtor] then else]
    `(as-macro ~if-let [~binding ~ctor]
       ~(defer-impl :if-with (tuple (or dtor :close) binding) [then])
       ~else)))

(defn- for-var-template
  [i start stop step comparison delta body]
  (with-syms [s]
    (def st (if (idempotent? step) step (gensym)))
    (def loop-body
      `(while (~comparison ~i ~s)
         ~|body
         (set ~i (~delta ~i ~st))))
    `(do
       (var ~i ~start)
       (def ~s ~stop)
       ~|(if (= st step) [] [`(def ~st ~step)])
       ~(if (and (number? st) (> st 0))
          loop-body
          `(if (~> ~st 0) ~loop-body)))))

(defn- for-template
  [binding start stop step comparison delta body]
  (def i (gensym))
  (for-var-template i start stop step comparison delta
                    [`(def ~binding ~i) |body]))

(defn- check-indexed [x]
  (if (indexed? x)
    x
    (error (string "expected tuple for range, got " x))))

(defn- range-template
  [binding object kind rest op comparison]
  (check-indexed object)
  (def [a b c] object)
  (def [start stop step]
    (case (length object)
      1 (case kind :range [0 a 1] :down [a 0 1])
      2 [a b 1]
      [a b c]))
  (for-template binding start stop step comparison op [rest]))

(defmacro- element
  """
  The element of ds at key k: the entry `[k v]` where dict is truthy, and the
  value at k otherwise. dict is whether ds is a dictionary, read once before
  the loop that reads the elements.
  """
  [ds dict k]
  `(if ~dict [~k (~in ~ds ~k)] (~in ~ds ~k)))

(defn- each-template
  """
  Returns a loop over the keys of inx that binds binding to what kind names:
  the element (`:each`), the value (`:values`), the key (`:keys`) or the pair
  `[k v]` (`:pairs`).

  A pair bound to a literal pattern is not built: `def` binds a literal vector
  to a pattern element by element. Where binding is a two-element pattern, an
  element is read into two locals, the key and value of an entry or the first
  two elements of anything else, and binding is bound to a literal vector of
  them. Any other binding of an entry gets a vector.
  """
  [binding inx kind body]
  (with-syms [k dict first-slot second-slot first-part second-part]
    (def ds (if (idempotent? inx) inx (gensym)))
    (def two? (and (indexed? binding)
                   (= 2 (length binding))
                   (not= '& (in binding 0))
                   (not= '& (in binding 1))))
    (def bind
      (case kind
        :each (if two?
                [`(if ~dict
                    (do (set ~first-slot ~k) (set ~second-slot (~in ~ds ~k)))
                    (do
                      (def [~first-part ~second-part] (~in ~ds ~k))
                      (set ~first-slot ~first-part)
                      (set ~second-slot ~second-part)))
                 `(def ~binding [~first-slot ~second-slot])]
                [`(def ~binding (if ~dict [~k (~in ~ds ~k)] (~in ~ds ~k)))])
        :values [`(def ~binding (~in ~ds ~k))]
        :keys [`(def ~binding ~k)]
        :pairs [`(def ~binding [~k (~in ~ds ~k)])]))
    `(do
       ~(unless (= ds inx) `(def ~ds ~inx))
       ~(if (= kind :each) `(def ~dict (~dictionary? ~ds)))
       ~|(if (and two? (= kind :each)) [`(var ~first-slot nil) `(var ~second-slot nil)] [])
       (var ~k (~next ~ds nil))
       (while (~not= nil ~k)
         ~|bind
         ~|body
         (set ~k (~next ~ds ~k))))))

(defn- iterate-template
  [binding expr body]
  (with-syms [i]
    `(do
       (var ~i nil)
       (while (set ~i ~expr)
         (def ~binding ~i)
         ~body))))

(defn- loop1
  [body head i]
  ; Terminate recursion
  (when (<= (length head) i)
    (break `(do ~|body)))
  (def {binding i
        verb (+ i 1)} head)
  ; 2 term expression
  (when (keyword? binding)
    (break
      (let [rest (loop1 body head (+ i 2))]
        (case binding
          :until `(do (if ~verb (break) nil) ~rest)
          :while `(do (if ~verb nil (break)) ~rest)
          :let `(as-macro ~let ~verb (do ~rest))
          :after `(do ~rest ~verb nil)
          :before `(do ~verb ~rest nil)
          :repeat (with-syms [iter]
                    `(do (var ~iter ~verb) (while (~> ~iter 0) ~rest (as-macro ~-- ~iter))))
          :when `(as-macro ~when ~verb ~rest)
          :unless `(as-macro ~unless ~verb ~rest)
          (error (string "unexpected loop modifier " binding))))))
  ; 3 term expression
  (def {object (+ i 2)} head)
  (let [rest (loop1 body head (+ i 3))]
    (case verb
      :range (range-template binding object :range rest + <)
      :range-to (range-template binding object :range rest + <=)
      :down (range-template binding object :down rest - >)
      :down-to (range-template binding object :down rest - >=)
      :keys (each-template binding object :keys [rest])
      :pairs (each-template binding object :pairs [rest])
      :in (each-template binding object :each [rest])
      :iterate (iterate-template binding object rest)
      (error (string "unexpected loop verb " verb)))))

(defmacro forv
  """
  Repeats body in a C-style for-loop. This is useful for side effects. The
  iteration variable i can be mutated in the loop, unlike normal ^for. Returns
  nil.
  """
  [i start stop & body]
  (for-var-template i start stop 1 < + body))

(defmacro for
  """
  Repeats body in a C-style for-loop. This is useful for side effects. Returns
  nil.
  """
  [i start stop & body]
  (for-template i start stop 1 < + body))

(defmacro eachk
  "Loops over each key in coll, an iterable. Returns nil."
  [binding coll & body]
  (each-template binding coll :keys body))

(defmacro eachv
  """
  Loops over each value in coll, an iterable. The value of a table or map is
  the value of an entry, without its key. Returns nil.
  """
  [binding coll & body]
  (each-template binding coll :values body))

(defmacro repeat
  """
  Evaluates body n times. If n is negative, body will be evaluated 0 times.
  Evaluates to nil.
  """
  [n & body]
  (with-syms [iter]
    `(do (var ~iter ~n) (while (~> ~iter 0) ~|body (as-macro ~-- ~iter)))))

(defmacro forever
  "Evaluates body forever in a loop, or until a break call."
  [& body]
  `(while true ~|body))

(defmacro each
  """
  Loops over each element in coll, an iterable. The element of a table or map
  is an entry, the vector `[key value]`, and the element of any other iterable
  is its value. Returns nil.
  """
  [binding coll & body]
  (each-template binding coll :each body))

(defn- check-empty-body
  [body]
  (if (= (length body) 0)
    (maclintf :normal "empty loop body")))

(defmacro loop
  """
  Runs body a number of times. This macro is similar to the Common Lisp loop
  macro, although intentionally much smaller in scope. The head of the loop
  should be a tuple that contains a sequence of either bindings or
  conditionals. A binding is a sequence of three values that define something
  to loop over. Bindings are written in the format:

      binding :verb object/expression

  where binding is a binding as passed to def, :verb is one of a set of
  keywords, and object is any expression. Each subsequent binding creates a
  nested loop within the loop created by the previous binding.

  The available verbs are:

  * :iterate -- repeatedly evaluate and bind to the expression while it is
    truthy.

  * :range -- loop over a range. The object should be a two-element tuple with
    a start and end value, and an optional positive step. The range is half
    open, [start, end).

  * :range-to -- same as :range, but the range is inclusive [start, end].

  * :down -- loop over a range, stepping downwards. The object should be a
    two-element tuple with a start and end value, and an optional
    (positive!) step. The range is half open, [start, end).

  * :down-to -- same as :down, but the range is inclusive [start, end].

  * :keys -- iterate over the keys in a data structure.

  * :pairs -- iterate over the `[key value]` pairs in a data structure. The key
    of an array, tuple, vector, string or buffer is the index of the value.

  * :in -- iterate over the elements in a data structure or fiber. The element
    of a table or map is the vector `[key value]`.

  ^loop also accepts conditionals to refine the looping further. Conditionals are of
  the form:

      :modifier argument

  where :modifier is one of a set of keywords, and argument is keyword-dependent.
  :modifier can be one of:

  * :while expression -- breaks from the current loop if expression is
    falsey.

  * :until expression -- breaks from the current loop if expression is
    truthy.

  * :let bindings -- defines bindings inside the current loop as passed to the
    ^let macro.

  * :before form -- evaluates a form for a side effect before the next inner
    loop.

  * :after form -- same as :before, but the side effect happens after the
    next inner loop.

  * :repeat n -- repeats the next inner loop n times.

  * :when condition -- only evaluates the current loop body when condition
    is truthy.

  * :unless condition -- only evaluates the current loop body when condition
    is falsey.

  The loop macro always evaluates to nil.
  """
  [head & body]
  (loop1 body head 0))

(defmacro seq
  """
  Accumulates body into an array and returns that. It is similar to ^loop. See
  it for details.
  """
  [head & body]
  (def $accum (gensym))
  (check-empty-body body)
  `(do (def ~$accum ![]) (as-macro ~loop ~head (~array/push! ~$accum (do ~|body))) ~$accum))

(defmacro catseq
  """
  Concatenates each element from the loop body into an array and returns that.
  It is similar to ^loop. See it for details.
  """
  [head & body]
  (def $accum (gensym))
  (check-empty-body body)
  `(do (def ~$accum ![]) (as-macro ~loop ~head (~array/concat! ~$accum (do ~|body))) ~$accum))

(defmacro tabseq
  """
  Accumulates key-value pairs into a table. It is similar to ^loop. See it for
  details.
  """
  [head key-body & value-body]
  (def $accum (gensym))
  `(do (def ~$accum !{}) (as-macro ~loop ~head (~put! ~$accum ~key-body (do ~|value-body))) ~$accum))

(defmacro generate
  """
  Creates a generator expression using the ^loop syntax. Returns a fiber that
  yields all values inside the loop in order. See ^loop for details.
  """
  [head & body]
  (check-empty-body body)
  `(~fiber/new (fn :generate [] (as-macro ~loop ~head (~yield (do ~|body)))) :yi))

(defmacro coro
  """
  Returns a fiber that wraps body. Same as `(fiber/new (fn [] |body) :yi)`.
  """
  [& body]
  (tuple fiber/new (tuple 'fn :coro '[] |body) :yi))

(defmacro fiber-fn
  """
  Returns a fiber with flags that wraps body. Same as `(fiber/new (fn []
  |body) flags)`.
  """
  [flags & body]
  (tuple fiber/new (tuple 'fn :fiber-fn '[] |body) flags))

(defn sum
  "Returns the sum of the elements in coll, an iterable. If coll is empty, returns 0."
  [coll]
  (var accum 0)
  (each x coll (+= accum x))
  accum)

; True when (length coll) is the number of elements iterating coll yields. An
; abstract type's length callback need not agree with its iteration, so only a
; core type qualifies.
(defmacro- counted?
  [coll]
  (if (idempotent? coll)
    `(if (~lengthable? ~coll) (if (~abstract? ~coll) false true) false)
    (with-syms [c]
      `(as-macro ~let [~c ~coll]
         (if (~lengthable? ~c) (if (~abstract? ~c) false true) false)))))

(defn mean
  """
  Returns the mean of the elements in coll, an iterable. If coll is empty,
  returns NaN.
  """
  [coll]
  (if (counted? coll)
    (do
      (var accum 0)
      (each x coll (+= accum x))
      (/ accum (length coll)))
    (do
      (var [accum total] [0 0])
      (each x coll (+= accum x) (++ total))
      (/ accum total))))

(defn geomean
  """
  Returns the geometric mean of the elements in coll, an iterable. If coll is
  empty, returns NaN.
  """
  [coll]
  (if (counted? coll)
    (do
      (var accum 0)
      (each x coll (+= accum (math/log x)))
      (math/exp (/ accum (length coll))))
    (do
      (var [accum total] [0 0])
      (each x coll (+= accum (math/log x)) (++ total))
      (math/exp (/ accum total)))))

(defn product
  """
  Returns the product of the elements in coll, an iterable. If coll is empty,
  returns 1.
  """
  [coll]
  (var accum 1)
  (each x coll (*= accum x))
  accum)

(defmacro when-let
  """
  Runs body if bindings resolves to true. Same as `(if-let bindings (do
  |body))`.
  """
  [bindings & body]
  `(as-macro ~if-let ~bindings (do ~|body)))

(defn comp
  """
  Takes multiple functions and returns a function that is the composition of
  those functions.
  """
  [& functions]
  (case (length functions)
    0 nil
    1 (in functions 0)
    2 (let [[f g] functions] (fn :comp [& x] (f (g |x))))
    3 (let [[f g h] functions] (fn :comp [& x] (f (g (h |x)))))
    4 (let [[f g h i] functions] (fn :comp [& x] (f (g (h (i |x))))))
    (let [[f g h i] functions]
      (comp (fn :comp [x] (f (g (h (i x)))))
            |(tuple/slice functions 4 -1)))))

(defn identity
  "Returns its argument."
  [x]
  x)

(defn complement
  "Returns a function that is the complement to the argument."
  [f]
  (fn :complement [x] (not (f x))))

(defmacro- do-extreme
  [order args]
  `(do
     (def ds ~args)
     (def dict (dictionary? ds))
     (var k (next ds nil))
     (var ret (if (= nil k) nil (element ds dict k)))
     (while (~not= nil (set k (next ds k)))
       (def x (element ds dict k))
       (if (~order x ret) (set ret x)))
     ret))

(defn extreme
  """
  Returns the most extreme value in args based on order. order should be a
  function that takes two values and return true if the first value is more
  extreme than the second value. Returns nil if args is empty.
  """
  [order args] (do-extreme order args))

(defn max
  "Returns the maximum of args, comparing with ^>."
  [& args] (do-extreme > args))

(defn min
  "Returns the minimum of args, comparing with ^<."
  [& args] (do-extreme < args))

(defn max-of
  """
  Returns the maximum element in args, an iterable, comparing with ^>. Returns
  nil if args is empty.
  """
  [args] (do-extreme > args))

(defn min-of
  """
  Returns the minimum element in args, an iterable, comparing with ^<. Returns
  nil if args is empty.
  """
  [args] (do-extreme < args))

(defn first
  """
  Gets the first value in ind, an indexed type. Same as `(get ind 0)`. Returns
  nil if ind is empty.
  """
  [ind]
  (get ind 0))

(defn last
  "Gets the last value in ind, an indexed type. Returns nil if ind is empty."
  [ind]
  (get ind (- (length ind) 1)))

;; Polymorphic comparisons

(defmacro- do-compare
  [x y]
  (def f (gensym))
  (def f-res (gensym))
  (def g (gensym))
  (def g-res (gensym))
  `(do
     (def ~f (~get ~x :compare))
     (def ~f-res (if ~f (~f ~x ~y)))
     (if ~f-res
       ~f-res
       (do
         (def ~g (~get ~y :compare))
         (def ~g-res (if ~g (~- (~g ~y ~x))))
         (if ~g-res
           ~g-res
           (~cmp ~x ~y))))))

(defn compare
  """
  Compares x and y polymorphically.

  Returns:
  - -1 for x < y
  - 0 for x = y
  - 1 for x > y

  Differs from the primitive comparators in that it first checks to see whether
  either x or y implement a ^compare method which can compare x and y. If so,
  it uses that method. If not, it delegates to the primitive comparators.
  """
  [x y]
  (do-compare x y))

(defmacro- compare-reduce [op xs]
  `(do
     (var res true)
     (var x (get ~xs 0))
     (forv i 1 (length ~xs)
       (let [y (in ~xs i)]
         (if (~op (do-compare x y) 0)
           (set x y)
           (do (set res false) (break)))))
     res))

(defn compare=
  "Compares using polymorphic = instead of ^=."
  [& xs]
  (compare-reduce = xs))

(defn compare<
  "Compares using polymorphic < instead of ^<."
  [& xs]
  (compare-reduce < xs))

(defn compare<=
  "Compares using polymorphic <= instead of ^<=."
  [& xs]
  (compare-reduce <= xs))

(defn compare>
  "Compares using polymorphic > instead of ^>."
  [& xs]
  (compare-reduce > xs))

(defn compare>=
  "Compares using polymorphic >= instead of ^>=."
  [& xs]
  (compare-reduce >= xs))

(defn zero? "Checks whether x is zero." [x] (= (compare x 0) 0))
(defn pos? "Checks whether x is greater than 0." [x] (= (compare x 0) 1))
(defn neg? "Checks whether x is less than 0." [x] (= (compare x 0) -1))
(defn one? "Checks whether x is equal to 1." [x] (= (compare x 1) 0))
(defn even? "Checks whether x is even." [x] (= 0 (compare 0 (mod x 2))))
(defn odd? "Checks whether x is odd." [x] (= 0 (compare 1 (mod x 2))))

;;;
;;;
;;; Indexed Combinators
;;;
;;;

(defmacro- median-of-three
  [x y z]
  `(if (<= ~x ~y)
     (if (<= ~y ~z) ~y (if (<= ~z ~x) ~x ~z))
     (if (<= ~z ~y) ~y (if (<= ~x ~z) ~x ~z))))

(defmacro- sort-partition-template
  [ds before? left right pivot]
  `(do
     (while (~before? (in ~ds ~left) ~pivot) (++ ~left))
     (while (~before? ~pivot (in ~ds ~right)) (-- ~right))))

(defn- sort-help [ds lo hi before?]
  (when (< lo hi)
    (def [x y z] [(in ds lo)
                  (in ds (div (+ lo hi) 2))
                  (in ds hi)])
    (def pivot (median-of-three x y z))
    (var left lo)
    (var right hi)
    (while true
      (case before?
        < (sort-partition-template ds < left right pivot)
        > (sort-partition-template ds > left right pivot)
        (sort-partition-template ds before? left right pivot))
      (when (<= left right)
        (def tmp (in ds left))
        (set (ds left) (in ds right))
        (set (ds right) tmp)
        (++ left)
        (-- right))
      (if (>= left right) (break)))
    (if (< lo right)
      (sort-help ds lo right before?))
    (if (< left hi)
      (sort-help ds left hi before?)))
  ds)

(defn- sort-impl [ds before?]
  (sort-help ds 0 (- (length ds) 1) before?))

(defn sort!
  """
  Sorts mut in-place and returns it. Uses quick-sort and is not a stable sort. If
  before? is omitted, uses ^< for ordering.

  mut can be an array, a buffer or an abstract type with get, put and length
  callbacks defined. A tuple or vector is rejected.
  """
  ([mut] (sort-impl mut <))
  ([before? mut]
    (sort-impl mut before?)))

(defn sort-by!
  """
  Sorts mut in-place and returns it. Uses f on each element and compares the
  results with ^<.

  mut can be an array, a buffer or an abstract type with get, put and length
  callbacks defined. A tuple or vector is rejected.
  """
  [f mut]
  (sort-impl mut (fn :sort-by-comp [i j] (< (f i) (f j)))))

(defn sort
  """
  Sorts the elements of ind, an indexed type, into a new array and returns it.
  If before? is omitted, uses ^< for ordering.
  """
  ([ind] (sort-impl (array/slice ind) <))
  ([before? ind]
    (sort-impl (array/slice ind) before?)))

(defn sort-by
  """
  Sorts the elements of ind, an indexed type, into a new array and returns it.
  Uses f on each element and compares the results with ^<.
  """
  [f ind]
  (sort-impl (array/slice ind) (fn :sorted-by-comp [x y] (< (f x) (f y)))))

(defn reduce
  """
  Reduces coll, an iterable, applying f on each element in coll in order.

  Iterates over each element in coll, holding the result of the previous call to
  f. Returns the result of the final call to f.

  f is a function of 2 arguments, `(f accum el)`. The first argument is the
  previous call to f. The second argument is the current element. For the
  initial iteration, init is used as the first argument. If init is not
  provided, f is skipped for the initial iteration and the first element is
  used as the first argument when f is applied to the second element.

  If coll is empty, evaluates to nil.
  """
  ([f coll]
    (def dict (dictionary? coll))
    (var k (next coll))
    (if (= nil k) (break nil))
    (var res (element coll dict k))
    (set k (next coll k))
    (while (not= nil k)
      (set res (f res (element coll dict k)))
      (set k (next coll k)))
    res)
  ([f init coll]
    (var accum init)
    (each el coll (set accum (f accum el)))
    accum))

(defn accumulate
  """
  Accumulates values for elements in coll, an iterable, into an array.

  Similar to ^reduce, but accumulates the results of each application of f into
  an array. The last element in the array is what would be the return value
  from ^reduce. The init value is not added to the array (the return value will
  have the same number of elements as coll). Returns a new array.

  Without an initialization value init, the first element in coll is added
  to the array as-is (the return value will have the same number of elements as
  coll).
  """
  ([f coll]
    (def dict (dictionary? coll))
    (var k (next coll))
    (def ret ![])
    (if (= nil k) (break ret))
    (var res (element coll dict k))
    (array/push! ret res)
    (set k (next coll k))
    (while (not= nil k)
      (set res (f res (element coll dict k)))
      (array/push! ret res)
      (set k (next coll k)))
    ret)
  ([f init coll]
    (var res init)
    (def ret ![])
    (each x coll (array/push! ret (set res (f res x))))
    ret))

(defmacro- map-aggregator
  "Performs operations for various mapping functions."
  [maptype res val]
  (case maptype
    :map `(array/push! ~res ~val)
    :mapcat `(array/concat! ~res ~val)
    :keep `(if (def y ~val) (array/push! ~res y))
    :count `(if ~val (++ ~res))))

(defmacro- map-n
  """
  Generates efficient map logic for a specific number of
  collections beyond the first.
  """
  [n maptype res f coll colls]
  `(do
     (def ~(seq [k :range [0 n]] (symbol 'coll k)) ~colls)
     ~|(seq [k :range [0 n]] `(def ~(symbol 'dict k) (dictionary? ~(symbol 'coll k))))
     ~|(seq [k :range [0 n]] `(var ~(symbol 'key k) nil))
     (each x ~coll
       ~|(seq [k :range [0 n]]
           `(if (= nil (set ~(symbol 'key k) (next ~(symbol 'coll k) ~(symbol 'key k)))) (break)))
       (map-aggregator ~maptype ~res (~f x ~|(seq [k :range [0 n]] `(element ~(symbol 'coll k) ~(symbol 'dict k) ~(symbol 'key k))))))))

(defmacro- map-template
  [maptype res f coll colls]
  `(do
     (def ncolls (length ~colls))
     (case ncolls
       0 (each x ~coll (map-aggregator ~maptype ~res (~f x)))
       1 (map-n 1 ~maptype ~res ~f ~coll ~colls)
       2 (map-n 2 ~maptype ~res ~f ~coll ~colls)
       3 (map-n 3 ~maptype ~res ~f ~coll ~colls)
       (do
         (def iter-keys (array/new-filled ncolls))
         (def dicts (array/new-filled ncolls))
         (forv i 0 ncolls (put! dicts i (dictionary? (in ~colls i))))
         (def call-buffer (array/new-filled ncolls))
         (var done false)
         (each x ~coll
           (forv i 0 ncolls
             (let [old-key (in iter-keys i)
                   ii (in ~colls i)
                   new-key (next ii old-key)]
               (if (= nil new-key)
                 (do (set done true) (break))
                 (do (set (iter-keys i) new-key) (set (call-buffer i) (element ii (in dicts i) new-key))))))
           (if done (break))
           (map-aggregator ~maptype ~res (~f x |call-buffer)))))))

(defn map
  """
  Returns a new array of `(f x)` for each element in coll, an iterable.

  If colls is provided, (each of which is also an iterable), returns a new
  array of `(f x y ...)` for the elements of coll and colls taken together, so f
  takes one argument for coll and one for each of colls. The array has the
  length of the shortest of coll and colls.
  """
  [f coll & colls]
  (def res ![])
  (map-template :map res f coll colls)
  res)

(defn mapcat
  """
  Returns a new array that concatenates the results of `(f x)` for each
  element in coll, an iterable.

  Similar to ^map, but the results are concatenated. An indexed result is
  spliced in, so `(mapcat (fn [x] [x x]) [1 2])` returns `![1 1 2 2]` where
  ^map returns `![[1 1] [2 2]]`. Any other result is appended as one element.
  To add nothing for an element, return an empty indexed result.

  If colls is provided, (each of which is also an iterable), f is called as
  `(f x y ...)` for the elements of coll and colls taken together, and is applied
  only as many times as the length of the shortest of coll and colls.
  """
  [f coll & colls]
  (def res ![])
  (map-template :mapcat res f coll colls)
  res)

(defn filter
  """
  Returns a new array of the elements x in coll, an iterable, for which
  `(pred x)` is truthy.
  """
  [pred coll]
  (def res ![])
  (each item coll
    (if (pred item)
      (array/push! res item)))
  res)

(defn count
  """
  Returns the number of elements x in coll, an iterable, for which `(pred x)`
  is truthy.

  If colls is provided, (each of which is also an iterable), pred is called as
  `(pred x y ...)` for the elements of coll and colls taken together, and is
  applied only as many times as the length of the shortest of coll and colls.
  """
  [pred coll & colls]
  (var res 0)
  (map-template :count res pred coll colls)
  res)

(defn keep
  """
  Returns a new array of the truthy results of `(pred x)` for each element x
  in coll, an iterable. Similar to ^map, but nil and false results are
  dropped.

  If colls is provided, (each of which is also an iterable), pred is called as
  `(pred x y ...)` for the elements of coll and colls taken together. The array
  is no longer than the shortest of coll and colls.
  """
  [pred coll & colls]
  (def res ![])
  (map-template :keep res pred coll colls)
  res)

(defn- check-keyed
  [name coll]
  (if (fiber? coll)
    (errorf "%s does not accept a fiber, got %v" name coll)))

(defn find-index
  """
  Returns the key of the first element x in coll, an iterable, for which
  `(pred x)` is truthy. Returns dflt if there is none, or nil if dflt is not
  given.

  The key of an array, tuple, vector, string or buffer is the index of x. The
  element of a table or map is the entry `[key value]`, and its key is the key
  of the entry. The key of a set is x itself. A fiber has no keys, so coll may
  not be a fiber.
  """
  ([pred coll] (find-index pred coll nil))
  ([pred coll dflt]
    (check-keyed :find-index coll)
    (def dict (dictionary? coll))
    (var k (next coll nil))
    (var ret dflt)
    (while (not= nil k)
      (when (pred (element coll dict k))
        (set ret k)
        (break))
      (set k (next coll k)))
    ret))

(defn find
  """
  Returns the first element x in coll, an iterable, for which `(pred x)` is
  truthy. Returns dflt if there is none, or nil if dflt is not given. A
  matching element that is itself nil is returned as nil, so give dflt to tell
  it apart from no match.
  """
  ([pred coll] (find pred coll nil))
  ([pred coll dflt]
    (def dict (dictionary? coll))
    (var k (next coll nil))
    (var ret dflt)
    (while (not= nil k)
      (def item (element coll dict k))
      (when (pred item)
        (set ret item)
        (break))
      (set k (next coll k)))
    ret))

(defn index-of
  """
  Returns the key of the first value in coll, an iterable, that is equal to x,
  acting like a reverse lookup. Returns dflt if there is none, or nil if dflt
  is not given.

  Values are compared with ^=. The key of an array, tuple, vector, string or
  buffer is the index of the value. The key of a table or map is the key of the
  value, and the key of a set is the value itself. A fiber has no keys, so coll
  may not be a fiber. Table prototypes are not searched.
  """
  ([x coll] (index-of x coll nil))
  ([x coll dflt]
    (check-keyed :index-of coll)
    (var k (next coll nil))
    (var ret dflt)
    (while (not= nil k)
      (when (= (in coll k) x) (set ret k) (break))
      (set k (next coll k)))
    ret))

(defn- check-count
  [name n]
  (if (neg? n)
    (errorf "%s expected a non-negative count, got %v" name n)))

(defn take
  """
  Takes the first n elements of coll, an iterable.
  Returns a fiber that yields them. Nothing is read from coll until the fiber
  is resumed. n must not be negative.
  """
  [n coll]
  (check-count :take n)
  (coro
    (var left n)
    (when (> left 0)
      (each x coll
        (yield x)
        (if (zero? (-- left)) (break))))))

(defn take-until
  """
  Takes the elements of coll, an iterable, that precede the first for which
  `(pred element)` is truthy. Returns a fiber that
  yields them. Nothing is read from coll until the fiber is resumed. The
  matching element is not yielded.
  """
  [pred coll]
  (coro
    (each x coll
      (if (pred x) (break))
      (yield x))))

(defn take-while
  """
  Takes the leading elements of coll, an iterable, for which `(pred element)`
  is truthy. Returns a fiber that yields them. Same as
  `(take-until (complement pred) coll)`.
  """
  [pred coll]
  (take-until (complement pred) coll))

(defn drop
  """
  Drops the first n elements of coll, an iterable. Returns a fiber that yields
  the rest. Nothing is read from coll until the fiber is resumed. n must not be
  negative.
  """
  [n coll]
  (check-count :drop n)
  (coro
    (var left n)
    (each x coll
      (if (> left 0) (-- left) (yield x)))))

(defn drop-until
  """
  Drops the elements of coll, an iterable, that precede the first for which
  `(pred element)` is truthy. Returns a fiber that yields that element and the
  rest. Nothing is read from coll until the fiber is resumed.
  """
  [pred coll]
  (coro
    (var skipping true)
    (each x coll
      (if (and skipping (pred x)) (set skipping false))
      (if (not skipping) (yield x)))))

(defn drop-while
  """
  Drops the leading elements of coll, an iterable, for which `(pred element)`
  is truthy. Returns a fiber that yields the rest. Same as `(drop-until
  (complement pred) coll)`.
  """
  [pred coll]
  (drop-until (complement pred) coll))

(defn juxt*
  """
  Returns the juxtaposition of functions. In other words, `((juxt* a b c) x)`
  evaluates to `[(a x) (b x) (c x)]`.
  """
  [& funs]
  (fn :juxt* [& args]
    (def ret ![])
    (each f funs
      (array/push! ret (f |args)))
    (vec ret)))

(defmacro juxt
  """
  Returns the juxtaposition of functions using a macro. This is equivalent to
  ^juxt* but more efficient.
  """
  [& funs]
  (def parts !['vector])
  (def $args (gensym))
  (each f funs
    (array/push! parts (tuple apply f $args)))
  (tuple 'fn :juxt (vector '& $args) (tuple/slice parts 0)))

(defn has-key?
  """
  Checks whether x maps key to a non-nil value.

  x can be a bytes, indexed, dictionary, fiber, or abstract type with a
  suitable ^get method.
  """
  [x key]
  (not= nil (get x key)))

(defn has-value?
  """
  Checks whether coll, an iterable, contains a value equal to val. The values
  of a table or map are the values of its entries, not the entries.
  """
  [coll val]
  (var found false)
  (eachv v coll
    (when (= v val)
      (set found true)
      (break)))
  found)

(defdyn *defdyn-prefix* "Optional namespace prefix to add to keywords declared with ^defdyn. Use this to prevent keyword collisions between dynamic bindings.")
(defdyn *out* "Where normal print functions print output to.")
(defdyn *err* "Where error printing prints output to.")
(defdyn *redef* "When set, allows dynamically rebinding top level defs. Will slow generated code and is intended to be used for development.")
(defdyn *debug* "Enables a built in debugger on errors and other useful features for debugging in a repl.")
(defdyn *exit* "When set, will cause the current context to complete. Can be set to exit from repl (or file), for example.")
(defdyn *exit-value* "Sets the return value from ^run-context upon an exit.")
(defdyn *task-id* "When spawning a thread or fiber, the task-id can be assigned for concurrency control.")
(defdyn *current-file* "Bound to the name of the currently compiling file.")

(defmacro tracev
  """
  Prints to stderr a value and a description of the form that produced that
  value. Evaluates to x.
  """
  [x]
  (def [l c] (tuple/sourcemap (dyn *macro-form* ())))
  (def cf (dyn *current-file*))
  (def fmt-1 (if cf (string/format "trace [%s]" cf) "trace"))
  (def fmt-2 (if (or (neg? l) (neg? c)) ":" (string/format " on line %d, column %d:" l c)))
  (def fmt (string fmt-1 fmt-2 " %w is "))
  (def s (gensym))
  `(upscope
     (def ~s ~x)
     (~eprinf ~fmt '~x)
     (~eprintf (~dyn :pretty-format "%q") ~s)
     ~s))

(defn- thread-form
  """
  Returns the form n with arg inserted as its first argument if first? is
  truthy and as its last otherwise. A symbol or other atom n is called with arg.
  A tuple keeps its source map.
  """
  [n arg first?]
  (def call? (= :tuple (type n)))
  (def [h t] (if call?
               (tuple (in n 0) (array/slice n 1))
               (tuple n ![])))
  (def parts (tuple/slice (if first?
                            (array/concat! ![h arg] t)
                            (array/concat! ![h] t ![arg]))))
  (if call? (tuple/sourcemap! parts (tuple/sourcemap n)) parts))

(defmacro ->
  """
  Threads a value through a series of forms as a macro. Inserts x as the first
  argument to the initial value of forms and then passes each result as the
  first argument to the next value of forms. Useful for expressing pipelines of
  data.
  """
  [x & forms]
  (reduce (fn [last n] (thread-form n last true)) x forms))

(defmacro ->>
  """
  Threads a value through a series of forms as a macro. Inserts x as the last
  argument to the initial value of forms and then passes each result as the
  last argument to the next value of forms. Useful for expressing pipelines of
  data.
  """
  [x & forms]
  (reduce (fn [last n] (thread-form n last false)) x forms))

(defmacro -?>
  """
  Threads a value through a series of forms as a macro. The difference with ^-> is
  that this short-circuits if any value is nil.
  """
  [x & forms]
  (defn fop [last n]
    (def sym (gensym))
    `(as-macro ~let [~sym ~last] (if ~sym ~(thread-form n sym true))))
  (reduce fop x forms))

(defmacro -?>>
  """
  Threads a value through a series of forms as a macro. The difference with ^->> is
  that this short-circuits if any value is nil.
  """
  [x & forms]
  (defn fop [last n]
    (def sym (gensym))
    `(as-macro ~let [~sym ~last] (if ~sym ~(thread-form n sym false))))
  (reduce fop x forms))

(defn- walk-ind [f form]
  (def ret ![])
  (each x form (array/push! ret (f x)))
  ret)

(defn- walk-dict [f form]
  (def ret !{})
  (loop [k :keys form]
    (put! ret (f k) (f (in form k))))
  ret)

(defn walk
  """
  Applies f to each element of form. Returns the results.
  """
  [f form]
  (case (type form)
    :table (walk-dict f form)
    :map (table/to-map (walk-dict f form))
    :array (walk-ind f form)
    :vector (vector |(walk-ind f form))
    :tuple (tuple/sourcemap! (tuple/slice (walk-ind f form)) (tuple/sourcemap form))
    form))

(defn postwalk
  """
  Does a post-order traversal of a data structure and calls `(f x)`
  on every visitation.
  """
  [f form]
  (f (walk (fn [x] (postwalk f x)) form)))

(defn prewalk
  "Similar to ^postwalk, but does pre-order traversal."
  [f form]
  (walk (fn [x] (prewalk f x)) (f form)))

(defmacro as->
  """
  Threads forms together, replacing as in forms with the value
  of the previous form. The first form is the value x. Returns the
  last value.
  """
  [x as & forms]
  (var prev x)
  (each form forms
    (def sym (gensym))
    (def next-prev (postwalk (fn [y] (if (= y as) sym y)) form))
    (set prev `(let [~sym ~prev] ~next-prev)))
  prev)

(defmacro as?->
  """
  Threads forms together, replacing as in forms with the value
  of the previous form. The first form is the value x. If any
  intermediate values are falsey, returns nil; otherwise, returns the
  last value.
  """
  [x as & forms]
  (var prev x)
  (each form forms
    (def sym (gensym))
    (def next-prev (postwalk (fn [y] (if (= y as) sym y)) form))
    (set prev `(if-let [~sym ~prev] ~next-prev)))
  prev)

(defmacro with-dyns
  """
  Runs a block of code in a new fiber that has some
  dynamic bindings set. The fiber will not mask errors
  or signals, but the dynamic bindings will be properly
  unset, as dynamic bindings are fiber-local.
  """
  [bindings & body]
  (def dyn-forms
    (seq [i :range [0 (length bindings) 2]]
      `(setdyn ~(bindings i) ~(bindings (+ i 1)))))
  `(~resume (~fiber/new (fn :with-dyns [] ~|dyn-forms ~|body) :p)))

(defmacro with-env
  "Runs a block of code with a given environment table"
  [env & body]
  `(~resume (~fiber/new (fn :with-env [] ~|body) : ~env)))

(defmacro with-vars
  """
  Evaluates body with each var in vars temporarily bound. Similar signature to
  ^let, but each binding must be a var.
  """
  [vars & body]
  (def len (length vars))
  (unless (even? len) (error "expected even number of argument to vars"))
  (def temp (seq [i :range [0 len 2]] (gensym)))
  (def saveold (seq [i :range [0 len 2]] (tuple 'def (temp (/ i 2)) (vars i))))
  (def setnew (seq [i :range [0 len 2]] (tuple 'set (vars i) (vars (+ i 1)))))
  (def restoreold (seq [i :range [0 len 2]] (tuple 'set (vars i) (temp (/ i 2)))))
  (with-syms [ret f s]
    `(do
       ~|saveold
       (def ~f (~fiber/new (fn :with-vars [] ~|setnew ~|body) :ti))
       (def ~ret (~resume ~f))
       ~|restoreold
       (if (= (~fiber/status ~f) :dead) ~ret (~propagate ~ret ~f)))))

(defn partial
  "Partial function application."
  [f & more]
  (if (zero? (length more)) f
    (fn :partial [& r] (f |more |r))))

(defn every?
  """
  Evaluates to the last element of coll, an iterable, if all preceding
  elements are truthy, otherwise evaluates to the first falsey element.
  """
  [coll]
  (var res true)
  (loop [x :in coll :while res]
    (set res x))
  res)

(defn any?
  """
  Evaluates to the last element of coll, an iterable, if all preceding
  elements are falsey, otherwise evaluates to the first truthy element.
  """
  [coll]
  (var res nil)
  (loop [x :in coll :until res]
    (set res x))
  res)

(defn reverse!
  """
  Reverses the order of the elements in mut, an array or buffer, and returns it
  mutated.
  """
  [mut]
  (var i 0)
  (var j (length mut))
  (while (< i (-- j))
    (def di (in mut i))
    (put! mut i (in mut j))
    (put! mut j di)
    (++ i))
  mut)

(defn reverse
  """
  Reverses the order of the elements in coll, an iterable, and returns a new
  array. If coll is a string or buffer, returns a new buffer instead.
  """
  [coll]
  (if (counted? coll)
    (do
      (var n (length coll))
      (def ret (if (bytes? coll)
                 (buffer/new-filled n)
                 (array/new-filled n)))
      (each v coll
        (put! ret (-- n) v))
      ret)
    (reverse! (seq [v :in coll] v))))

(defn invert
  """
  Returns a table where the keys of coll, an iterable, are the values, and the
  values are the keys. If multiple keys in coll are mapped to the same value,
  only one of those values will become a key in the returned table.

  The key of an array, tuple, vector, string or buffer is the index of the
  value. The key of a table or map is its key, and the key of a set is the
  element itself. A fiber has no keys, so coll may not be a fiber.
  """
  [coll]
  (check-keyed :invert coll)
  (def ret !{})
  (loop [k :keys coll]
    (put! ret (in coll k) k))
  ret)

(defn zipcoll
  """
  Creates a table from two arrays/tuples.
  Returns a new table.
  """
  [ks vs]
  (def res !{})
  (var kk nil)
  (var vk nil)
  (while true
    (set kk (next ks kk))
    (if (= nil kk) (break))
    (set vk (next vs vk))
    (if (= nil vk) (break))
    (put! res (in ks kk) (in vs vk)))
  res)

(defn get-in
  """
  Accesses a value in a nested data structure x. Looks into x via ks, an
  iterable of keys. If value is not found, and dflt is provided, returns dflt.
  """
  ([x ks] (get-in x ks nil))
  ([x ks dflt]
    (var d x)
    (loop [k :in ks :while (not (nil? d))] (set d (get d k)))
    (if (= nil d) dflt d)))

(defn update-in!
  """
  Updates a value in a nested data structure mut, an array, buffer or table.
  Looks into mut via ks, an indexed type of keys, and replaces the value found
  there with f applied to that value.
  Missing data structures will be replaced with tables. Returns
  the modified, original data structure.
  """
  [mut ks f & args]
  (var d mut)
  (def len-1 (- (length ks) 1))
  (if (< len-1 0) (error "expected at least 1 key in ks"))
  (forv i 0 len-1
    (def k (get ks i))
    (def v (get d k))
    (if (= nil v)
      (let [newv (table)]
        (put! d k newv)
        (set d newv))
      (set d v)))
  (def last-key (get ks len-1))
  (def last-val (get d last-key))
  (put! d last-key (f last-val |args))
  mut)

(defn put-in!
  """
  Puts a value into a nested data structure mut, an array, buffer or table.
  Looks into mut via ks, an indexed type of keys. Missing data structures will
  be replaced with tables. Returns the modified, original data structure.
  """
  [mut ks val]
  (var d mut)
  (def len-1 (- (length ks) 1))
  (if (< len-1 0) (error "expected at least 1 key in ks"))
  (forv i 0 len-1
    (def k (get ks i))
    (def v (get d k))
    (if (= nil v)
      (let [newv (table)]
        (put! d k newv)
        (set d newv))
      (set d v)))
  (put! d (get ks len-1) val)
  mut)

(defn update!
  """
  For a given key in mut, an array, buffer or table, replaces its corresponding value with the
  result of calling f on that value. If args are provided, they will be passed
  along to f as well. Returns mut, updated.
  """
  [mut key f & args]
  (def old (get mut key))
  (put! mut key (f old |args)))

(defn merge!
  """
  Merges multiple dictionaries (tables or maps) into table tab. If a key appears in
  more than one dictionary in dicts, then later values replace any
  previous ones. Returns tab.
  """
  [tab & dicts]
  (loop [c :in dicts
         key :keys c]
    (put! tab key (in c key)))
  tab)

(defn merge
  """
  Merges multiple dictionaries (tables or maps) into one new table. If a key appears in
  more than one dictionary in dicts then later values replace any
  previous ones. Returns the new table.
  """
  [& dicts]
  (def container !{})
  (loop [c :in dicts
         key :keys c]
    (put! container key (in c key)))
  container)

(defn keys
  """
  Gets the keys of coll, an iterable, as an array.

  The key of an array, tuple, vector, string or buffer is the index of the
  value. The key of a table or map is its key, and the key of a set is the
  element itself. A fiber has no keys, so coll may not be a fiber.
  """
  [coll]
  (check-keyed :keys coll)
  (if (counted? coll)
    (do
      (def arr (array/new-filled (length coll)))
      (var i 0)
      (eachk k coll
        (put! arr i k)
        (++ i))
      arr)
    (seq [k :keys coll] k)))

(defn values
  """
  Gets the values of coll, an iterable, as an array. The values of a string or
  buffer are its bytes, and those of a table or map are its values.
  """
  [coll]
  (if (counted? coll)
    (do
      (def arr (array/new-filled (length coll)))
      (var i 0)
      (eachv v coll
        (put! arr i v)
        (++ i))
      arr)
    (do
      (def arr ![])
      (eachv v coll (array/push! arr v))
      arr)))

(defn pairs
  """
  Returns a new array of `[key value]` vectors for the pairs of coll, an
  iterable.

  The key of an array, tuple, vector, string or buffer is the index of the
  value. The key of a table or map is its key, and the key of a set is the
  element itself. A fiber has no keys, so coll may not be a fiber.
  """
  [coll]
  (check-keyed :pairs coll)
  (if (counted? coll)
    (do
      (def arr (array/new-filled (length coll)))
      (var i 0)
      (loop [p :pairs coll]
        (put! arr i p)
        (++ i))
      arr)
    (seq [p :pairs coll] p)))

(defn frequencies
  "Gets the number of occurrences of each element in coll, an iterable."
  [coll]
  (def freqs !{})
  (each x coll
    (put! freqs x (inc (in freqs x 0))))
  freqs)

(defn group-by
  """
  Groups elements of coll, an iterable, by a function f and puts the results into a new table. The keys of
  the table are the distinct return values from calling f on the elements of coll. The values
  of the table are arrays of all elements of coll for which f called on the element equals
  that corresponding key.
  """
  [f coll]
  (def ret !{})
  (each x coll
    (def y (f x))
    (if-let [arr (get ret y)]
      (array/push! arr x)
      (put! ret y ![x])))
  ret)

(defn partition-by
  """
  Partitions the elements of coll, an iterable, by a representative function f. Partitions
  split when `(f x)` changes values when iterating to the next element `x` of coll. Returns a new array
  of arrays.
  """
  [f coll]
  (def ret ![])
  (var span nil)
  (var category nil)
  (var is-new true)
  (each x coll
    (def y (f x))
    (cond
      is-new (do (set is-new false) (set category y) (set span ![x]) (array/push! ret span))
      (= y category) (array/push! span x)
      (do (set category y) (set span ![x]) (array/push! ret span))))
  ret)

(defn interleave
  "Returns an array of the first elements of each of colls, iterables, then the second elements, etc."
  [& colls]
  (mapcat tuple |colls))

(defn distinct
  "Returns an array of the deduplicated elements in coll, an iterable."
  [coll]
  (def ret ![])
  (def seen !{})
  (each x coll (if (in seen x) nil (do (put! seen x true) (array/push! ret x))))
  ret)

(defn flatten!
  """
  Appends the depth-first traversal of coll, an iterable, into the array into.
  Elements of coll that are indexed types are traversed recursively and other
  elements are appended as they are. Returns into.
  """
  [into coll]
  (each elt coll
    (if (indexed? elt)
      (flatten! into elt)
      (array/push! into elt)))
  into)

(defn flatten
  """
  Returns a depth-first traversal of coll, an iterable, as a new array.
  Elements of coll that are indexed types are traversed recursively and other
  elements are kept as they are.
  """
  [coll]
  (flatten! ![] coll))

(defn kvs
  """
  Takes a table or map and returns a new array of key value pairs
  like `![k v k v ...]`.
  """
  [dict]
  (def ret ![])
  (loop [k :keys dict] (array/push! ret k (in dict k)))
  ret)

(defn from-pairs
  """
  Takes a sequence of pairs and creates a table from each pair. It is the inverse of
  ^pairs on a table. Returns a new table.
  """
  [ps]
  (def ret !{})
  (each [k v] ps
    (put! ret k v))
  ret)

(defn interpose
  """
  Returns a new array of the elements of coll, an iterable, separated by sep.
  """
  [sep coll]
  (def dict (dictionary? coll))
  (var k (next coll nil))
  (if (not= nil k)
    (if (counted? coll)
      (do
        (def ret (array/new-filled (- (* 2 (length coll)) 1) sep))
        (var i 0)
        (while (not= nil k)
          (put! ret i (element coll dict k))
          (set k (next coll k))
          (+= i 2))
        ret)
      (do
        (def ret ![(element coll dict k)])
        (while (not= nil (set k (next coll k)))
          (array/push! ret sep (element coll dict k)))
        ret))
    ![]))

(defn- vector-slice
  """
  The indexed slice `partition` needs: a vector, whatever the value is.

  `slice` prefers bytes where a value is both bytes and indexed, which is
  right for `slice` and wrong here, since the branch has already chosen
  indexed. `tuple/slice` reads any indexed value and `vec` gives the sequence
  a vector rather than the call form.
  """
  ([ind start] (vector-slice ind start nil))
  ([ind start end]
    (vec (tuple/slice ind start end))))

(defn- partition-slice
  [f n ind]
  (var [start end] [0 n])
  (def len (length ind))
  (def parts (div len n))
  (def ret (array/new-filled parts))
  (forv k 0 parts
    (put! ret k (f ind start end))
    (set start end)
    (+= end n))
  (if (< start len)
    (array/push! ret (f ind start)))
  ret)

(defn partition
  """
  Partitions coll, an iterable, into vectors of size n. If coll is a string or
  buffer, the parts are strings. Returns a new array. The last part may be
  shorter than n.
  """
  [n coll]
  (cond
    (indexed? coll) (partition-slice vector-slice n coll)
    (bytes? coll) (partition-slice string/slice n coll)
    (partition-slice vector-slice n (seq [x :in coll] x))))

;;;
;;;
;;; IO Helpers
;;;
;;;

(defn slurp
  "Reads all data from a file with name path and then close the file."
  [path]
  (def f (file/open path :rb))
  (if-not f (error (string "could not open file " path)))
  (def contents (file/read f :all))
  (file/close f)
  contents)

(defn spit
  "Writes contents to a file at path. Can optionally append to the file."
  ([path contents] (spit path contents :wb))
  ([path contents mode]
    (def f (file/open path mode))
    (if-not f (error (string "could not open file " path " with mode " mode)))
    (file/write f contents)
    (file/close f)
    nil))

(defdyn *pretty-format*
  "Format specifier for the ^pp function")

(defdyn *repl-prompt*
  "Allows setting a custom prompt at the default REPL. Not all REPLs will respect this binding.")

(defn pp
  """Pretty-prints to stdout or `(dyn *out*)`. The format string used is `(dyn *pretty-format* "%q")`."""
  [x]
  (printf (dyn *pretty-format* "%q") x)
  (flush))

(defn file/lines
  "Returns an iterator over the lines of a file."
  [file]
  (coro
    (while (def line (file/read file :line))
      (yield line))))

;;;
;;;
;;; Pattern Matching
;;;
;;;

(defmacro match
  """
  Pattern matching. Matches an expression x against any number of cases.
  Each case is a pattern to match against, followed by an expression to
  evaluate to if that case is matched. Legal patterns are:

  * symbol -- a pattern that is a symbol will match anything, binding x's
    value to that symbol.

  * array or vector -- an array or vector will match only if
    all of its elements match the corresponding elements in x.
    Use `& rest` at the end of an array or vector to bind all remaining values to `rest`.

  * table or map -- a table or map will match if all values match with
    the corresponding values in x.

  * tuple -- a tuple pattern will match if its first element matches, and the
    following elements are treated as predicates and are true.

  * `_` symbol -- the last special case is the `_` symbol, which is a wildcard
    that will match any value without creating a binding.

  While a symbol pattern will ordinarily match any value, the pattern
  `(unquote <sym>)`, where `<sym>` is any symbol, will attempt to match x
  against a value already bound to `<sym>`, rather than matching and
  rebinding it.

  Any other value pattern will only match if it is equal to x.
  Quoting a pattern with `'` will also treat the value as a literal value to match against.

  """
  [x & cases]

  ; Partition body into sections.
  (def oddlen (odd? (length cases)))
  (def else (if oddlen (last cases)))
  (def patterns (partition 2 (if oddlen (slice cases 0 -2) cases)))

  ; Keep an array for accumulating the compilation output
  (def x-sym (if (idempotent? x) x (gensym)))
  (def accum ![])
  (if (not= x x-sym) (array/push! accum (tuple 'def x-sym x)))

  ; Table of gensyms
  (def symbols !{[nil nil] x-sym})
  (def length-symbols !{})

  (defn emit [x] (array/push! accum x))
  (defn emit-branch [condition result] (array/push! accum :branch condition result))

  (defn get-sym
    [parent-sym key]
    (def symbol-key [parent-sym key])
    (or (get symbols symbol-key)
        (let [s (gensym)]
          (put! symbols symbol-key s)
          (emit (tuple 'def s (tuple get parent-sym key)))
          s)))

  (defn get-length-sym
    [parent-sym]
    (or (get length-symbols parent-sym)
        (let [s (gensym)]
          (put! length-symbols parent-sym s)
          (emit (tuple 'def s (tuple 'if (tuple indexed? parent-sym)
                                  (tuple length parent-sym))))
          s)))

  (defn visit-pattern-1
    [b2g parent-sym key pattern]
    (if (= pattern '_) (break))
    (def s (get-sym parent-sym key))
    (def t (type pattern))
    (def isarr (or (= t :array) (= t :vector)))
    (cond

      ; match local binding
      (= t :symbol)
      (if-let [x (in b2g pattern)]
        (array/push! x s)
        (put! b2g pattern ![s]))

      ; match quoted literal
      (and (= t :tuple) (= 2 (length pattern)) (= 'quote (pattern 0)))
      (break)

      ; match data structure template
      (or (= t :map) (= t :table))
      (each [i sub-pattern] pattern
        (visit-pattern-1 b2g s i sub-pattern))

      isarr
      (do
        (get-length-sym s)
        (loop [[i sub-pattern] :pairs pattern]
          (when (= sub-pattern '&)
            (when (<= (length pattern) (inc i))
              (errorf "expected symbol following & in pattern"))

            (when (< (+ i 2) (length pattern))
              (errorf "expected a single symbol follow '& in pattern, found %q" (slice pattern (inc i))))

            (when (not= (type (pattern (inc i))) :symbol)
              (errorf "expected symbol following & in pattern, found %q" (pattern (inc i))))

            (put! b2g (pattern (inc i)) ![(tuple slice s i)])
            (break))
          (when (= sub-pattern '$)
            (when (not= (length pattern) (inc i))
              (error "expected $ to be last symbol in pattern"))
            (break))

          (visit-pattern-1 b2g s i sub-pattern)))

      ; match global unification
      (and (= t :tuple) (= 2 (length pattern)) (= 'unquote (pattern 0)))
      (break)

      ; match predicated binding
      (and (= t :tuple) (>= (length pattern) 2))
      (do
        (visit-pattern-1 b2g parent-sym key (pattern 0)))))

  (defn visit-pattern-2
    [anda gun preds parent-sym key pattern]
    (if (= pattern '_) (break))
    (def s (get-sym parent-sym key))
    (def t (type pattern))
    (def isarr (or (= t :array) (= t :vector)))
    (when isarr
      (array/push! anda (get-length-sym s))
      (def amp-index (find-index (fn [x] (= x '&)) pattern))
      (def dollar-index (find-index (fn [x] (= x '$)) pattern))
      (def pattern-len (or dollar-index amp-index (length pattern)))
      (array/push! anda
                  (tuple (if dollar-index = <=) pattern-len (get-length-sym s))))
    (cond

      ; match data structure template
      (or (= t :map) (= t :table))
      (each [i sub-pattern] pattern
        (array/push! anda (tuple not= nil (get-sym s i)))
        (visit-pattern-2 anda gun preds s i sub-pattern))

      isarr
      (loop [[i sub-pattern] :pairs pattern]
        ; stop recursing to sub-patterns if the rest sigil is found
        (when (or (= sub-pattern '$) (= sub-pattern '&))
          (break))
        (visit-pattern-2 anda gun preds s i sub-pattern))

      ; match local binding
      (= t :symbol) (break)

      ; match quoted literal
      (and (= t :tuple) (= 2 (length pattern)) (= 'quote (pattern 0)))
      (array/push! anda (tuple '= s pattern))

      ; match global unification
      (and (= t :tuple) (= 2 (length pattern)) (= 'unquote (pattern 0)))
      (if-let [x (in gun (pattern 1))]
        (array/push! x s)
        (put! gun (pattern 1) ![s]))

      ; match predicated binding
      (and (= t :tuple) (>= (length pattern) 2))
      (do
        (array/push! preds |(slice pattern 1))
        (visit-pattern-2 anda gun preds parent-sym key (pattern 0)))

      ; match literal
      (array/push! anda (tuple '= s pattern))))

  ; Compile the patterns
  (each [pattern expression] patterns
    (def b2g !{})
    (def gun !{})
    (def preds ![])
    (visit-pattern-1 b2g nil nil pattern)
    (def anda !['and])
    (visit-pattern-2 anda gun preds nil nil pattern)
    ; Local unification
    (def unify ![])
    (eachv syms b2g
      (when (< 1 (length syms))
        (array/push! unify (tuple = |syms))))
    ; Global unification
    (each [binding syms] gun
      (array/push! unify (tuple = binding |syms)))
    (sort! unify)
    (array/concat! anda unify)
    ; Final binding
    (def defs (seq [[k v] :in (sort! (pairs b2g))] (tuple 'def k (first v))))
    (def unused-defs
      (seq [[k v] :in (sort! (pairs b2g))] (tuple 'def k :unused (first v))))
    ; Predicates
    (unless (empty? preds)
      (def pred-join `(do ~|unused-defs (and ~|preds)))
      (array/push! anda pred-join))
    ; Use `unused-defs` instead of `defs` when we have predicates to avoid unused binding lint
    ; e.g. (match x (n (even? n)) :yes :no) should not warn on unused binding `n`.
    ; This is unfortunately not perfect since one programmer written binding is expanded for use in multiple places.
    (emit-branch (tuple/slice anda)
                 (tuple 'do |(if (next preds) unused-defs defs) expression)))

  ; Expand branches
  (def stack ![else])
  (each el (reverse accum)
    (if (= :branch el)
      (let [condition (array/pop! stack)
            truthy (array/pop! stack)
            if-form `(if ~condition ~truthy
                       ~(case (length stack)
                          0 nil
                          1 (stack 0)
                          `(do ~|(reverse stack))))]
        (array/remove! stack 0 (length stack))
        (array/push! stack if-form))
      (array/push! stack el)))

  `(do ~|(reverse stack)))

;;;
;;;
;;; Macro Expansion
;;;
;;;

(defn macex1
  """
  Expands macros in a form, but does not recursively expand macros.
  See ^macex docs for info on on-binding.
  """
  ([x] (macex1 x nil))
  ([x on-binding]

    (when on-binding
      (when (symbol? x)
        (break (on-binding x))))

    (defn recur [y] (macex1 y on-binding))

    (defn dotable [t on-value]
      (def newt !{})
      (var key (next t nil))
      (while (not= nil key)
        (put! newt (recur key) (on-value (in t key)))
        (set key (next t key)))
      newt)

    (defn expand-bindings [x]
      (case (type x)
        :array (map expand-bindings x)
        :vector (vector |(map expand-bindings x))
        :tuple (tuple/sourcemap! (tuple/slice (map expand-bindings x)) (tuple/sourcemap x))
        :table (dotable x expand-bindings)
        :map (table/to-map (dotable x expand-bindings))
        (recur x)))

    (defn expanddef [t]
      (def last (in t (- (length t) 1)))
      (def bound (in t 1))
      (tuple/sourcemap!
        (tuple/slice
          (array/concat!
            ![(in t 0) (expand-bindings bound)]
            (tuple/slice t 2 -2)
            ![(recur last)]))
        (tuple/sourcemap t)))

    (defn expandall [t]
      (def args (map recur (tuple/slice t 1)))
      (tuple (in t 0) |args))

    (defn expandfn [t]
      (def t1 (in t 1))
      (def named? (or (symbol? t1) (keyword? t1)))
      (def start (if named? 2 1))
      (if (= :tuple (type (in t start)))
        (do
          (def clauses
            (map (fn [clause]
                   (tuple (in clause 0) |(map recur (tuple/slice clause 1))))
                 (tuple/slice t start)))
          (if named?
            (tuple/sourcemap! (tuple 'fn t1 |clauses) (tuple/sourcemap t))
            (tuple/sourcemap! (tuple 'fn |clauses) (tuple/sourcemap t))))
        (do
          (def args (map recur (tuple/slice t (+ start 1))))
          (if named?
            (tuple/sourcemap! (tuple 'fn t1 (in t start) |args) (tuple/sourcemap t))
            (tuple/sourcemap! (tuple 'fn t1 |args) (tuple/sourcemap t))))))

    (defn expandqq [t]
      (defn qq [x]
        (case (type x)
          :tuple (do
                   (def x0 (get x 0))
                   (if (= 'unquote x0)
                     (tuple x0 (recur (get x 1)))
                     (tuple/slice (map qq x))))
          :vector (vector |(map qq x))
          :array (map qq x)
          :table (table |(map qq (kvs x)))
          :map (hash-map |(map qq (kvs x)))
          x))
      (tuple (in t 0) (qq (in t 1))))

    (def specs
      {'set expanddef
       'def expanddef
       'do expandall
       'fn expandfn
       'if expandall
       'quote identity
       'quasiquote expandqq
       'var expanddef
       'while expandall
       'break expandall
       'upscope expandall})

    (defn dotup [t]
      (if (= nil (next t)) (break ()))
      (def h (in t 0))
      (def s (in specs h))
      (def entry (or (dyn h) {}))
      (def m (do (def r (get entry :ref)) (if r (in r 0) (get entry :value))))
      (def m? (in entry :macro))
      (cond
        s (tuple/sourcemap! (tuple/slice (s t)) (tuple/sourcemap t))
        m? (do (setdyn *macro-form* t) (m |(tuple/slice t 1)))
        (tuple/sourcemap! (tuple/slice (map recur t)) (tuple/sourcemap t))))

    (def ret
      (case (type x)
        :tuple (dotup x)
        :vector (vector |(map recur x))
        :array (map recur x)
        :map (table/to-map (dotable x recur))
        :table (dotable x recur)
        x))
    ret))

(defn freeze
  """
  Freezes an object (make it immutable) and do a deep copy, making
  child values also immutable. Closures, fibers, and abstract types
  will not be recursively frozen, but all other types will.
  """
  [x]
  (def tx (type x))
  (cond
    ; An array's immutable counterpart is a vector, as a table's is a map and
    ; a buffer's is a string. A tuple is already immutable and stays one.
    (or (= tx :array) (= tx :vector))
    (vec (map freeze x))

    (= tx :tuple)
    (tuple/slice (map freeze x))

    (or (= tx :table) (= tx :map))
    (let [temp-tab !{}]
      ; Handle multiple unique keys that freeze. Result should
      ; be independent of iteration order.
      (each [k v] x
        (def kk (freeze k))
        (def vv (freeze v))
        (def old (get temp-tab kk))
        (def new (if (= nil old) vv (max vv old)))
        (put! temp-tab kk new))
      (table/to-map temp-tab))

    (= tx :buffer)
    (string x)

    x))

(defn deep-not=
  """
  Like ^not=, but mutable types (arrays, tables, buffers) are considered
  equal if they have identical structure. Much slower than ^not=.
  """
  [x y]
  (def tx (type x))
  (or
    (not= tx (type y))
    (cond
      (or (= tx :tuple) (= tx :array) (= tx :vector))
      (or (not= (length x) (length y))
          (do
            (var ret false)
            (forv i 0 (length x)
              (def xx (in x i))
              (def yy (in y i))
              (if (deep-not= xx yy)
                (break (set ret true))))
            ret))
      (or (= tx :map) (= tx :table))
      (or (not= (length x) (length y))
          (do
            (def rawget (if (= tx :map) get table/rawget))
            (var ret false)
            (each [k v] x
              (if (deep-not= (rawget y k) v) (break (set ret true))))
            ret))
      (= tx :buffer) (not= 0 (- (length x) (length y)) (memcmp x y))
      (not= x y))))

(defn deep=
  """
  Like ^=, but mutable types (arrays, tables, buffers) are considered
  equal if they have identical structure. Much slower than ^=.
  """
  [x y]
  (not (deep-not= x y)))

(defn macex
  """
  Expands macros completely.
  on-binding is an optional callback for whenever a normal symbolic binding
  is encountered. This allows macros to easily see all bindings used by their
  arguments by calling ^macex on their contents. The binding itself is also
  replaced by the value returned by on-binding within the expanded macro.
  """
  ([x] (macex x nil))
  ([x on-binding]
    (var previous x)
    (var current (macex1 x on-binding))
    (var counter 0)
    (while (deep-not= current previous)
      (if (> (++ counter) 200)
        (error "macro expansion too nested"))
      (set previous current)
      (set current (macex1 current on-binding)))
    current))

(set macexvar macex)

(defmacro varfn :flycheck
  """
  Creates a function that can be rebound. ^varfn has the same signature
  as ^defn, but defines functions in the environment as vars. If a var name
  already exists in the environment, it is rebound to the new function. Returns
  a function.
  """
  [name & body]
  (def expansion (apply defn name body))
  (def fbody (last expansion))
  (def modifiers (tuple/slice expansion 2 -2))
  (def metadata !{})
  (each m modifiers
    (cond
      (keyword? m) (put! metadata m true)
      (string? m) (put! metadata :doc m)
      (dictionary? m) (merge! metadata m)
      (error (string "invalid metadata " m))))
  (with-syms [entry old-entry f]
    `(as-macro ~let [~old-entry (~dyn '~name)]
       (def ~entry (as-macro ~or ~old-entry !{:ref ![nil]}))
       (~setdyn '~name ~entry)
       (def ~f ~fbody)
       (~put-in! ~entry [:ref 0] ~f)
       (~merge! ~entry '~metadata)
       ~f)))

;;;
;;;
;;; Function shorthand
;;;
;;;

(def- max-shortfn-params 9999) ; Less than 0xFFFF so we have enough registers for internal use
(defmacro short-fn
  """
  Shorthand for `fn`. Arguments are given as `$n`, where `n` is the
  0-indexed argument of the function. `$` is also an alias for the
  first (index 0) argument. The `$&` symbol will make the anonymous
  function variadic if it appears in the body of the function, and
  can be combined with positional arguments.
  """
  ([arg] (def self short-fn) (self arg nil))
  ([arg name]
    (var max-param-seen -1)
    (var vararg false)
    (defn saw-special-arg
      [num]
      (set max-param-seen (max max-param-seen num)))
    (def prefix (gensym))
    (defn on-binding
      [x]
      (if (string/has-prefix? '$ x)
        (cond
          (= '$ x)
          (do
            (saw-special-arg 0)
            (symbol prefix '$0))
          (= '$& x)
          (do
            (set vararg true)
            (symbol prefix x))
          :else
          (do
            (def num (scan-number (string/slice x 1)))
            (if num
              (do
                (assertf (nat? num) "expected indexed parameter, got %s" x)
                (assertf (<= num max-shortfn-params) "too many short-fn parameters (%s)" x)
                (saw-special-arg num)
                (symbol prefix x))
              x)))
        x))
    (def expanded (macex arg on-binding))
    (def name-splice (if name [name] [:short-fn]))
    (def fn-args (seq [i :range [0 (+ 1 max-param-seen)]] (symbol prefix '$ i)))
    `(fn ~|name-splice
       [~|fn-args ~|(if vararg (tuple '& (symbol prefix '$&)) [])]
       ~expanded)))

;;;
;;;
;;; Default PEG patterns
;;;
;;;

(defdyn *peg-grammar*
  """
  The implicit base grammar used when compiling PEGs. Any undefined keywords
  found when compiling a peg will use lookup in this table (if defined).
  """)

(def default-peg-grammar
  """
  The default grammar used for pegs. This grammar defines several common patterns
  that should make it easier to write more complex patterns.
  """
  `!{:a (range "az" "AZ")
     :d (range "09")
     :h (range "09" "af" "AF")
     :s (set " \t\r\n\0\f\v")
     :w (range "az" "AZ" "09")
     :A (if-not :a 1)
     :D (if-not :d 1)
     :H (if-not :h 1)
     :S (if-not :s 1)
     :W (if-not :w 1)
     :a+ (some :a)
     :d+ (some :d)
     :h+ (some :h)
     :s+ (some :s)
     :w+ (some :w)
     :A+ (some :A)
     :D+ (some :D)
     :H+ (some :H)
     :S+ (some :S)
     :W+ (some :W)
     :a* (any :a)
     :d* (any :d)
     :h* (any :h)
     :s* (any :s)
     :w* (any :w)
     :A* (any :A)
     :D* (any :D)
     :H* (any :H)
     :S* (any :S)
     :W* (any :W)})

(setdyn *peg-grammar* default-peg-grammar)

;;;
;;;
;;; Evaluation and Compilation
;;;
;;;

(defdyn *prefix*
  "Path of directory to load system modules from.")

(defn make-env
  """
  Creates a new environment table. The new environment
  will inherit bindings from the parent environment, but new
  bindings will not pollute the parent environment.
  """
  ([] (make-env nil))
  ([parent]
    (def parent (if parent parent root-env))
    (def newenv (table/setproto! !{} parent))
    newenv))

(defdyn *err-color*
  "Whether or not to turn on error coloring in stacktraces and other error messages.")

(defn bad-parse
  "Default handler for a parse error."
  [p where]
  (def ec (dyn *err-color*))
  (def [line col] (:where p))
  (eprint
    (if ec "\e[31m" "")
    where
    ":"
    line
    ":"
    col
    ": parse error: "
    (:error p)
    (if ec "\e[0m"))
  (eflush))

(defn warn-compile
  "Default handler for a compile warning."
  ([msg level where] (warn-compile msg level where nil nil))
  ([msg level where line] (warn-compile msg level where line nil))
  ([msg level where line col]
    (def ec (dyn *err-color*))
    (eprin
      (if ec "\e[33m" "")
      where
      ":"
      line
      ":"
      col
      ": compile warning (" level "): ")
    (eprint msg (if ec "\e[0m"))
    (eflush)))

(defn bad-compile
  "Default handler for a compile error."
  ([msg macrof where] (bad-compile msg macrof where nil nil))
  ([msg macrof where line] (bad-compile msg macrof where line nil))
  ([msg macrof where line col]
    (def ec (dyn *err-color*))
    (eprin
      (if ec "\e[31m" "")
      where
      ":"
      line
      ":"
      col
      ": compile error: ")
    (if macrof
      (debug/stacktrace macrof msg "")
      (eprint msg (if ec "\e[0m")))
    (eflush)))

(defn curenv
  """
  Gets the current environment table. Same as `(fiber/getenv (fiber/current))`. If n
  is provided, gets the nth prototype of the environment table.
  """
  ([] (curenv nil))
  ([n]
    (var e (fiber/getenv (fiber/current)))
    (if n (repeat n (if (= nil e) (break)) (set e (table/getproto e))))
    e))

(def- lint-levels
  {:none 0
   :relaxed 1
   :normal 2
   :strict 3
   :all math/inf})

(defn run-context
  """
  Runs a context. This evaluates expressions in an environment,
  and encapsulates the parsing, compilation, and evaluation.
  Returns `(in environment :exit-value environment)` when complete.
  opts is a table or map of options. The options are as follows:

    * `:chunks` -- callback to read into a buffer - default is getline

    * `:on-parse-error` -- callback when parsing fails - default is bad-parse

    * `:env` -- the environment to compile against - default is the current env

    * `:source` -- source path for better errors (use keywords for non-paths) - default
      is `:<anonymous>`

    * `:on-compile-error` -- callback when compilation fails - default is bad-compile

    * `:on-compile-warning` -- callback for any linting error - default is warn-compile

    * `:evaluator` -- callback that executes thunks. Signature is (evaluator thunk source
      env where)

    * `:on-status` -- callback when a value is evaluated - default is debug/stacktrace.

    * `:fiber-flags` -- what flags to wrap the compilation fiber with. Default is :ia.

    * `:expander` -- an optional function that is called on each top level form before
      being compiled.

    * `:parser` -- provides a custom parser that implements the same interface as Wattle's
      built-in parser.

    * `:read` -- optional function to get the next form, called like `(read env source)`.
      Overrides all parsing.
  """
  [opts]

  (def {env :env
        chunks :chunks
        onstatus :on-status
        on-compile-error :on-compile-error
        on-compile-warning :on-compile-warning
        on-parse-error :on-parse-error
        guard :fiber-flags
        evaluator :evaluator
        default-where :source
        parser :parser
        read :read
        expand :expander} opts)
  (default env (or (fiber/getenv (fiber/current)) !{}))
  (default chunks (fn chunks [buf p] (getline "" buf env)))
  (default onstatus debug/stacktrace)
  (default on-compile-error bad-compile)
  (default on-compile-warning warn-compile)
  (default on-parse-error bad-parse)
  (default evaluator (fn evaluate [x &] (x)))
  (default default-where :<anonymous>)
  (default guard :ydt)

  (var where default-where)

  (if (string? where)
    (put! env *current-file* where))

  ; Evaluate 1 source form in a protected manner
  (def lints ![])
  (defn eval1 ([source] (eval1 source nil nil))
    ([source l] (eval1 source l nil))
    ([source l c]
      (def source (if expand (expand source) source))
      (var good true)
      (var resumeval nil)
      (def f
        (fiber/new
          (fn :compile-and-lint []
            (array/clear! lints)
            (def res (compile source env where lints))
            (when (next lints)
              ; Convert lint levels to numbers.
              (def levels (get env *lint-levels* lint-levels))
              (def lint-error (get env *lint-error*))
              (def lint-warning (get env *lint-warn*))
              (def lint-error (or (get levels lint-error lint-error) 0))
              (def lint-warning (or (get levels lint-warning lint-warning) 2))
              (each [level line col msg] (distinct lints) ; some macros might cause code to be duplicated. Avoid repeated messages.
                (def lvl (get lint-levels level 0))
                (cond
                  (<= lvl lint-error) (do
                                        (set good false)
                                        (on-compile-error msg nil where (or line l) (or col c)))
                  (<= lvl lint-warning) (on-compile-warning msg level where (or line l) (or col c)))))
            (when good
              (if (= (type res) :function)
                (evaluator res source env where)
                (do
                  (set good false)
                  (def {err :error line :line column :column errf :fiber} res)
                  (on-compile-error err errf where (or line l) (or column c))))))
          guard
          env))
      (while (fiber/can-resume? f)
        (def res (resume f resumeval))
        (when good (set resumeval (onstatus f res))))))

  ; Reader version
  (when read
    (forever
      (if (in env :exit) (break))
      (eval1 (read env where)))
    (break (in env :exit-value env)))

  ; The parser object
  (def p (or parser (parser/new)))
  (def p-consume (p :consume))
  (def p-produce (p :produce))
  (def p-status (p :status))
  (def p-has-more (p :has-more))

  (defn parse-err
    "Handles parser error in the correct environment"
    [p where]
    (def f (coro (on-parse-error p where)))
    (fiber/setenv f env)
    (resume f))

  (defn produce []
    (def tup (p-produce p true))
    [(in tup 0) |(tuple/sourcemap tup)])

  ; Loop
  (def buf !"")
  (var parser-not-done true)
  (while parser-not-done
    (if (env :exit) (break))
    (buffer/clear! buf)
    (match (chunks buf p)
      :cancel
      (do
        ; A :cancel chunk represents a cancelled form in the REPL, so reset.
        (:flush p)
        (buffer/clear! buf))

      [:source new-where]
      (do
        (set where new-where)
        (if (string? new-where)
          (put! env *current-file* new-where)))

      (do
        (var pindex 0)
        (def len (length buf))
        (when (= len 0)
          (:eof p)
          (set parser-not-done false))
        (while (> len pindex)
          (+= pindex (p-consume p buf pindex))
          (while (p-has-more p)
            (eval1 |(produce))
            (if (env :exit) (break)))
          (when (= (p-status p) :error)
            (parse-err p where)
            (if (env :exit) (break)))))))

  ; Check final parser state
  (unless (env :exit)
    (while (p-has-more p)
      (eval1 |(produce))
      (if (env :exit) (break)))
    (when (= (p-status p) :error)
      (parse-err p where)))

  (put! env :exit nil)
  (in env :exit-value env))

(defn quit
  """
  Tries to exit from the current repl or run-context. Does not always exit the application.
  Works by setting the :exit dynamic binding to true. Passing a non-nil value here will cause the outer
  run-context to return that value.
  """
  ([] (quit nil))
  ([val]
    (setdyn :exit true)
    (setdyn :exit-value val)
    nil))

(defn eval
  """
  Evaluates a form in the current environment. If more control over the
  environment is needed, use ^run-context. Optionally takes an env table with available bindings.
  """
  ([form] (eval form nil))
  ([form env]
    (def res (compile form env :eval))
    (if (= (type res) :function)
      (res)
      (error (get res :error)))))

(defn parse
  """
  Parses a string and returns the first value. For complex parsing, such as for a repl with error handling,
  use the parser api.
  """
  [str]
  (let [p (parser/new)]
    (parser/consume p str)
    (if (= :error (parser/status p))
      (error (parser/error p)))
    (parser/eof p)
    (if (parser/has-more p)
      (parser/produce p)
      (if (= :error (parser/status p))
        (error (parser/error p))
        (error "no value")))))

(defn parse-all
  """
  Parses a string and returns all parsed values. For complex parsing, such as for a repl with error handling,
  use the parser api.
  """
  [str]
  (let [p (parser/new)
        ret ![]]
    (parser/consume p str)
    (if (= :error (parser/status p))
      (error (parser/error p)))
    (parser/eof p)
    (while (parser/has-more p)
      (array/push! ret (parser/produce p)))
    (if (= :error (parser/status p))
      (error (parser/error p))
      ret)))

(defn eval-string
  """
  Evaluates a string in the current environment. If more control over the
  environment is needed, use ^run-context. Optionally takes an env table with available bindings.
  """
  ([str] (eval-string str nil))
  ([str env]
    (var ret nil)
    (each x (parse-all str) (set ret (eval x env)))
    ret))

(def load-image-dict
  """
  A table used in combination with ^unmarshal to unmarshal byte sequences created
  by ^make-image, such that `(load-image bytes)` is the same as `(unmarshal bytes load-image-dict)`.
  """
  !{})

(def make-image-dict
  """
  A table used in combination with ^marshal to marshal code (images), such that
  `(make-image x)` is the same as `(marshal x make-image-dict)`.
  """
  !{})

(defmacro comptime
  "Evals x at compile time and returns the result. Similar to a top level unquote."
  [x]
  (def y (eval x))
  y)

(defmacro compif
  "Checks test at compile time -- if truthy, compiles then, otherwise compiles else."
  ([test then] (def self compif) (self test then nil))
  ([test then else]
    (if (eval test)
      then
      else)))

(defmacro compwhen
  "Checks test at compile time -- if truthy, compiles `(upscope |body)`, otherwise compiles nil."
  [test & body]
  (if (eval test)
    `(upscope ~|body)))

(defn make-image
  """
  Creates an image from an environment returned by ^require.
  Returns the image source as a string.
  """
  [env]
  (marshal env make-image-dict))

(defn load-image
  "The inverse operation to ^make-image. Returns an environment."
  [image]
  (unmarshal image load-image-dict))

(defn- check-dyn-relative [x] (if (string/has-prefix? "@" x) x))
(defn- check-relative [x] (if (string/has-prefix? "." x) x))
; Don't try to preload absolute or relative paths
(defn- check-preloadable [x] (unless (or (string/has-prefix? "/" x) (string/find "." x) (string/find "@" x)) x))
(defn- check-is-dep [x] (unless (or (string/has-prefix? "/" x) (string/has-prefix? "@" x) (string/has-prefix? "." x)) x))
(defn- check-project-relative [x] (if (string/has-prefix? "/" x) x))

(defdyn *module-cache* "Dynamic binding for overriding ^module/cache")
(defdyn *module-paths* "Dynamic binding for overriding ^module/paths")
(defdyn *module-loading* "Dynamic binding for overriding ^module/loading")
(defdyn *module-loaders* "Dynamic binding for overriding ^module/loaders")
(defdyn *module-make-env* "Dynamic binding for creating new environments for ^import, ^require, and ^dofile. Overrides ^make-env.")

(def module/cache
  "A table, mapping loaded module identifiers to their environments."
  !{})

(def module/paths
  """
  The list of paths to look for modules, templated for ^module/expand-path.
  Each element is a two-element tuple, containing the path
  template and a keyword :source, :native, or :image indicating how
  ^require should load files found at these paths.

  A tuple can also
  contain a third element, specifying a filter that prevents ^module/find
  from searching that path template if the filter doesn't match the input
  path. The filter can be a string or a predicate function, and
  is often a file extension, including the period.
  """
  ![])

(defn module/add-paths
  """
  Adds paths to ^module/paths for a given loader such that
  the generated paths behave like other module types, including
  relative imports and prefix imports. ext is the file extension
  to associate with this module type, including the dot. loader is the
  keyword name of a loader in ^module/loaders. Returns the modified ^module/paths.
  """
  [ext loader]
  (def mp (dyn *module-paths* module/paths))
  (defn find-prefix
    [pre]
    (or (find-index #(and (string? ($ 0)) (string/has-prefix? pre ($ 0))) mp) 0))
  (def dyn-index (find-prefix ":@all:"))
  (array/insert! mp dyn-index [(string ":@all:" ext) loader check-dyn-relative])
  (def all-index (find-prefix ".:all:"))
  (array/insert! mp all-index [(string ".:all:" ext) loader check-project-relative])
  (def prefix-index (find-prefix ":prefix:"))
  (array/insert! mp prefix-index [(string ":prefix:/:all:" ext) loader check-is-dep])
  (def curall-index (find-prefix ":cur:/:all:"))
  (array/insert! mp curall-index [(string ":cur:/:all:" ext) loader check-relative])
  mp)

(defn module/add-file-extension
  """
  Adds paths to ^module/paths for a given file extension such that
  the programmer can import a module by relative or absolute path from
  the current working directory.
  Returns the modified ^module/paths.
  """
  [ext loader]
  (assert (string/has-prefix? "." ext) "file extension must have . prefix")
  (def mp (dyn *module-paths* module/paths))
  (array/insert! mp 0 [":all:" loader (fn :check-ext [x] (string/has-suffix? ext x))])
  mp)

(defn module/add-native
  """
  Adds the environment env of a native module to ^module/cache under
  name, so that `(import name)` finds it without a file. Each nfunction
  and abstract value bound in env is also added to ^make-image-dict and
  ^load-image-dict under the symbol `name/sym`, so that an image made with
  the module imported names those values rather than failing to marshal
  them, and loads wherever the same module is added under the same name.
  Returns env.
  """
  [name env]
  (put! (dyn *module-cache* module/cache) name env)
  (each [sym entry] env
    (when (and (symbol? sym) (table? entry))
      (def v (get entry :value))
      (when (or (nfunction? v) (abstract? v))
        (def key (symbol name "/" sym))
        (put! make-image-dict v key)
        (put! load-image-dict key v))))
  env)

; Don't expose this externally yet - could break if custom module/paths is setup.
(defn module/add-prefix
  """
  Adds a custom prefix to ^module/paths by duplicating all entries that begin with `:prefix:` and
  adding duplicates with the lib/wattle directory of path as the prefix instead.
  """
  [path]
  (def copies ![])
  (var last-index 0)
  (def mp (dyn *module-paths* module/paths))
  (loop [[index entry] :pairs mp]
    (def pattern (first entry))
    (when (and (string? pattern) (string/has-prefix? ":prefix:/" pattern))
      (set last-index index)
      (array/push! copies [(string/replace ":prefix:" (string path "/lib/wattle") pattern) |(slice entry 1)])))
  (array/insert! mp (+ 1 last-index) |copies)
  mp)

(module/add-paths ":native:" :native)
(module/add-paths "/init.wattle" :source)
(module/add-paths ".wattle" :source)
(module/add-paths ".wimage" :image)
(module/add-file-extension ".wattle" :source)
(module/add-file-extension ".wimage" :image)
; These obviously won't work on all platforms, but if a user explicitly
; tries to import them, we may as well try. `.dylib` is what macOS names a
; shared object.
(module/add-file-extension ".so" :native)
(module/add-file-extension ".dll" :native)
(module/add-file-extension ".dylib" :native)
(array/insert! module/paths 0
              [(fn is-cached [path] (if (in (dyn *module-cache* module/cache) path) path))
               :preload
               check-preloadable])

; Version of fexists that works even with a reduced OS
(defn- fexists
  [path]
  (compif (dyn 'os/stat)
    (= :file (os/stat path :mode))
    (when-let [f (file/open path :rb)]
      (def res
        (try (do (file/read f 1) true)
          ([err] nil)))
      (file/close f)
      res)))

(defn- mod-filter
  [x path]
  (case (type x)
    :nil path
    :string (string/has-suffix? x path)
    (x path)))

(defn module/find
  """
  Tries to match a module or path name from the patterns in ^module/paths.
  Returns a tuple (fullpath kind) where the kind is one of :source, :native,
  or :image if the module is found, otherwise a tuple with nil followed by
  an error message.
  """
  ([path] (module/find path nil))
  ([path find-all]
    (var ret nil)
    (def mp (dyn *module-paths* module/paths))
    (def all-matches (if find-all ![]))
    (each [p mod-kind checker] mp
      (when (mod-filter checker path)
        (if (function? p)
          (when-let [res (p path)]
            (set ret [res mod-kind])
            (if find-all (array/push! all-matches ret) (break)))
          (when-let [expanded (module/expand-path path p)]
            (def fullpath (string expanded))
            (when (fexists fullpath)
              (set ret [fullpath mod-kind])
              (if find-all (array/push! all-matches ret) (break)))))))
    (if find-all (break all-matches))
    (or ret
      (let [expander (fn :expander [[t _ chk]]
                       (when (string? t)
                         (when (mod-filter chk path)
                           (module/expand-path path t))))
            paths (filter identity (map expander mp))
            str-parts (interpose "\n    " paths)]
        [nil (string "could not find module " path ":\n    " |str-parts)]))))

(def module/loading
  """
  A table, mapping currently loading modules to true. Used to prevent
  circular dependencies.
  """
  !{})

(defn module/value
  """
  Given a module table, get the value bound to a symbol sym. If private is
  truthy, will also resolve private module symbols. If no binding is found, will return
  nil.
  """
  ([module sym] (module/value module sym nil))
  ([module sym private]
    (def entry (get module sym))
    (if entry
      (let [v (in entry :value)
            r (in entry :ref)
            p (in entry :private)]
        (when (and p (not private)) (break))
        (if (and r (array? r))
          (get r 0)
          v)))))

(def debugger-env
  "An environment that contains dot prefixed functions for debugging."
  !{})

(var- debugger-on-status-var nil)

(defn debugger
  "Runs a repl-based debugger on a fiber. An optional level differentiates nested debuggers."
  ([fib] (debugger fib 1))
  ([fib level]
    (def nextenv (make-env (fiber/getenv fib)))
    (put! nextenv :fiber fib)
    (put! nextenv :debug-level level)
    (put! nextenv :signal (fiber/last-value fib))

    (merge! nextenv debugger-env)
    (defn debugger-chunks [buf p]
      (def status (:state p :delimiters))
      (def c ((:where p) 0))
      (def prpt (string "debug[" level "]:" c ":" status "> "))
      (getline prpt buf nextenv))
    (eprint "entering debug[" level "] - (quit) to exit")
    (flush)
    (run-context
      {:chunks debugger-chunks
       :on-status (debugger-on-status-var nextenv (+ 1 level) true)
       :env nextenv})
    (eprint "exiting debug[" level "]")
    (flush)
    (nextenv :resume-value)))

(defn debugger-on-status
  "Creates a function that can be passed to ^run-context's `:on-status` argument that will drop into a debugger on errors. The debugger will only start on abnormal signals if the env table has the `:debug` dyn set to a truthy value."
  ([env] (debugger-on-status env 1 nil))
  ([env level] (debugger-on-status env level nil))
  ([env level is-repl]
    (fn :debugger [f x]
      (def fs (fiber/status f))
      (if (= :dead fs)
        (when is-repl
          (put! env '_ !{:value x})
          (def pf (get env *pretty-format* "%q"))
          (try
            (printf pf x)
            ([e]
              (eprintf "bad pretty format %v: %v" pf e)
              (eflush)))
          (flush))
        (do
          (debug/stacktrace f x "")
          (eflush)
          (if (get env :debug) (debugger f level)))))))

(set debugger-on-status-var debugger-on-status)

(defn dofile
  """
  Evaluates a file, file path, or stream and return the resulting environment. :env, :expander,
  :source, :evaluator, :read, and :parser are passed through to the underlying
  ^run-context call. If exit is true, any top level errors will trigger a
  call to `(os/exit 1)` after printing the error.
  """
  [path & {:keys [exit env source expander evaluator read parser]}]
  (def f (case (type path)
           :core/file path
           :core/stream path
           (file/open path :rb)))
  (def path-is-file (= f path))
  (default env ((dyn *module-make-env* make-env)))
  (def spath (string path))
  (put! env :source (or source (if-not path-is-file spath path)))
  (var exit-error nil)
  (var exit-fiber nil)
  (defn chunks [buf _] (:read f 4096 buf))
  (defn bp [x y]
    (when exit
      (bad-parse x y)
      (os/exit 1))
    (put! env :exit true)
    (def buf !"")
    (with-dyns [*err* buf]
      (bad-parse x y))
    (set exit-error (string/slice buf 0 -2)))
  (defn bc [x y z a b]
    (when exit
      (bad-compile x y z a b)
      (os/exit 1))
    (put! env :exit true)
    (def buf !"")
    (with-dyns [*err* buf]
      (bad-compile x nil z a b))
    (set exit-error (string/slice buf 0 -2))
    (set exit-fiber y))
  (unless f
    (error (string "could not find file " path)))
  (def nenv
    (run-context {:env env
                  :chunks chunks
                  :on-parse-error bp
                  :on-compile-error bc
                  :on-status (fn [f x]
                               (when (not= (fiber/status f) :dead)
                                 (when exit
                                   (debug/stacktrace f x "")
                                   (eflush)
                                   (os/exit 1))
                                 (if (get env :debug)
                                   ((debugger-on-status env) f x)
                                   (do
                                     (put! env :exit true)
                                     (set exit-error x)
                                     (set exit-fiber f)))))
                  :evaluator evaluator
                  :expander expander
                  :read read
                  :parser parser
                  :source (or source (if path-is-file :<anonymous> spath))}))
  (if-not path-is-file (:close f))
  (when exit-error
    (if exit-fiber
      (propagate exit-error exit-fiber)
      (error exit-error)))
  nenv)

(def module/loaders
  """
  A table of loading method names to loading functions.
  This table lets ^require and ^import load many different kinds
  of files as modules.
  """
  !{:native (fn native-loader [path &] (native path ((dyn *module-make-env* make-env))))
    :source (fn source-loader [path args]
              (def ml (dyn *module-loading* module/loading))
              (put! ml path true)
              (defer (put! ml path nil)
                (dofile path |args)))
    :preload (fn preload-loader [path & args]
               (def mc (dyn *module-cache* module/cache))
               (when-let [m (in mc path)]
                 (if (function? m)
                   (set (mc path) (m path |args))
                   m)))
    :image (fn image-loader [path &] (load-image (slurp path)))})

(defn- require-1
  [path args kargs]
  (def [fullpath mod-kind]
    (if-let [loader (get kargs :loader)]
      [path loader]
      (module/find path)))
  (unless fullpath (error mod-kind))
  (def mc (dyn *module-cache* module/cache))
  (def ml (dyn *module-loading* module/loading))
  (def mls (dyn *module-loaders* module/loaders))
  (if-let [check (if-not (get kargs :fresh) (in mc fullpath))]
    check
    (if (get ml fullpath)
      (error (string "circular dependency " fullpath " detected"))
      (do
        (def loader (if (keyword? mod-kind) (get mls mod-kind) mod-kind))
        (unless loader (error (string "module type " mod-kind " unknown")))
        (def env (loader fullpath args))
        (put! mc fullpath env)
        env))))

(defn require
  """
  Requires a module with the given name. Will search all of the paths in
  ^module/paths. Returns the new environment
  returned from compiling and running the file.
  """
  [path & args]
  (require-1 path args (hash-map |args)))

(defn merge-module
  """
  Merges a module source into the target environment with a prefix, as with the ^import macro.
  This lets users emulate the behavior of ^import with a custom module table.
  If export is truthy, then merged functions are not marked as private. Returns
  the modified target environment. If a tuple or array only is passed, only merge keys in only.
  """
  ([target source] (merge-module target source nil nil nil))
  ([target source prefix] (merge-module target source prefix nil nil))
  ([target source prefix export] (merge-module target source prefix export nil))
  ([target source prefix export only]
    (def only-set (if only (invert only)))
    (loop [[k v] :pairs source :when (symbol? k) :when (not (v :private)) :when (or (not only) (in only-set k))]
      (def newv (table/setproto! !{:private (not export)} v))
      (put! target (symbol prefix k) newv))
    target))

(defn import*
  """
  Function form of ^import. Same parameters, but the path
  and other symbol parameters should be strings instead.
  """
  [path & args]
  (def env (curenv))
  (def kargs (table |args))
  (def {as :as
        prefix :prefix
        ep :export
        only :only} kargs)
  (def newenv (require-1 path args kargs))
  (def prefix (or
                (and as (string as "/"))
                prefix
                (string (first (string/split "." (last (string/split "/" path)))) "/")))
  (merge-module env newenv prefix ep only))

(defmacro import
  """
  Imports a module. First requires the module, and then merges its
  symbols into the current environment, prepending a given prefix as needed.
  (use the :as or :prefix option to set a prefix). If no prefix is provided,
  uses the name of the module as a prefix. One can also use "`:export true`"
  to re-export the imported symbols. If "`:exit true`" is given as an argument,
  any errors encountered at the top level in the module will cause `(os/exit 1)`
  to be called. Dynamic bindings will NOT be imported. Use :fresh with a truthy
  value to bypass the module cache. Use `:only [foo bar baz]` to only import
  select bindings into the current environment.
  """
  [path & args]
  (assertf (even? (length args)) "args should have even length: %n" args)
  (def ps (partition 2 args))
  (def argm
    (mapcat (fn [[k v]]
              (assertf (keyword? k) "expected keyword, got %s: %n" (type k) k)
              [k (case k :as (string v) :only `(quote ~v) v)])
            ps))
  (tuple import* (string path) |argm))

(defmacro use
  """
  Similar to ^import, but imported bindings are not prefixed with a module
  identifier. Can also import multiple modules in one shot.
  """
  [& modules]
  `(do ~|(map (short-fn `(~import* ~(string $) :prefix "")) modules)))

;;;
;;;
;;; Documentation
;;;
;;;

(defn- env-walk
  [pred env local]
  (def envs ![])
  (do (var e env) (while e (array/push! envs e) (set e (table/getproto e)) (if local (break))))
  (def ret-set !{})
  (loop [envi :in envs
         k :keys envi
         :when (pred k)]
    (put! ret-set k true))
  (sort! (keys ret-set)))

(defn all-bindings
  """
  Gets all symbols available in an environment. Defaults to the current
  fiber's environment. If local is truthy, will not show inherited bindings
  (from prototype tables).
  """
  ([] (all-bindings (fiber/getenv (fiber/current)) nil))
  ([env] (all-bindings env nil))
  ([env local]
    (env-walk symbol? env local)))

(defn all-dynamics
  """
  Gets all dynamic bindings in an environment. Defaults to the current
  fiber's environment. If local is truthy, will not show inherited bindings
  (from prototype tables).
  """
  ([] (all-dynamics (fiber/getenv (fiber/current)) nil))
  ([env] (all-dynamics env nil))
  ([env local]
    (env-walk keyword? env local)))

(defdyn *doc-width*
  "Width in columns to print documentation printed with ^doc-format.")

(defdyn *doc-color*
  "Whether or not to colorize documentation printed with ^doc-format.")

(defn doc-format
  """
  Reformats a docstring to wrap a certain width. Docstrings can either be plaintext
  or a subset of markdown. This allows a long single line of prose or formatted text to be
  a well-formed docstring. Backticks enclose raw code, and a word written `^name` refers to a
  binding. A table is a header row, a delimiter row and body rows, each beginning with `|`; it is
  drawn with a centred header row and rules under the header and between rows. With color on,
  each word in str equal to an element of args, a sequence of argument names, is yellow.
  Returns a buffer containing the formatted text.
  """
  ([str] (doc-format str nil 4 nil nil))
  ([str width] (doc-format str width 4 nil nil))
  ([str width indent] (doc-format str width indent nil nil))
  ([str width indent colorize] (doc-format str width indent colorize nil))
  ([str width indent colorize args]

    (def max-width (- (or width (dyn *doc-width* 80)) 8))
    (def has-color (if (not= nil colorize)
                     colorize
                     (dyn *doc-color*)))

    ; Terminal codes for emission/tokenization
    (def delimiters
      (if has-color
        {:code ["\e[38;5;245m" "\e[39m"]
         :italics ["\e[3m" "\e[23m"]
         :bold ["\e[1m" "\e[22m"]
         :ref ["\e[36m" "\e[39m"]
         :arg ["\e[33m" "\e[39m"]}
        {:code ["`" "`"]
         :italics ["*" "*"]
         :bold ["**" "**"]
         :ref ["" ""]
         :arg ["" ""]}))
    ; The rules and dividers of a table
    (def chrome (if has-color ["\e[90m" "\e[39m"] ["" ""]))
    (defn paint [text] (string (get chrome 0) text (get chrome 1)))
    (def argset
      (when args
        (def set !{})
        (each a args (put! set a true))
        set))
    (def modes !{})
    (defn toggle-mode [mode]
      (def active (get modes mode))
      (def delims (get delimiters mode))
      (put! modes mode (not active))
      (delims (if active 1 0)))

    ; Parse state
    (var cursor 0) ; indexes into string for parsing
    (var stack ![]) ; return value for this block.

    ; Traversal helpers
    (defn c [] (get str cursor))
    (defn cn [n] (get str (+ n cursor)))
    (defn c++ [] (let [ret (get str cursor)] (++ cursor) ret))
    (defn c+=n [n] (let [ret (get str cursor)] (+= cursor n) ret))
    ; skip* functions return number of characters matched and advance the cursor.
    (defn skipwhite []
      (def x cursor)
      (while (= (c) (chr " ")) (++ cursor))
      (- cursor x))
    (defn skipline []
      (def x cursor)
      (while (let [y (c)] (and y (not= y (chr "\n")))) (++ cursor))
      (c++)
      (- cursor x))

    ; Detection helpers - return number of characters matched
    (defn ul? []
      (let [x (c) x1 (cn 1)]
        (and
          (= x1 (chr " "))
          (or (= x (chr "*")) (= x (chr "-")))
          2)))
    (defn ol? []
      (def old cursor)
      (while (and (>= (c) (chr "0")) (<= (c) (chr "9"))) (c++))
      (let [c1 (c) c2 (cn 1) c* cursor]
        (set cursor old)
        (if (and (= c1 (chr ".")) (= c2 (chr " ")))
          (- c* cursor -2))))
    (defn fcb? [] (if (= (chr "`") (c) (cn 1) (cn 2)) 3))
    (defn nl? [] (= (chr "\n") (c)))

    ; Parse helper
    ; parse-* functions push nodes to `stack`, and return
    ; the indentation they leave the cursor on.

    (var parse-blocks nil) ; mutual recursion
    (defn getslice [from to]
      (def to (min to (length str)))
      (string/slice str from to))
    (defn push [x] (array/push! stack x))

    (defn parse-list [bullet-check initial indent]
      (def temp-stack ![initial])
      (def old-stack stack)
      (set stack temp-stack)
      (var current-indent indent)
      (while (and (c) (>= current-indent indent))
        (def item-indent
          (when-let [x (bullet-check)]
            (c+=n x)
            (+ indent (skipwhite) x)))
        (unless item-indent
          (set current-indent (skipwhite))
          (break))
        (def item-stack ![])
        (set stack item-stack)
        (set current-indent (parse-blocks item-indent))
        (set stack temp-stack)
        (push item-stack))
      (set stack old-stack)
      (push temp-stack)
      current-indent)

    ; Table helpers. A table is a row of `|`-separated cells, a delimiter row
    ; of `-` runs and any rows that follow, each beginning with `|`.
    (defn line-end [from]
      (var i from)
      (while (let [b (get str i)] (and b (not= b (chr "\n")))) (++ i))
      i)
    ; Splits a row into cell texts. A `\|` is kept in the text for the
    ; tokenizer to unescape.
    (defn split-cells [line]
      (def cells ![])
      (def cell !"")
      (var i 0)
      (var n (length line))
      (while (= (get line i) (chr " ")) (++ i))
      (if (= (get line i) (chr "|")) (++ i))
      (while (and (> n i) (= (get line (- n 1)) (chr " "))) (-- n))
      (when (and (> n i)
                 (= (get line (- n 1)) (chr "|"))
                 (not= (get line (- n 2)) (chr """\""")))
        (-- n))
      (while (< i n)
        (def b (get line i))
        (cond
          (and (= b (chr """\""")) (= (get line (+ i 1)) (chr "|")))
          (do (buffer/push! cell b (get line (+ i 1))) (+= i 2))
          (= b (chr "|"))
          (do (array/push! cells (string/trim (string cell))) (buffer/clear! cell) (++ i))
          (do (buffer/push! cell b) (++ i))))
      (array/push! cells (string/trim (string cell)))
      cells)
    (defn delim-cell? [cell]
      (var i 0)
      (var n (length cell))
      (if (= (get cell 0) (chr ":")) (++ i))
      (if (and (> n i) (= (get cell (- n 1)) (chr ":"))) (-- n))
      (var ok (> n i))
      (for k i n (if (not= (get cell k) (chr "-")) (set ok false)))
      ok)
    (defn tbl? []
      (when (= (c) (chr "|"))
        (def e (line-end cursor))
        (when (get str e)
          (def next-start (+ e 1))
          (def next-line (getslice next-start (line-end next-start)))
          (when (string/find "|" next-line)
            (def dcells (split-cells next-line))
            (var ok (= (length dcells) (length (split-cells (getslice cursor e)))))
            (each d dcells (if (not (delim-cell? d)) (set ok false)))
            ok))))

    (defn add-codeblock [indent start end]
      (def replace-chunk (string "\n" (string/repeat " " indent)))
      (push ![:cb (string/replace-all replace-chunk "\n" (getslice start end))])
      (skipline)
      (skipwhite))

    (defn parse-fcb [indent]
      (c+=n 3)
      (skipline)
      (c+=n indent)
      (def start cursor)
      (var end cursor)
      (while (c)
        (if (fcb?) (break))
        (skipline)
        (set end cursor)
        (skipwhite))
      (add-codeblock indent start end))

    (defn parse-icb [indent]
      (var current-indent indent)
      (def start cursor)
      (var end cursor)
      (while (c)
        (skipline)
        (set end cursor)
        (set current-indent (skipwhite))
        (if (< current-indent indent) (break)))
      (add-codeblock indent start end))

    (def word-extra (let [t !{}]
                      (each b (string/bytes "-_?!<>=/+%$&:") (put! t b true))
                      t))
    (defn word-byte? [b]
      (and b
           (or (and (>= b (chr "a")) (<= b (chr "z")))
               (and (>= b (chr "A")) (<= b (chr "Z")))
               (and (>= b (chr "0")) (<= b (chr "9")))
               (> b 127)
               (get word-extra b))))
    (defn ref-byte? [b]
      (or (word-byte? b) (= b (chr "*")) (= b (chr "."))))
    ; Returns the index after the name that a `^` at `i` begins, or `i` + 1 if
    ; none does. A trailing `.` or `:` is punctuation.
    (defn ref-end [line i]
      (var j (+ i 1))
      (while (ref-byte? (get line j)) (++ j))
      (while (and (> j (+ i 1))
                  (let [b (get line (- j 1))] (or (= b (chr ".")) (= b (chr ":")))))
        (-- j))
      j)

    (defn tokenize-line [line]
      (def tokens ![])
      (def token !"")
      (def run !"")
      (var token-length 0)
      (defn delim [mode]
        (def d (toggle-mode mode))
        (if-not has-color (+= token-length (length d)))
        (buffer/push! token d))
      (defn endtoken []
        (if (first token) (array/push! tokens [(string token) token-length]))
        (buffer/clear! token)
        (set token-length 0))
      (defn flush-run []
        (when (first run)
          (def word (string run))
          (def arg? (and argset (get argset word)))
          (when arg? (delim :arg))
          (buffer/push! token word)
          (+= token-length (length word))
          (when arg? (delim :arg))
          (buffer/clear! run)))
      (var i 0)
      (var rend nil)
      (while (< i (length line))
        (def b (get line i))
        (cond
          (or (= b (chr "\n")) (= b (chr " "))) (do (flush-run) (endtoken))
          (= b (chr "`")) (do (flush-run) (delim :code))
          (modes :code) (do (++ token-length) (buffer/push! token b))
          (= b (chr """\""")) (do
                            (flush-run)
                            (++ token-length)
                            (buffer/push! token (get line (++ i))))
          (and (= b (chr "^"))
               (or (= i 0) (not (word-byte? (get line (- i 1)))))
               (do (set rend (ref-end line i)) (> rend (+ i 1))))
          (do
            (flush-run)
            (delim :ref)
            (for k (+ i 1) rend
              (++ token-length)
              (buffer/push! token (get line k)))
            (delim :ref)
            (set i (- rend 1)))
          (= b (chr "*"))
          (do
            (flush-run)
            (if (= (chr "*") (get line (+ i 1)))
              (do (++ i)
                (delim :bold))
              (delim :italics)))
          (word-byte? b) (buffer/push! run b)
          (do (flush-run) (++ token-length) (buffer/push! token b)))
        (++ i))
      (flush-run)
      (endtoken)
      (tuple/slice tokens))

    ; The header and delimiter rows, then each row that begins with `|`. A row
    ; has one cell per header cell: a missing cell is empty and an extra is
    ; dropped. Alignment in the delimiter row is not read.
    (defn parse-table [indent]
      (defn take-cells []
        (def text (getslice cursor (line-end cursor)))
        (skipline)
        (split-cells text))
      (def head (take-cells))
      (def ncols (length head))
      (take-cells)
      (defn as-row [cells]
        (def row ![])
        (for j 0 ncols (array/push! row (tokenize-line (or (get cells j) ""))))
        (tuple/slice row))
      (def header (as-row head))
      (def rows ![])
      (var current-indent (skipwhite))
      (while (and (c) (>= current-indent indent) (= (c) (chr "|")))
        (array/push! rows (as-row (take-cells)))
        (set current-indent (skipwhite)))
      (push ![:tbl header (tuple/slice rows)])
      current-indent)

    (set
      parse-blocks
      (fn parse-blocks [indent]
        (var new-indent indent)
        (var p-start nil)
        (var p-end nil)
        (defn p-line []
          (unless p-start
            (set p-start cursor))
          (skipline)
          (set p-end cursor)
          (set new-indent (skipwhite)))
        (defn finish-p []
          (when (and p-start (> p-end p-start))
            (push (tokenize-line (getslice p-start p-end)))
            (set p-start nil)))
        (while (and (c) (>= new-indent indent))
          (cond
            (nl?) (do (finish-p) (c++) (set new-indent (skipwhite)))
            (tbl?) (do (finish-p) (set new-indent (parse-table new-indent)))
            (ul?) (do (finish-p) (set new-indent (parse-list ul? :ul new-indent)))
            (ol?) (do (finish-p) (set new-indent (parse-list ol? :ol new-indent)))
            (fcb?) (do (finish-p) (set new-indent (parse-fcb new-indent)))
            (>= new-indent (+ 4 indent)) (do (finish-p) (set new-indent (parse-icb new-indent)))
            (p-line)))
        (finish-p)
        new-indent))

    (parse-blocks 0)

    ; Emission state
    (def buf !"")
    (var current-column 0)

    ; Emission
    (defn emit-indent [indent]
      (def delta (- indent current-column))
      (when (< 0 delta)
        (buffer/push! buf (string/repeat " " delta))
        (set current-column indent)))

    (defn emit-nl []
      (buffer/push! buf "\n")
      (set current-column 0))

    (defn emit-word ([word indent] (emit-word word indent (length word)))
      ([word indent len]
        (def last-byte (last buf))
        (when (and
                last-byte
                (not= last-byte (chr "\n"))
                (not= last-byte (chr " ")))
          (buffer/push! buf " ")
          (++ current-column))
        (when (and indent (> (+ 1 current-column len) max-width))
          (emit-nl)
          (emit-indent indent))
        (buffer/push! buf word)
        (+= current-column len)))

    (defn emit-code
      [code indent]
      (def replacement (string "\n" (string/repeat " " (+ 4 indent))))
      (emit-indent (+ 4 indent))
      (buffer/push! buf (string/replace-all "\n" replacement code))
      (if (= (chr "\n") (last code))
        (set current-column 0)
        (emit-nl)))

    ; Column widths start at the widest cell. While the table is wider than
    ; the space left, the widest column that can still shrink loses one
    ; column, down to its longest word. A cell wraps to its column's width.
    (defn emit-table [header rows indent]
      (def ncols (length header))
      (def widths ![])
      (def minws ![])
      (for j 0 ncols (array/push! widths 0) (array/push! minws 1))
      (each row [header |rows]
        (for j 0 ncols
          (var w 0)
          (var m 0)
          (each [_ len] (get row j) (+= w len) (set m (max m len)))
          (put! widths j (max (get widths j) (+ w (max 0 (- (length (get row j)) 1)))))
          (put! minws j (max (get minws j) m))))
      (var total (* 3 (- ncols 1)))
      (each w widths (+= total w))
      (while (> total (- max-width indent))
        (var pick nil)
        (for j 0 ncols
          (when (and (> (get widths j) (get minws j))
                     (or (= pick nil) (> (get widths j) (get widths pick))))
            (set pick j)))
        (if (= pick nil) (break))
        (put! widths pick (- (get widths pick) 1))
        (-- total))
      (defn wrap-cell [toks w]
        (def lines ![])
        (var cur ![])
        (var cur-len 0)
        (each [word len] toks
          (when (and (> (length cur) 0) (> (+ cur-len 1 len) w))
            (array/push! lines [cur cur-len])
            (set cur ![])
            (set cur-len 0))
          (set cur-len (if (> (length cur) 0) (+ cur-len 1 len) len))
          (array/push! cur word))
        (array/push! lines [cur cur-len])
        lines)
      (defn emit-line [text]
        (emit-indent indent)
        (buffer/push! buf text)
        (emit-nl))
      (defn emit-row [row centered]
        (def wrapped ![])
        (var height 1)
        (for j 0 ncols
          (def lines (wrap-cell (get row j) (get widths j)))
          (array/push! wrapped lines)
          (set height (max height (length lines))))
        (for k 0 height
          (def line !"")
          (for j 0 ncols
            (def piece (get (get wrapped j) k))
            (def gap (- (get widths j) (if piece (get piece 1) 0)))
            ; The rule under the last column begins one column before its text,
            ; so its header gives up one column of padding and sits left of centre.
            (def left (if centered
                        (brshift (if (and (> j 0) (= j (- ncols 1))) (max 0 (- gap 1)) gap) 1)
                        0))
            (buffer/push! line (string/repeat " " left))
            (buffer/push! line (if piece (string/join " " (get piece 0)) ""))
            (when (< j (- ncols 1))
              (buffer/push! line (string/repeat " " (- gap left)))
              (buffer/push! line " " (paint "|") " ")))
          (emit-line (string/trimr (string line)))))
      (defn emit-rule [ch]
        (def line !"")
        (for j 0 ncols
          (buffer/push! line (string/repeat ch (+ (get widths j)
                                                 (if (> j 0) 1 0)
                                                 (if (< j (- ncols 1)) 1 0))))
          (when (< j (- ncols 1)) (buffer/push! line "+")))
        (emit-line (paint (string line))))
      (emit-row header true)
      (when (> (length rows) 0) (emit-rule "="))
      (for i 0 (length rows)
        (emit-row (get rows i) false)
        (if (< i (- (length rows) 1)) (emit-rule "-"))))

    (defn emit-node
      [el indent]
      (emit-indent indent)
      (if (tuple? el)
        (let [rep (string "\n" (string/repeat " " indent))]
          (each [word len] el
            (emit-word
              (string/replace-all "\n" rep word)
              indent
              len))
          (emit-nl))
        (case (first el)
          :ul (for i 1 (length el)
                (if (> i 1) (emit-indent indent))
                (emit-word "- " nil)
                (each subel (get el i) (emit-node subel (+ 2 indent))))
          :ol (for i 1 (length el)
                (if (> i 1) (emit-indent indent))
                (def lab (string/format "%d. " i))
                (emit-word lab nil)
                (each subel (get el i) (emit-node subel (+ (length lab) indent))))
          :tbl (emit-table (get el 1) (get el 2) indent)
          :cb (emit-code (get el 1) indent))))

    (each el stack
      (emit-nl)
      (emit-node el indent))

    buf))

(defn- signature-args
  "Returns the argument names in a string of signatures, one signature per line."
  [sigs]
  (def names ![])
  (each line (string/split "\n" sigs)
    (var text line)
    (each c ["(" ")" "[" "]" "{" "}"]
      (set text (string/replace-all c " " text)))
    (var head true)
    (each tok (string/split " " text)
      (unless (= tok "")
        (if head
          (set head false)
          (unless (let [b (get tok 0)]
                    (or (= b (chr "&")) (= b (chr ":")) (= b (chr """\"""))))
            (array/push! names tok))))))
  names)

(defn- print-index
  "Prints bindings in the current environment given a filter function."
  [fltr]
  (def bindings (filter fltr (all-bindings)))
  (def dynamics (map describe (filter fltr (all-dynamics))))
  (print)
  (print (doc-format (string "Bindings:\n\n" (string/join " " bindings)) nil 4 false))
  (print)
  (print (doc-format (string "Dynamics:\n\n" (string/join " " dynamics)) nil 4 false))
  (print "\n    Use (doc sym) for more information on a binding.\n"))

(defn- print-module-entry
  [x]
  (def bind-type
    (string "    "
            (cond
              (x :redef) (type (in (x :ref) 0))
              (x :ref) (string :var " (" (type (in (x :ref) 0)) ")")
              (x :macro) :macro
              (x :module) (string :module " (" (x :kind) ")")
              (type (x :value)))
            "\n"))
  (def sm (x :source-map))
  (def sigs (x :sigs))
  (def d (x :doc))
  (def sigs-text
    (when sigs
      (def has-color (dyn *doc-color*))
      (string "\n"
              (when has-color "\e[94m")
              "    " (string/replace-all "\n" "\n    " sigs)
              (when has-color "\e[39m")
              "\n")))
  (print "\n\n"
         bind-type
         (when-let [[path line col] sm]
           (string "    " path (when (and line col) (string " on line " line ", column " col))))
         (when sm "\n")
         sigs-text
         (cond
           d (doc-format d nil 4 nil (when sigs (signature-args sigs)))
           (not sigs) "\n    no documentation found.\n")
         "\n"))

(defn- print-special-form-entry
  [x]
  (print "\n\n"
         "    special form\n\n"
         "    (" x " ...)\n\n"
         "    See https://janet-lang.org/docs/specials.html\n\n"))

(defn doc*
  "Gets the documentation for a symbol in a given environment. Function form of ^doc."
  ([] (doc* nil))
  ([sym]

    (cond
      (string? sym)
      (print-index (fn [x] (string/find sym x)))

      sym
      (do
        (def x (dyn sym))
        (if (not x)
          (if (index-of sym '[break def do fn if quasiquote quote
                              set splice unquote upscope var while])
            (print-special-form-entry sym)
            (do
              (def [fullpath mod-kind] (module/find (string sym)))
              (if-let [mod-env (in module/cache fullpath)]
                (print-module-entry {:module true
                                     :kind mod-kind
                                     :source-map [fullpath nil nil]
                                     :doc (in mod-env :doc)})
                (print "symbol " sym " not found."))))
          (print-module-entry x)))

      ; else
      (print-index identity))))

(defmacro doc
  """
  Shows documentation for the given symbol, or can show a list of available bindings.
  If sym is a symbol, will look for documentation for that symbol. If sym is a string
  or is not provided, will show all lexical and dynamic bindings in the current environment
  containing that string (all bindings will be shown if no string is given).
  """
  ([] (def self doc) (self nil))
  ([sym]
    `(~doc* '~sym)))

(defn doc-of
  """
  Searches all loaded modules in module/cache for a given binding and prints out its documentation.
  This does a search by value instead of by name. Returns nil.
  """
  [x]
  (var found false)
  (loop [module :in [root-env |(values module/cache)]
         [_ value] :in module]
    (let [check (or (get value :ref) (get value :value))]
      (when (= check x)
        (print-module-entry value)
        (set found true)
        (break))))
  (if-not found
    (print "documentation for value " x " not found.")))

;;;
;;;
;;; Debugger
;;;
;;;

(defn .fiber
  "Gets the current fiber being debugged."
  []
  (dyn :fiber))

(defn .signal
  "Gets the current signal being debugged."
  []
  (dyn :signal))

(defn .stack
  "Prints the current fiber stack."
  []
  (print)
  (with-dyns [*err-color* false] (debug/stacktrace (.fiber) (.signal) ""))
  (print))

(defn .frame
  "Shows a stack frame"
  ([] (.frame nil))
  ([n]
    (def stack (debug/stack (.fiber)))
    (in stack (or n 0))))

(defn .locals
  "Shows local bindings"
  ([] (.locals nil))
  ([n]
    (get (.frame n) :locals)))

(defn .fn
  "Gets the current function."
  ([] (.fn nil))
  ([n]
    (in (.frame n) :function)))

(defn .slots
  "Gets an array of slots in a stack frame."
  ([] (.slots nil))
  ([n]
    (in (.frame n) :slots)))

(defn .slot
  "Gets the value of the nth slot."
  ([] (.slot nil nil))
  ([nth] (.slot nth nil))
  ([nth frame-idx]
    (in (.slots frame-idx) (or nth 0))))

; Conditional compilation for disasm
(compwhen (dyn 'disasm)

  (defn .disasm
    "Gets the assembly for the current function."
    ([] (.disasm nil))
    ([n]
      (def frame (.frame n))
      (def func (frame :function))
      (disasm func)))

  (defn .bytecode
    "Gets the bytecode for the current function."
    ([] (.bytecode nil))
    ([n]
      ((.disasm n) :bytecode)))

  (defn .ppasm
    "Pretty prints the assembly for the current function."
    ([] (.ppasm nil))
    ([n]
      (def frame (.frame n))
      (def func (frame :function))
      (def dasm (disasm func))
      (def bytecode (in dasm :bytecode))
      (def pc (frame :pc))
      (def sourcemap (in dasm :sourcemap))
      (var last-loc [-2 -2])
      (eprint "\n  signal:     " (.signal))
      (eprint "  status:     " (fiber/status (.fiber)))
      (eprint "  function:   " (get dasm :name "<anonymous>") " [" (in dasm :source "") "]")
      (when-let [constants (dasm :constants)]
        (eprintf "  constants:  %.4q" constants))
      (eprintf "  slots:      %.4q\n" (frame :slots))
      (when-let [src-path (in dasm :source)]
        (when (and (fexists src-path)
                   sourcemap)
          (defn dump
            [src cur]
            (def offset 5)
            (def beg (max 1 (- cur offset)))
            (def lines (array/concat! ![""] (string/split "\n" src)))
            (def end (min (+ cur offset) (length lines)))
            (def digits (inc (math/floor (math/log10 end))))
            (def fmt-str (string "%" digits "d: %s"))
            (for i beg end
              (eprin " ")
              (eprin (if (= i cur) "> " "  "))
              (eprintf fmt-str i (get lines i))))
          (let [[sl _] (sourcemap pc)]
            (dump (slurp src-path) sl)
            (eprint))))
      (def padding (string/repeat " " 20))
      (loop [i :range [0 (length bytecode)]
             :let [instr (bytecode i)]]
        (eprin (if (= i pc) "> " "  "))
        (eprinf "%.20s" (string (string/join " " (map string instr)) padding))
        (when sourcemap
          (let [[sl sc] (sourcemap i)
                loc [sl sc]]
            (when (not= loc last-loc)
              (set last-loc loc)
              (eprin " # line " sl ", column " sc))))
        (eprint))
      (eprint)))

  (defn .breakall
    "Sets breakpoints on all instructions in the current function."
    ([] (.breakall nil))
    ([n]
      (def fun (.fn n))
      (def bytecode (.bytecode n))
      (forv i 0 (length bytecode)
        (debug/fbreak fun i))
      (eprint "set " (length bytecode) " breakpoints in " fun)))

  (defn .clearall
    "Clears all breakpoints on the current function."
    ([] (.clearall nil))
    ([n]
      (def fun (.fn n))
      (def bytecode (.bytecode n))
      (forv i 0 (length bytecode)
        (debug/unfbreak fun i))
      (eprint "cleared " (length bytecode) " breakpoints in " fun))))

(defn .source
  "Shows the source code for the function being debugged."
  ([] (.source nil))
  ([n]
    (def frame (.frame n))
    (def s (frame :source))
    (def all-source (slurp s))
    (eprint "\n" all-source "\n")))

(defn .break
  "Sets breakpoint at the current pc."
  []
  (def frame (.frame))
  (def fun (frame :function))
  (def pc (frame :pc))
  (debug/fbreak fun pc)
  (eprint "set breakpoint in " fun " at pc=" pc))

(defn .clear
  "Clears the current breakpoint."
  []
  (def frame (.frame))
  (def fun (frame :function))
  (def pc (frame :pc))
  (debug/unfbreak fun pc)
  (eprint "cleared breakpoint in " fun " at pc=" pc))

(defn .next
  "Goes to the next breakpoint."
  ([] (.next nil))
  ([n]
    (var res nil)
    (forv i 0 (or n 1)
      (set res (resume (.fiber))))
    res))

(defn .nextc
  "Goes to the next breakpoint, clearing the current breakpoint."
  ([] (.nextc nil))
  ([n]
    (.clear)
    (.next n)))

(defn .step
  "Executes the next n instructions."
  ([] (.step nil))
  ([n]
    (var res nil)
    (forv i 0 (or n 1)
      (set res (debug/step (.fiber))))
    res))

(def- debugger-keys (filter (partial string/has-prefix? ".") (keys root-env)))
(each k debugger-keys (put! debugger-env k (root-env k)) (put! root-env k nil))

;;;
;;;
;;; REPL
;;;
;;;

(defn repl
  """
  Runs a repl. The first parameter is an optional function to call to
  get a chunk of source code that should return nil for end of file.
  The second parameter is a function that is called when a signal is
  caught. One can provide an optional environment table to run
  the repl in, as well as an optional parser or read function to pass
  to ^run-context.
  """
  ([] (repl nil nil nil nil nil))
  ([chunks] (repl chunks nil nil nil nil))
  ([chunks onsignal] (repl chunks onsignal nil nil nil))
  ([chunks onsignal env] (repl chunks onsignal env nil nil))
  ([chunks onsignal env parser] (repl chunks onsignal env parser nil))
  ([chunks onsignal env parser read]
    (default env (make-env))
    (default chunks
      (fn :chunks [buf p]
        (def custom-prompt (get env *repl-prompt*))
        (def repl-prompt
          (if custom-prompt
            (custom-prompt p)
            (string
              "repl:"
              ((:where p) 0)
              ":"
              (:state p :delimiters) "> ")))
        (getline repl-prompt buf env)))
    (run-context {:env env
                  :chunks chunks
                  :on-status (or onsignal (debugger-on-status env 1 true))
                  :parser parser
                  :read read
                  :source :repl})))

;;;
;;;
;;; Extras
;;;
;;;

(compwhen (dyn 'ev/go)

  (defn net/close "Alias for ^ev/close." [stream] (ev/close stream))

  (defn ev/call
    """
    Calls a function asynchronously.
    Returns a task fiber that is scheduled to run the function.
    """
    [f & args]
    (ev/go (fn :call [&] (f |args))))

  (defmacro ev/spawn
    """
    Runs some code in a new task fiber. This is shorthand for
    `(ev/go (fn [] |body))`.
    """
    [& body]
    `(~ev/go (fn :spawn [&] ~|body)))

  (defmacro ev/do-thread
    """
    Runs some code in a new thread. Suspends the current fiber until the thread is complete, and
    evaluates to nil.
    """
    [& body]
    `(~ev/thread (fn :do-thread [&] ~|body)))

  (defn- acquire-release
    [acq rel lock body]
    (def l (gensym))
    `(do
       (def ~l ~lock)
       (~acq ~l)
       (defer (~rel ~l)
         ~|body)))

  (defmacro ev/with-lock
    "Runs a body of code after acquiring a lock. Will automatically release the lock when done."
    [lock & body]
    (acquire-release ev/acquire-lock ev/release-lock lock body))

  (defmacro ev/with-rlock
    "Runs a body of code after acquiring read access to an rwlock. Will automatically release the lock when done."
    [lock & body]
    (acquire-release ev/acquire-rlock ev/release-rlock lock body))

  (defmacro ev/with-wlock
    "Runs a body of code after acquiring write access to an rwlock. Will automatically release the lock when done."
    [lock & body]
    (acquire-release ev/acquire-wlock ev/release-wlock lock body))

  (defmacro ev/spawn-thread
    "Runs some code in a new thread. Like ^ev/do-thread, but returns nil immediately."
    [& body]
    `(~ev/thread (fn :spawn-thread [&] ~|body) nil :i))

  (defmacro ev/with-deadline
    """
    Creates a fiber to execute body, schedules the event loop to cancel
    the task (root fiber) associated with body's fiber, and starts
    body's fiber by resuming it.

    The event loop will try to cancel the root fiber if body's fiber
    has not completed after at least sec seconds.

    sec is a number that can have a fractional part.
    """
    [sec & body]
    (with-syms [f]
      `(as-macro ~let [~f (as-macro ~coro ~|body)]
         (~ev/deadline ~sec nil ~f)
         (~resume ~f))))

  (defn- cancel-all [chan fibers reason]
    (eachv f fibers (ev/cancel f reason))
    (let [n (length fibers)]
      (table/clear! fibers)
      (repeat n (ev/take chan))))

  (defn- wait-for-fibers
    [chan fibers]
    (defer (cancel-all chan fibers "parent canceled")
      (repeat (length fibers)
        (def [sig fiber] (ev/take chan))
        (if (= sig :ok)
          (put! fibers fiber nil)
          (do
            (cancel-all chan fibers "sibling canceled")
            (propagate (fiber/last-value fiber) fiber))))))

  (defn ev/go-gather
    """
    Runs a dynamic number of fibers in parallel and resumes the current fiber after they complete. Takes
    an array of functions or fibers, thunks, that will be run via ^ev/go in another task.
    Returns the gathered results in an array.
    """
    [thunks]
    (def fset !{})
    (def chan (ev/chan))
    (def results ![])
    (each thunk thunks
      (def ftemp (ev/go thunk nil chan))
      (array/push! results ftemp)
      (put! fset ftemp ftemp))
    (wait-for-fibers chan fset)
    (for i 0 (length results) ; avoid extra copy from map
      (set (results i) (fiber/last-value (in results i))))
    results)

  (defmacro ev/gather
    """
    Creates and runs a number of fibers in parallel (created from bodies) and resumes the
    current fiber after they complete. Shorthand for ^ev/go-gather. Returns the gathered results in an
    array.
    """
    [& bodies]
    `(~ev/go-gather ~(seq [body :in bodies] `(fn :ev/gather [] ~body)))))

(compwhen (dyn 'net/listen)
  (defn net/server
    """
    Starts a server with ^net/listen. Runs ^net/accept-loop asynchronously if
    handler is set and type is `:stream` (the default). It is invalid to set
    handler if type is `:datagram`. Returns the new server stream.
    """
    ([host port] (net/server host port nil nil nil))
    ([host port handler] (net/server host port handler nil nil))
    ([host port handler type] (net/server host port handler type nil))
    ([host port handler type no-reuse]
      (assert (not (and (= type :datagram) handler))
              "handler not supported for :datagram servers")
      (def s (net/listen host port type no-reuse))
      (if handler
        (ev/go (fn :net/server-handler [] (net/accept-loop s handler))))
      s)))

;;;
;;;
;;; FFI Extra
;;;
;;;

(defmacro delay
  "Lazily evaluates a series of expressions. Returns a function that returns the result of the last expression. Will only evaluate the body once, and then memoizes the result."
  [& forms]
  (def state (gensym))
  (def loaded (gensym))
  `((fn :delay []
      (var ~state nil)
      (var ~loaded nil)
      (fn []
        (if ~loaded
          ~state
          (do
            (set ~loaded true)
            (set ~state (do ~|forms))))))))

(compwhen (dyn 'ffi/native)

  (defdyn *ffi-context* " Current native library for ffi/bind and other settings")

  (defn- default-mangle
    [name &]
    (string/replace-all "-" "_" name))

  (defn ffi/context
    "Sets the path of the dynamic library to implicitly bind, as well as other global state for ease of creating native bindings."
    ([] (ffi/context nil))
    ([native-path & {:keys [map-symbols lazy]}]
      (default map-symbols default-mangle)
      (def lib (if lazy nil (ffi/native native-path)))
      (def lazy-lib (if lazy (delay (ffi/native native-path))))
      (setdyn *ffi-context*
              !{:native-path native-path
                :native lib
                :native-lazy lazy-lib
                :lazy lazy
                :map-symbols map-symbols})))

  (defmacro ffi/defbind-alias :flycheck
    "Generates bindings for native functions in a convenient manner. Similar to defbind but allows for the wattle function name to be different than the FFI function."
    [name alias ret-type & body]
    (def real-ret-type (eval ret-type))
    (def meta (slice body 0 -2))
    (def arg-pairs (partition 2 (last body)))
    (def formal-args (map 0 arg-pairs))
    (def type-args (map 1 arg-pairs))
    (def computed-type-args (eval `[~|type-args]))
    (if (dyn *flychecking*)
      (break `(defn ~alias ~|meta [~|formal-args] nil)))
    (def {lib :native
          lazy :lazy
          llib :native-lazy
          ms :map-symbols} (assert (dyn *ffi-context*) "no ffi context found"))
    (def raw-symbol (ms name))
    (defn make-sig []
      (ffi/signature :default real-ret-type |computed-type-args))
    (defn make-ptr []
      (assertf (ffi/lookup (if lazy (llib) lib) raw-symbol) "failed to find ffi symbol %v" raw-symbol))
    (if lazy
      `(as-macro ~defn ~alias ~|meta [~|formal-args]
         (~ffi/call (~(delay (make-ptr))) (~(delay (make-sig))) ~|formal-args))
      `(as-macro ~defn ~alias ~|meta [~|formal-args]
         (~ffi/call ~(make-ptr) ~(make-sig) ~|formal-args))))

  (defmacro ffi/defbind :flycheck
    "Generates bindings for native functions in a convenient manner."
    [name ret-type & body]
    `(as-macro ~ffi/defbind-alias ~name ~name ~ret-type ~|body)))

;;;
;;;
;;; Flychecking
;;;
;;;

(def- flycheck-specials !{})

(defn- flycheck-evaluator
  """
  An evaluator function that is passed to `run-context` that lints
  (flychecks) code for `flycheck`.  This means code will be parsed,
  compiled, and have macros expanded, but the code will not be
  evaluated.
  """
  [thunk source env where]
  (when (tuple? source)
    (def head (source 0))
    (def entry (get env head {}))
    (def fc (get flycheck-specials head (get entry :flycheck)))
    (cond
      ; Sometimes safe form
      (function? fc)
      (fc thunk source env where)
      ; Always safe form
      fc
      (thunk))))

(defn flycheck
  """
  Checks a file for errors without running the file. Found errors
  will be printed to stderr in the usual format. Top level functions
  and macros that have the metadata `:flycheck` will also be evaluated
  during flychecking. For full control, the `:flycheck` metadata can
  also be a function that takes 4 arguments - `thunk`, `source`, `env`,
  and `where`, the same as the `:evaluator` argument to ^run-context.
  Other arguments to ^flycheck are the same as ^dofile. Returns nil.
  """
  [path & {:as kwargs}]
  (def new-env (make-env (get kwargs :env)))
  (put! new-env *flychecking* true)
  (put! new-env *module-cache* !{})
  (put! new-env *module-loading* !{})
  (put! new-env *module-make-env* (fn :make-flycheck-env [&] (make-env new-env)))
  (try
    (dofile path :evaluator flycheck-evaluator |(kvs kwargs) :env new-env)
    ([e f]
      (debug/stacktrace f e "")))
  nil)

(defn- no-side-effects
  """
  Checks whether form may have side effects. If returns true, then the src
  must not have side effects, such as calling a C function.
  """
  [src]
  (cond
    (tuple? src)
    nil
    (or (array? src) (vector? src))
    (every? (map no-side-effects src))
    (dictionary? src)
    (and (every? (map no-side-effects (keys src)))
         (every? (map no-side-effects (values src))))
    true))

(defn- is-safe-def [thunk source env where]
  (if-let [ve (get env (source 1))
           fc (get ve :flycheck)]
    (cond
      ; Sometimes safe form
      (function? fc)
      (fc thunk source env where)
      ; Always safe form
      fc
      (thunk))
    (if (no-side-effects (last source))
      (thunk))))

(defn- flycheck-importer
  [thunk source env where]
  (let [[l c] (tuple/sourcemap source)
        newtup (tuple/sourcemap! (tuple |source :evaluator flycheck-evaluator) [l c])]
    ((compile newtup env where))))

(defn- flycheck-use
  [thunk source env where]
  (each a (drop 1 source) (import* (string a) :prefix "" :evaluator flycheck-evaluator)))

; Add metadata to defs and import macros for flychecking
(each sym ['def 'var]
  (put! flycheck-specials sym is-safe-def))
(each sym ['def- 'var- 'defglobal 'varglobal]
  (put! (dyn sym) :flycheck is-safe-def))
(each sym ['import 'import* 'dofile 'require]
  (put! (dyn sym) :flycheck flycheck-importer))
(put! (dyn 'use) :flycheck flycheck-use)

;;;
;;;
;;; Package tools
;;;
;;;

(compwhen (dyn 'os/stat)

  (def- seps {:windows "\\" :cygwin "\\"})
  (defn- sep [] (get seps (os/which) "/"))

  (def- pkg-expected !{})

  (defn- pkg-fail
    """
    Raises message, a string, as an error that wattle pkg prints without a
    stack trace. The message is recorded so that the command line can tell it
    from an error that was not expected.
    """
    [message]
    (put! pkg-expected message true)
    (error message))

  (defn- pkg-errorf
    """
    Raises the string that fmt and vals format, as ^pkg-fail does.
    """
    [fmt & vals]
    (pkg-fail (string/format fmt |vals)))

  (defn- pkg-assert
    """
    Raises message as ^pkg-fail does unless x is truthy.
    """
    [x message]
    (unless x (pkg-fail message)))

  (defn- pkg-assertf
    """
    Raises the string that fmt and vals format, as ^pkg-fail does, unless x is
    truthy.
    """
    [x fmt & vals]
    (unless x (pkg-fail (string/format fmt |vals))))

  (defn- pkg-root
    """
    Returns the prefix, the root that the library, program and manual
    directories derive from.
    """
    []
    (wattle/libpath) ; raises if there is no prefix or it is empty
    (dyn *prefix*))

  (defn- pkg-mkdirs
    """
    Creates the directory at path and any of its parents that are missing. On
    Windows a forward slash separates as well, so a path that mixes the two
    is split at each.
    """
    [path-in]
    (def s (sep))
    (def path (if (= s "/") path-in (string/replace-all "/" s path-in)))
    (var so-far (if (string/has-prefix? s path) s ""))
    (each part (string/split s path)
      (unless (empty? part)
        (set so-far (if (or (empty? so-far) (= so-far s))
                      (string so-far part)
                      (string so-far s part)))
        (protect (os/mkdir so-far))))
    (pkg-assertf (= :directory (os/stat path :mode)) "cannot create directory %s" path))

  (defn- pkg-dir
    ([] (pkg-dir nil))
    ([pkg-name]
      (def s (sep))
      (string (wattle/libpath) s "pkg" (if pkg-name s) pkg-name)))

  (defn- pkg-file
    [pkg-name filename]
    (def s (sep))
    (string (wattle/libpath) s "pkg" s pkg-name s filename))

  (defn- get-manifest-filename
    [pkg-name]
    (pkg-file pkg-name "manifest.edn"))

  (defn- get-files [manifest]
    (def files (get manifest :files ![]))
    (put! manifest :files files)
    files)

  (defn- rmrf
    "rm -rf in wattle"
    [x]
    (case (os/lstat x :mode)
      nil nil
      :directory (do
                   (def s (sep))
                   (each y (os/dir x)
                     (rmrf (string x s y)))
                   (os/rmdir x))
      (os/rm x))
    nil)

  (defn- copyfile
    [from to]
    (if-with [ffrom (file/open from :rb)]
      (if-with [fto (file/open to :wb)]
        (do
          (def perm (os/stat from :permissions))
          (def b (buffer/new 0x10000))
          (forever
            (file/read ffrom 0x10000 b)
            (when (empty? b) (buffer/trim! b) (os/chmod to perm) (break))
            (file/write fto b)
            (buffer/clear! b)))
        (pkg-errorf "destination file %s cannot be opened for writing" to))
      (pkg-errorf "source file %s cannot be opened for reading" from)))

  (defn- copyrf
    [from to]
    (case (os/stat from :mode)
      :file (copyfile from to)
      :directory (do
                   (def s (sep))
                   (os/mkdir to)
                   (each y (os/dir from)
                     (copyrf (string from s y) (string to s y)))))
    nil)

  (defn- sync-manifest
    [manifest]
    (def bn (get manifest :name))
    (def manifest-name (get-manifest-filename bn))
    (def b !"")
    ; Frozen on the way out: edn tags a mutable value and `parse` reads no
    ; word tag, so what reaches disk is a map of vectors, which `%w` and `%y`
    ; write identically and `parse` reads back unchanged.
    (def frozen (freeze manifest))
    (buffer/format! b "%y" frozen) ; make sure it is valid edn
    (buffer/clear! b)
    (buffer/format! b "%.99m\n" frozen)
    (spit manifest-name b))

  (defn pkg/manifest
    "Gets the manifest for a given installed package."
    [pkg-name]
    (def name (get-manifest-filename pkg-name))
    (pkg-assertf (fexists name) "no package %v found" pkg-name)
    (parse (slurp name)))

  (defn- get-pkg-module
    [pkg-name]
    (def manifest (pkg/manifest pkg-name))
    (def dir (os/cwd))
    (def workdir (get manifest :local-source "."))
    (def fixed-prefix (os/realpath (pkg-root)))
    (try
      (os/cd workdir)
      ([_] (print "cannot enter source directory " workdir " for package " pkg-name)))
    (defer (os/cd dir)
      (def new-env (make-env))
      (put! new-env *module-cache* !{})
      (put! new-env *module-loading* !{})
      (put! new-env *module-make-env* (fn make-pkg-env [&] (make-env new-env)))
      (put! new-env :workdir workdir)
      (put! new-env :name pkg-name)
      (put! new-env *prefix* fixed-prefix)
      (with-env new-env
        (put! new-env :pkg-dir (pkg-dir pkg-name)) ; get the prefix right
        (try
          (require (string "@prefix/lib/wattle/pkg/" pkg-name))
          ([e f]
            (def pfx "could not find module @prefix/lib/wattle/pkg/")
            (def msg (if (and (string? e)
                              (string/has-prefix? pfx e))
                       "package must contain pkg.wattle or pkg/init.wattle"
                       e))
            (propagate msg f))))))

  (defn- do-hook
    [module pkg-name hook & args]
    (def hookf (module/value module (symbol hook)))
    (unless hookf (break))
    (def dir (os/cwd))
    (os/cd (get module :workdir "."))
    (defer (os/cd dir)
      (print "running hook " hook " for package " pkg-name)
      (hookf |args)))

  (defn pkg/list
    "Gets a list of all installed packages in lexical order."
    []
    (def d (pkg-dir))
    (if (os/stat d :mode)
      (sort! (os/dir d))
      ![]))

  (defn- pkg-uninstall-unchecked
    [pkg-name]
    (def man (pkg/manifest pkg-name))
    (def all-hooks (get man :hooks ![]))
    (when (index-of :uninstall all-hooks)
      (def module (get-pkg-module pkg-name))
      (do-hook module pkg-name :uninstall man))
    (def files (get man :files []))
    (each file (reverse files)
      (print "remove " file)
      (case (os/stat file :mode)
        :file (os/rm file)
        :directory (os/rmdir file)))
    (rmrf (pkg-dir pkg-name))
    nil)

  (defn pkg/uninstall
    """
    Removes a package from the current prefix. There is 1 hook called during
    uninstallation (uninstall). A user can register a hook by defining a
    function with the same name in the package script.
    """
    [pkg-name]
    (def breakage
      (filter (fn [b] (and (not= b pkg-name)
                           (has-value? (get (pkg/manifest b) :dependencies []) pkg-name)))
              (pkg/list)))
    (unless (empty? breakage)
      (def breakage-list (sort breakage))
      (pkg-errorf "cannot uninstall %s, breaks dependent packages %n" pkg-name breakage-list))
    (pkg-uninstall-unchecked pkg-name))

  (defn pkg/topolist
    "Gets topological order of all packages, such that each package is listed after its dependencies."
    []
    (def visited !{})
    (def cycle-detect !{})
    (def order ![])
    (def stack ![])
    (defn visit
      [b]
      (array/push! stack b)
      (if (get visited b) (break))
      (if (get cycle-detect b) (pkg-errorf "cycle detected in package dependencies: %s" (string/join " -> " stack)))
      (put! cycle-detect b true)
      (each d (get (pkg/manifest b) :dependencies []) (visit d))
      (put! cycle-detect b nil)
      (put! visited b true)
      (array/pop! stack)
      (array/push! order b))
    (each b (pkg/list) (visit b))
    order)

  (defn pkg/prune
    """
    Removes all orphaned packages from the current prefix. An orphaned package is a
    package that is marked for :auto-remove and is not depended on by any other package.
    """
    []
    (def topo (pkg/topolist))
    (def rtopo (reverse topo))
    ; Check which auto-remove packages can be dropped
    ; Iterate in (reverse) topological order, and if we see an auto-remove package and have not already seen
    ; something that depends on it, then it is a root package and can be pruned.
    (def exempt !{})
    (def to-drop ![])
    (each b rtopo
      (def m (pkg/manifest b))
      (if (or (get exempt b) (not (get m :auto-remove)))
        (do
          (put! exempt b true)
          (each d (get m :dependencies []) (put! exempt d true)))
        (array/push! to-drop b)))
    (print "pruning " (length to-drop) " packages")
    (each b to-drop
      (print "uninstalling " b)
      (pkg-uninstall-unchecked b)))

  (defn pkg/installed?
    "Checks whether a package is installed."
    [pkg-name]
    (truthy? (os/stat (pkg-dir pkg-name) :mode)))

  (defn- pkg-add-file-to
    [manifest base src dest chmod-mode]
    (def files (get-files manifest))
    (def s (sep))
    (def absdest (string base s dest))
    (when (os/stat absdest :mode)
      (pkg-errorf "collision at %s, file already exists" absdest))
    (copyfile src absdest)
    (def absdest (os/realpath absdest))
    (array/push! files absdest)
    (when chmod-mode
      (os/chmod absdest chmod-mode))
    (print "add " absdest)
    absdest)

  (defn pkg/add-bin
    """
    Adds a file to the "bin" subdirectory of the current prefix. By default,
    files will be set to be executable.
    """
    ([manifest src] (pkg/add-bin manifest src (last (string/split (sep) src)) 8r755))
    ([manifest src filename] (pkg/add-bin manifest src filename 8r755))
    ([manifest src filename chmod-mode]
      (pkg-mkdirs (wattle/binpath))
      (put! manifest :has-exe true)
      (pkg-add-file-to manifest (wattle/binpath) src filename chmod-mode)))

  (defn pkg/add-manpage
    """
    Adds a file to the share/man subdirectory of the current prefix. Files are
    copied inside a directory mansec, under the name filename. By default,
    mansec is "man1" and filename is the name of src.
    """
    ([manifest src] (pkg/add-manpage manifest src "man1"))
    ([manifest src mansec]
      (pkg/add-manpage manifest src mansec (last (string/split (sep) src))))
    ([manifest src mansec filename] (pkg/add-manpage manifest src mansec filename nil))
    ([manifest src mansec filename chmod-mode]
      (def dir (string (wattle/manpath) (sep) mansec))
      (pkg-mkdirs dir)
      (put! manifest :has-man true)
      (pkg-add-file-to manifest dir src filename chmod-mode)))

  (defn- pkg-source-kind
    """
    Returns :directory for an existing directory, :tarball for a name ending in
    .tar or .tar.gz and :git for anything else.
    """
    [source]
    (cond
      (= :directory (os/stat source :mode)) :directory
      (or (string/has-suffix? ".tar" source)
          (string/has-suffix? ".tar.gz" source)) :tarball
      :git))

  (defn- pkg-run
    """
    Runs tool with args. Raises if tool cannot be started or exits with a
    status other than 0. The message of the second error is followed by what
    tool wrote to its standard error, which is not shown otherwise. Raises
    in a build that has no os/execute.
    """
    [tool & args]
    (compif (dyn 'os/execute)
      (do
        (pkg-mkdirs (wattle/libpath))
        (def path (string (wattle/libpath) (sep) ".stderr"))
        (def err (file/open path :wb))
        (def [ok status] (protect (os/execute [tool |args] :p {:err err})))
        (file/close err)
        ; The tool may end its lines with a carriage return and a newline. The
        ; stream that prints the message adds the carriage return itself.
        (def text (string/trim (string/replace-all "\r\n" "\n" (string (slurp path)))))
        (rmrf path)
        (pkg-assertf ok "could not run %s, is it on the PATH?" tool)
        (unless (zero? status)
          (pkg-fail (string tool " exited with status " status
                            (if (empty? text) "" (string "\n" text))))))
      (pkg-errorf "cannot run %s, this build has no os/execute" tool)))

  (defn- pkg-run-live
    """
    Runs tool with args, which write to the standard streams of this process as
    they run. Raises if tool cannot be started or exits with a status other
    than 0, and names label, in place of tool, in the second message. Raises in
    a build that has no os/execute.
    """
    [label tool & args]
    (compif (dyn 'os/execute)
      (do
        (def [ok status] (protect (os/execute [tool |args] :p)))
        (pkg-assertf ok "could not run %s, is it on the PATH?" tool)
        (pkg-assertf (zero? status) "%s exited with status %d" label status))
      (pkg-errorf "cannot run %s, this build has no os/execute" tool)))

  (defn- pkg-unpack-root
    """
    Returns the package root of an unpacked tree: the one directory in dir if
    that is all dir holds, and dir otherwise.
    """
    [dir]
    (def entries (os/dir dir))
    (def only (when (= 1 (length entries)) (string dir (sep) (first entries))))
    (if (and only (= :directory (os/stat only :mode))) only dir))

  (defn- pkg-with-source
    """
    Calls f with the root directory of source and returns what f returns. A
    directory is passed as it is. A tarball is downloaded and unpacked, and a
    Git repository is cloned, into a temporary directory under the library
    directory of the prefix. That directory is removed after f returns or
    raises. Raises if ref, a branch or tag, is given for anything but a Git
    repository.
    """
    [source ref f]
    (def kind (pkg-source-kind source))
    (pkg-assertf (or (nil? ref) (= kind :git))
             "a ref is accepted only for a Git repository, not %v" source)
    (if (= kind :directory)
      (f source)
      (do
        (def s (sep))
        (def tmp (string (wattle/libpath) s ".fetch"))
        (def dest (string tmp s "src"))
        (rmrf tmp)
        (pkg-mkdirs dest)
        (defer (rmrf tmp)
          (print "fetching " source)
          (case kind
            :tarball (let [archive (string tmp s "archive")]
                       (pkg-run "curl" "--fail" "--silent" "--show-error" "--location"
                                "--output" archive "--url" source)
                       (pkg-run "tar" "-xf" archive "-C" dest))
            :git (do
                   (pkg-run "git" "-c" "advice.detachedHead=false" "clone" "--quiet" "--depth" "1"
                            |(if ref ["--branch" ref] []) "--" source dest)
                   (rmrf (string dest s ".git"))))
          (f (pkg-unpack-root dest))))))

  (defn- pkg-artifacts-of
    """
    Returns the artifacts of info that have type kind, in order.
    """
    [info kind]
    (filter #(= kind (get $ :type)) (get info :artifacts ![])))

  (defn- pkg-man-section
    """
    Returns the directory of share/man for the manual page file, `man` and the
    digit that ends its name. Raises if the name does not end in a period and a
    digit from 1 to 9.
    """
    [file]
    (def digit (last (string/split "." file)))
    (pkg-assertf (and (= 1 (length digit)) (string/check-set "123456789" digit))
             ":man entry %v must end in a period and a digit from 1 to 9" file)
    (string "man" digit))

  (defn- pkg-default-build
    """
    Builds the :exe artifacts of info in the directory path, by running wattle
    build exe there with the prefix of the install. Does nothing if info
    declares none.
    """
    [path info]
    (when (next (pkg-artifacts-of info :exe))
      (def s (sep))
      (def exe0 (dyn :executable "wattle"))
      ; A path with a separator is relative to the current directory, which
      ; the build leaves.
      (def exe (if (string/find s exe0) (os/realpath exe0) exe0))
      (def dir (os/cwd))
      (os/cd path)
      (defer (os/cd dir)
        (print "building " (string/join ", " (map #(get $ :name) (pkg-artifacts-of info :exe))))
        ; Not captured, so that the output of the build appears as it runs and
        ; Zig can draw its progress on a terminal.
        (pkg-run-live "wattle build exe" exe "-p" (dyn *prefix*) "build" "exe"))))

  (defn- pkg-default-install
    """
    Adds to manifest the program of each :exe artifact of info, from zig-out/bin
    under path, and each file in the :man of info. Raises if info declares a
    :lib artifact.
    """
    [manifest path info]
    (def s (sep))
    (when (next (pkg-artifacts-of info :lib))
      (pkg-fail "a :lib artifact is installed only by a package script"))
    (def ext (if (get seps (os/which)) ".exe" ""))
    ; The manifest is written first on a failure so that the uninstall that
    ; follows removes the files added so far.
    (edefer (sync-manifest manifest)
      (each artifact (pkg-artifacts-of info :exe)
        (def file (string (get artifact :name) ext))
        (pkg/add-bin manifest (string path s "zig-out" s "bin" s file) file))
      (each file (get info :man ![])
        ; The separator on Windows is a backslash, so an entry written with
        ; forward slashes is split at both.
        (def base (last (string/split "/" (string/replace-all s "/" file))))
        (pkg/add-manpage manifest (string path s file) (pkg-man-section file) base))))

  (defn- pkg-install-dir
    """
    Installs the package in the directory path. See ^pkg/install.
    """
    [path & {:as config}]
    (def path (os/realpath path))
    (def s (sep))
    ; Detect info file
    (def infofile-src1 (string path s "pkg" s "info.edn"))
    (def infofile-src2 (string path s "info.edn"))
    (def infofile-src (cond
                        (fexists infofile-src1) infofile-src1
                        (fexists infofile-src2) infofile-src2))
    (def info (-?> infofile-src slurp parse))
    ; Check bscript
    (def bscript-src1 (string path s "pkg" s "init.wattle"))
    (def bscript-src2 (string path s "pkg.wattle"))
    (def bscript-src (cond
                       (fexists bscript-src1) bscript-src1
                       (fexists bscript-src2) bscript-src2))
    (pkg-assert (or bscript-src (get info :artifacts) (get info :man))
            "package must contain pkg.wattle, pkg/init.wattle or an info.edn that declares :artifacts or :man")
    ; Detect package name
    (def pkg-name (get config :name (get info :name)))
    (pkg-assertf pkg-name
             "unable to infer package name for %v, use :name argument or add :name to info file" path)
    (pkg-assertf (not (string/check-set "\\/" pkg-name))
             "package name %v cannot contain path separators" pkg-name)
    (pkg-assert (next pkg-name) "cannot use empty pkg-name")
    (pkg-assertf (not (fexists (get-manifest-filename pkg-name)))
             "package %v is already installed" pkg-name)
    ; Setup installed paths
    (pkg-mkdirs (pkg-dir))
    (os/mkdir (pkg-dir pkg-name))
    ; Copy aliased infofile
    (when (fexists infofile-src2)
      (copyfile infofile-src2 (pkg-file pkg-name "info.edn")))
    ; Copy aliased bscript
    (when (fexists bscript-src2)
      (copyfile bscript-src2 (pkg-file pkg-name "init.wattle")))
    ; Copy some files into the new location unconditionally
    (def implicit-sources (string path s "pkg"))
    (when (= :directory (os/stat implicit-sources :mode))
      (copyrf implicit-sources (pkg-dir pkg-name)))
    (def man !{:name pkg-name :local-source path :files ![]})
    (merge! man config)
    (sync-manifest man)
    (edefer (do (print "installation error, uninstalling") (pkg/uninstall pkg-name))
      (when info
        (def deps (seq [d :in (get info :dependencies ![])]
                    (string (if (dictionary? d) (get d :name) d))))
        (def missing (filter (complement pkg/installed?) deps))
        (when (next missing)
          (pkg-fail (string "missing dependencies " (string/join ", " missing))))
        (put! man :dependencies deps)
        (put! man :info info))
      (def module (when bscript-src (get-pkg-module pkg-name)))
      (def clean (get config :clean))
      (def check (get config :check))
      (def all-hooks (if module
                       (seq [[k v] :pairs module :when (symbol? k) :unless (get v :private)] (keyword k))
                       ![]))
      (put! man :hooks all-hooks)
      (if module
        (do
          (do-hook module pkg-name :postdeps man)
          (when clean
            (do-hook module pkg-name :clean man))
          (do-hook module pkg-name :build man)
          (do-hook module pkg-name :install man))
        (do
          (pkg-default-build path info)
          (pkg-default-install man path info)))
      (if (empty? (get man :files)) (print "no files installed, is this a valid pkg?"))
      (sync-manifest man)
      (when (and module check)
        (do-hook module pkg-name :check man)))
    ; A fetched source is a temporary directory, so only its origin is kept.
    (when (get man :source)
      (put! man :local-source nil)
      (sync-manifest man))
    (print "installed " pkg-name)
    (when (get man :has-exe)
      (eprintf "executable files have been installed to %s" (wattle/binpath)))
    (when (get man :has-man)
      (eprintf "man pages have been installed to %s" (wattle/manpath)))
    pkg-name)

  (defn pkg/install
    """
    Installs a package from source, which is an existing directory, a name
    ending in .tar or .tar.gz that curl downloads and tar unpacks, or any other
    name, which git clones. The name of the package is the value mapped to :name
    in either config or the info file. The :ref in config is a branch or tag and
    is accepted only for a Git repository. There are 5 hooks called during
    installation (postdeps, clean, build, install and check). A user can
    register a hook by defining a function with the same name in the package
    script. A package without pkg.wattle or pkg/init.wattle is built and
    installed from the :artifacts and :man of its info file instead.
    """
    [source & {:as config}]
    ; A :source in config marks a root that was fetched earlier, so its :ref is
    ; a record and not a request.
    (def ref (if (get config :source) nil (get config :ref)))
    (def kind (pkg-source-kind source))
    (pkg-with-source source ref
      (fn [root]
        (if (= kind :directory)
          (pkg-install-dir root |(kvs config))
          (pkg-install-dir root :source source |(kvs config))))))

  (defn- pkg/pack
    """
    Takes an installed package and creates a package source directory that can be
    used to reinstall the package on a compatible system. This is used to create
    backups for installed packages without rebuilding, or make a prebuilt package
    for other systems.
    """
    ([pkg-name dest-dir] (pkg/pack pkg-name dest-dir nil))
    ([pkg-name dest-dir is-backup]
      (var i 0)
      (def man (pkg/manifest pkg-name))
      (def files (get man :files ![]))
      (pkg-assertf (os/mkdir dest-dir) "could not create directory %v (or it already exists)" dest-dir)
      (def s (sep))
      (os/mkdir (string dest-dir s "pkg"))
      (def install-hook (string dest-dir s "pkg" s "init.wattle"))
      (edefer (rmrf dest-dir) ; don't leave garbage on failure
        (def install-source ![])
        (defn real-or-plain [path] (if (os/stat path :mode) (os/realpath path) path))
        (def libpath (real-or-plain (wattle/libpath)))
        (def binpath (real-or-plain (wattle/binpath)))
        (def manpath (real-or-plain (wattle/manpath)))
        (defn relative-to
          "Returns file relative to dir, or nil if file is not inside dir."
          [dir file]
          (when (string/has-prefix? (string dir s) file)
            (string/triml (slice file (length dir) -1) s)))
        (when is-backup (copyrf (pkg-dir pkg-name) (string dest-dir s "old-pkg")))
        (each file files
          (def {mode :mode perm :permissions} (os/stat file))
          (def lib-rel (relative-to libpath file))
          (def bin-rel (relative-to binpath file))
          (def man-rel (relative-to manpath file))
          (case mode
            :directory (if lib-rel
                         (array/push! install-source `(pkg/add-directory manifest ~lib-rel ~perm))
                         (pkg-errorf "unexpected directory %v" file))
            :file (do
                    (def filename (string/format "file_%06d" (++ i)))
                    (copyfile file (string dest-dir s filename))
                    (array/push! install-source
                                 (cond
                                   lib-rel `(pkg/add-file manifest ~filename ~lib-rel ~perm)
                                   bin-rel `(pkg/add-bin manifest ~filename ~bin-rel ~perm)
                                   man-rel (let [parts (string/split s man-rel)]
                                             `(pkg/add-manpage manifest ~filename ~(first parts) ~(last parts) ~perm))
                                   (pkg-errorf "unexpected file %v" file))))
            (pkg-errorf "unexpected file %v" file)))
        (def b !"(defn install [manifest]")
        (each form install-source (buffer/format! b "\n  %w" form))
        (buffer/push! b ")\n")
        (spit install-hook b))
      dest-dir))

  (defn pkg/replace
    """
    Reinstalls an existing package from a new directory. Similar to
    pkg/reinstall, but installs the replacement package from any directory.
    This is necessary to replace a package without breaking any dependencies.
    """
    [pkg-name path & {:as new-config}]
    (def manifest (pkg/manifest pkg-name))
    (def config (get manifest :config !{}))
    (def s (sep))
    (pkg-assertf (= :directory (os/stat path :mode)) "local source %v not available" path)
    (def backup-dir (string (wattle/libpath) s pkg-name ".backup"))
    (rmrf backup-dir)
    (def backup-pkg-source (pkg/pack pkg-name backup-dir true))
    (edefer (do
              (pkg/install backup-pkg-source :name pkg-name)
              (copyrf (string backup-pkg-source s "old-pkg") (pkg-dir pkg-name))
              (rmrf backup-pkg-source))
      (pkg-uninstall-unchecked pkg-name)
      (pkg/install path :name pkg-name |(kvs config) |(kvs new-config)))
    (rmrf backup-pkg-source)
    pkg-name)

  (defn pkg/reinstall
    """
    Reinstalls an existing package from its source: the directory it was
    installed from, or a new download of the tarball or Git repository.
    """
    [pkg-name & {:as new-config}]
    (def manifest (pkg/manifest pkg-name))
    (def source (get manifest :source))
    (def ref (get manifest :ref))
    (if source
      (pkg-with-source source ref
        (fn [root]
          (pkg/replace pkg-name root :source source |(if ref [:ref ref] []) |(kvs new-config))))
      (pkg/replace pkg-name (get manifest :local-source) |(kvs new-config)))
    pkg-name)

  (defn pkg/add-directory
    "Adds a directory during an install relative to the lib/wattle directory of `(dyn *prefix*)`."
    ([manifest dest] (pkg/add-directory manifest dest nil))
    ([manifest dest chmod-mode]
      (def files (get-files manifest))
      (def s (sep))
      (def absdest (string (wattle/libpath) s dest))
      (unless (os/mkdir absdest)
        (pkg-errorf "collision at %s, directory already exists" absdest))
      (def absdest (os/realpath absdest))
      (array/push! files absdest)
      (when chmod-mode
        (os/chmod absdest chmod-mode))
      (print "add " absdest)
      absdest))

  (defn pkg/whois
    "Given a file path, figures out which package installed it."
    [path]
    (def rpath (os/realpath path))
    (find #(index-of rpath (get (pkg/manifest $) :files [])) (pkg/list)))

  (defn pkg/add-file
    "Adds a file during an install relative to the lib/wattle directory of `(dyn *prefix*)`."
    ([manifest src] (pkg/add-file manifest src src nil))
    ([manifest src dest] (pkg/add-file manifest src dest nil))
    ([manifest src dest chmod-mode]
      (pkg-add-file-to manifest (wattle/libpath) src dest chmod-mode)))

  (defn pkg/add
    """
    Adds a file or directory during an install relative to the lib/wattle directory of `(dyn *prefix*)`.
    Added files and directories will be recorded in the package manifest such
    that they are properly tracked and removed during an upgrade or uninstall.
    """
    ([manifest src] (pkg/add manifest src src nil))
    ([manifest src dest] (pkg/add manifest src dest nil))
    ([manifest src dest chmod-mode]
      (def s (sep))
      (def mode (os/stat src :mode))
      (if-not mode (pkg-errorf "file %s does not exist" src))
      (case mode
        :directory
        (let [absdest (pkg/add-directory manifest dest chmod-mode)]
          (each d (os/dir src) (pkg/add manifest (string src s d) (string dest s d) chmod-mode))
          absdest)
        :file (pkg/add-file manifest src dest chmod-mode)
        (pkg-errorf "bad path %s - file is a %s" src mode))))

  (defn pkg/update-all
    "Reinstalls all packages."
    [& {:as configs}]
    (each pkg (pkg/topolist)
      (pkg/reinstall pkg |(kvs configs)))))

;;;
;;;
;;; Package artifacts
;;;
;;;

; A info.edn holds `:artifacts`, a vector of maps. Each map has a `:type` of
; `:exe` or `:lib` and a `:name`. An `:exe` has an `:entry`, the Wattle file
; that defines `main`, and may have `:libs`, a vector of the names of the
; `:lib` artifacts compiled into it. A `:lib` has a `:root`, the Zig root file
; of a native module. ^pkg/artifacts raises on the first problem and names the
; artifact and the key. Neither function looks at the file system.

(def- pkg-artifact-allowed-keys
  {:exe [:type :name :entry :libs]
   :lib [:type :name :root]
   :web [:type :name :entry]})

; A `:lib` name is spliced into two symbol names and a string, and an `:exe`
; or `:web` name is a file name.
(def- pkg-artifact-name-chars
  (string "abcdefghijklmnopqrstuvwxyz" "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
          "0123456789_-"))

(defn- pkg-artifact-where
  "Describes the artifact at index i, by name where it has a usable one."
  [i artifact]
  (def name (get artifact :name))
  (if (and (string? name) (not (empty? name)))
    (string/format "artifact %d (%s)" i name)
    (string/format "artifact %d" i)))

(defn- pkg-artifact-fail
  [i artifact fmt & vals]
  (error (string "info.edn: " (pkg-artifact-where i artifact) ": "
                 (string/format fmt |vals))))

(defn- pkg-artifact-check-string
  [i artifact key]
  (def val (get artifact key))
  (unless (and (string? val) (not (empty? val)))
    (pkg-artifact-fail i artifact "%v must be a non-empty string" key)))

(defn- pkg-artifact-check-name
  [i artifact]
  (pkg-artifact-check-string i artifact :name)
  (unless (string/check-set pkg-artifact-name-chars (get artifact :name))
    (pkg-artifact-fail i artifact ":name may hold only letters, digits, `_` and `-`")))

(defn- pkg-artifact-check-keys
  [i artifact kind]
  (def ok (get pkg-artifact-allowed-keys kind))
  (each k (keys artifact)
    (unless (has-value? ok k)
      (pkg-artifact-fail i artifact "%v is not a key of %s %v" k
                         (if (= kind :web) "a" "an") kind))))

(defn- pkg-artifact-check-libs
  [i artifact by-name]
  (def libs (get artifact :libs))
  (when (nil? libs) (break))
  (unless (vector? libs)
    (pkg-artifact-fail i artifact ":libs must be a vector of names"))
  (def seen !{})
  (each n libs
    (when (map? n)
      (pkg-artifact-fail i artifact
                  ":libs holds a map, which is reserved for an external library"))
    (unless (string? n)
      (pkg-artifact-fail i artifact ":libs must hold strings, not %v" n))
    (when (get seen n)
      (pkg-artifact-fail i artifact ":libs names %s twice" n))
    (put! seen n true)
    (def target (get by-name n))
    (unless target
      (pkg-artifact-fail i artifact ":libs names %s, which no artifact declares" n))
    (unless (= :lib (get target :type))
      (pkg-artifact-fail i artifact ":libs names %s, which is not a :lib" n))))

(defn- pkg-artifacts-checked
  [x]
  (unless (map? x)
    (error "info.edn: must hold a map"))
  (def artifacts (get x :artifacts))
  (when (nil? artifacts)
    (error "info.edn: no :artifacts are declared"))
  (unless (vector? artifacts)
    (error "info.edn: :artifacts must be a vector"))
  (def by-name !{})
  (loop [[i artifact] :pairs artifacts]
    (unless (map? artifact)
      (errorf "info.edn: artifact %d must be a map" i))
    (def kind (get artifact :type))
    (unless (or (= kind :exe) (= kind :lib) (= kind :web))
      (pkg-artifact-fail i artifact ":type must be :exe, :lib or :web"))
    (pkg-artifact-check-name i artifact)
    (def name (get artifact :name))
    (when (get by-name name)
      (pkg-artifact-fail i artifact ":name is already used by artifact %d"
                          (get (get by-name name) :index)))
    (put! by-name name {:index i :type kind})
    (pkg-artifact-check-string i artifact (if (= kind :lib) :root :entry))
    (pkg-artifact-check-keys i artifact kind))
  (loop [[i artifact] :pairs artifacts]
    (pkg-artifact-check-libs i artifact by-name))
  artifacts)

(defn pkg/artifacts
  """
  Checks the `:artifacts` of x, a map read from an info.edn, and returns them.
  With kind, `:exe`, `:lib` or `:web`, returns only the artifacts of that kind, and
  with name as well, only the one called name. The artifacts are in the order
  x declares them. Raises an error naming the artifact and the key for a
  missing or misplaced key, a name used twice, or a `:libs` entry that does not
  name a `:lib`. Also raises if x declares no artifact of kind, or none called
  name.
  """
  ([x] (pkg-artifacts-checked x))
  ([x kind] (pkg/artifacts x kind nil))
  ([x kind name]
    (def chosen (filter #(= kind (get $ :type)) (pkg-artifacts-checked x)))
    (when (empty? chosen)
      (errorf "info.edn: no %v artifact is declared" kind))
    (if (nil? name)
      chosen
      (let [found (filter #(= name (get $ :name)) chosen)]
        (when (empty? found)
          (errorf "info.edn: no %v artifact is called %s" kind name))
        found))))

;;;
;;;
;;; Zig build files
;;;
;;;

(defn- pkg-path-parts
  "Splits path at / and at \\, dropping empty parts and . parts and resolving .. parts against the part before."
  [path]
  (def out ![])
  (each part (string/split "/" (string/replace-all "\\" "/" path))
    (cond
      (or (empty? part) (= part ".")) nil
      (and (= part "..") (not (empty? out)) (not= (last out) "..")) (array/pop! out)
      (array/push! out part)))
  out)

(defn- pkg-relative-path
  "Returns the path from the directory from to the path to, which are both absolute."
  [from to]
  (def f (pkg-path-parts from))
  (def t (pkg-path-parts to))
  (var i 0)
  (while (and (< i (length f)) (< i (length t)) (= (get f i) (get t i)))
    (++ i))
  (string/join "/" [|(map (fn [_] "..") (slice f i)) |(slice t i)]))

(defn- pkg-zig-string
  "Returns s as the body of a Zig string literal."
  [s]
  (string/replace-all "\"" "\\\"" (string/replace-all "\\" "\\\\" s)))

(defn- pkg-absolute-path
  "Returns path, or dir followed by path where path is relative."
  [dir path]
  (if (or (string/has-prefix? "/" path) (string/has-prefix? "\\" path)
          (and (> (length path) 1) (= 58 (get path 1)))) ; a drive letter
    path
    (string dir "/" path)))

(defn pkg/zig-files
  """
  Returns a table with the text of the build.zig and the build.zig.zon that
  build the artifacts of x, a map read from an info.edn, under :build and :zon.
  kind is `:exe`, `:lib` or `:web`. With name, only the artifact called name is built.
  opts is a map with three directories: :dir, the absolute path of the project,
  which relative artifact paths are resolved against, :srcpath, the Wattle
  package, and :gen, the directory the two files are written to. :srcpath and
  :gen are resolved against :dir where they are relative. An executable is
  built with the libs it names in :libs linked in, and without docstrings
  unless the optimize mode is Debug. A lib is built as a shared library. A web
  artifact is built as an image and a runtime for a browser, with no docstrings,
  whatever the target is.
  Raises if ^pkg/artifacts raises for x, kind and name.
  """
  ([x kind opts] (pkg/zig-files x kind nil opts))
  ([x kind name opts]
    (def chosen (pkg/artifacts x kind name))
    (def libs !{})
    (each artifact (get x :artifacts)
      (when (= :lib (get artifact :type))
        (put! libs (get artifact :name) artifact)))
    (def dir (get opts :dir))
    (defn zig-path [path]
      (string ".{ .cwd_relative = \"" (pkg-zig-string (pkg-absolute-path dir path)) "\" }"))
    (def b !"")
    (buffer/push! b
      "const std = @import(\"std\");\n"
      "const wattle = @import(\"wattle\");\n\n"
      "pub fn build(b: *std.Build) void {\n")
    ; A web artifact is built for the browser, so it takes no target.
    (unless (= kind :web)
      (buffer/push! b "    const target = b.standardTargetOptions(.{});\n"))
    (buffer/push! b "    const optimize = b.standardOptimizeOption(.{});\n")
    (case kind
      :exe
      (buffer/push! b
        "    const docstrings = optimize == .debug;\n"
        "    const dep = b.dependency(\"wattle\", .{ .target = target, .optimize = optimize, .docstrings = docstrings });\n"
        "    const host = b.dependency(\"wattle\", .{ .target = b.graph.host, .optimize = .debug, .docstrings = docstrings });\n")
      :web
      (buffer/push! b
        "    const host = b.dependency(\"wattle\", .{ .target = b.graph.host, .optimize = .debug, .docstrings = false, .sourcemaps = false });\n")
      (buffer/push! b
        "    const dep = b.dependency(\"wattle\", .{ .target = target, .optimize = optimize });\n"))
    (var i 0)
    (each artifact chosen
      (def artifact-name (pkg-zig-string (get artifact :name)))
      (case kind
        :web
        (do
          (buffer/format! b "    const web%d = wattle.wattleWeb(host, .{\n" i)
          (buffer/format! b "        .name = \"%s\",\n" artifact-name)
          (buffer/format! b "        .source = %s,\n" (zig-path (get artifact :entry)))
          (buffer/push! b
            "        .optimize = optimize,\n"
            "    });\n")
          (buffer/format! b "    web%d.install(b);\n" i))
        :exe
        (do
          (buffer/format! b "    const exe%d = wattle.wattleExecutable(dep, host, .{\n" i)
          (buffer/format! b "        .name = \"%s\",\n" artifact-name)
          (buffer/format! b "        .source = %s,\n" (zig-path (get artifact :entry)))
          (buffer/push! b "        .natives = &.{\n")
          (each lib-name (get artifact :libs [])
            (def lib (get libs lib-name))
            (buffer/format! b "            .{ .name = \"%s\", .root = %s },\n"
                            (pkg-zig-string lib-name) (zig-path (get lib :root))))
          (buffer/push! b
            "        },\n"
            "        .target = target,\n"
            "        .optimize = optimize,\n"
            "    });\n")
          (buffer/format! b "    b.installArtifact(exe%d);\n" i))
        (do
          (buffer/format! b "    const mod%d = b.createModule(.{\n" i)
          (buffer/format! b "        .root_source_file = %s,\n" (zig-path (get artifact :root)))
          (buffer/push! b
            "        .target = target,\n"
            "        .optimize = optimize,\n"
            "    });\n")
          (buffer/format! b "    mod%d.addImport(\"wattle\", wattle.wattleModule(dep, target, optimize));\n" i)
          (buffer/format! b "    const lib%d = b.addLibrary(.{\n" i)
          (buffer/format! b "        .name = \"%s\",\n" artifact-name)
          (buffer/format! b "        .linkage = .dynamic,\n        .root_module = mod%d,\n    });\n" i)
          (buffer/format! b "    lib%d.linker_allow_shlib_undefined = true;\n" i)
          (buffer/format! b "    b.installArtifact(lib%d);\n" i)))
      (++ i))
    (buffer/push! b "}\n")
    (def zon !"")
    (buffer/push! zon
      ".{\n"
      "    .name = .wattle_project,\n"
      "    .version = \"0.0.0\",\n"
      "    .fingerprint = 0x73d368c0c079d65,\n"
      "    .dependencies = .{\n")
    (buffer/format! zon "        .wattle = .{ .path = \"%s\" },\n"
                    (pkg-zig-string (pkg-relative-path (pkg-absolute-path (get opts :dir) (get opts :gen))
                                                       (pkg-absolute-path (get opts :dir) (get opts :srcpath)))))
    (buffer/push! zon
      "    },\n"
      "    .paths = .{ \"build.zig\", \"build.zig.zon\" },\n"
      "}\n")
    {:build (string b) :zon (string zon)}))

;;;
;;;
;;; CLI Tool Main
;;;
;;;

; conditional compilation for reduced os
(def- getenv-raw (if-let [entry (in root-env 'os/getenv)] (entry :value) (fn [&])))
(defn- getenv-alias ([env-var] (getenv-alias env-var nil))
  ([env-var dflt]
    (def x (getenv-raw env-var dflt))
    (if (= x "") nil x))) ; empty string is coerced to nil

(defn- run-main
  [env subargs]
  (when-let [main (module/value env 'main true)]
    (def guard (if (get env :debug) :ydt :y))
    (defn wrap-main [&]
      (main |subargs))
    (def f (fiber/new wrap-main guard env))
    (var res nil)
    (while (fiber/can-resume? f)
      (set res (resume f res))
      (when (not= :dead (fiber/status f))
        ((debugger-on-status env) f res)))))

(defdyn *args*
  "Dynamic bindings that will contain command line arguments at program start.")

(defdyn *executable*
  """
  Name of the interpreter executable used to execute this program. Corresponds to `argv[0]` in the call to
    `int main(int argc, char **argv);`.
  """)

(defn run-image
  """
  Loads image, the bytes of an image made by ^make-image, and calls the
  `main` it defines with the elements of args, as `wattle -i` does for an
  image file. args is also put in the image's environment as ^*args*.
  natives, when given, maps module names to functions of no arguments that
  each return a native module's environment. Each is passed to
  ^module/add-native under its name before the image loads. Returns nil.
  """
  ([image args] (run-image image args nil))
  ([image args natives]
    (each [name load] (or natives {})
      (module/add-native name (load)))
    (def env (load-image image))
    (put! env *args* args)
    (run-main env args)))

(compwhen (not (dyn 'os/isatty))
  (defmacro os/isatty [&] true))

; The argument parser is gum's, evaluated here rather than imported so that
; the core image holds one private copy and no module lookup happens at start.
(def- cli-args (dofile "src/gum/args.wattle"))
(def- cli-parse-args (get (get cli-args 'parse-args) :value))
(def- cli-format-columns (get (get cli-args 'format-columns) :value))

(defn- lint-level [text]
  (or (scan-number text) (keyword text)))

; The rules that check and test share, and those that build exe and build lib.
(def- cli-lint-rules
  ["--lint-error" {:kind :single :short "e" :proxy "level" :value lint-level
                   :help "Set the lint level at which a message is an error: none, relaxed, normal, strict, all or a number (0 to 3). The default is none."}
   "--lint-warn" {:kind :single :short "w" :proxy "level" :value lint-level
                  :help "Set the lint level at which a message is a warning. It takes the same values as --lint-error. The default is normal."}])

(def- cli-target-rules
  ["--release" {:kind :single :short "r" :proxy "mode"
                :help "Optimise for safe, fast or small. The default is safe."}
   "--target" {:kind :single :short "t" :proxy "triple"
               :help "Build for a Zig target triple. The default is this machine."}])

(def- cli-web-rules
  ["--release" {:kind :single :short "r" :proxy "mode"
                :help "Optimise for safe, fast or small. The default is small."}])

(defn- cli-config [validate?]
  (def run-config
    {:validate? validate?
     :short "r"
     :help "Run a script, evaluate code or start the REPL."
     :rules
     ["--debug" {:kind :flag :short "d"
                 :help "Set the debug flag in the REPL."}
      "--eval" {:kind :multi :short "e" :proxy "code"
                :help "Evaluate a string of Wattle."}
      "--img" {:kind :flag :short "i"
               :help "Load the script argument as an image file instead of source code."}
      "--lib" {:kind :multi :short "l" :proxy "module"
               :help "Use a module before the script and the other options."}
      "--quiet" {:kind :flag :short "q"
                 :help "Hide the logo."}
      "--repl" {:kind :flag :short "r"
                :help "Enter the REPL after running all scripts."}
      "--stdin" {:kind :flag :short "s"
                 :help "Read REPL input as raw lines from stdin. Implies --repl."}
      :script {:rest? true :proxy "script"
               :help "The script to run. Every argument after it is passed to the script."}]})
  (def check-config
    {:validate? validate?
     :short "c"
     :help "Compile a script without running it and report every error."
     :rules
     ["--bail" {:kind :flag :short "b"
                :help "Stop at the first error."}
      |cli-lint-rules
      :script {:proxy "script"
               :help "The script to check. Standard input is checked when there is none."}]})
  (def test-config
    {:validate? validate?
     :short "t"
     :help "Run the test files in ./test, each in its own process."
     :rules
     ["--bail" {:kind :flag :short "b"
                :help "Stop after the first test file that fails."}
      "--file" {:kind :multi :short "f" :proxy "path"
                :help "Run only the test file at path, relative to ./test. It can be repeated and is not compatible with --no-file."}
      |cli-lint-rules
      "--no-file" {:kind :multi :short "F" :proxy "path"
                   :help "Do not run the test file at path, relative to ./test. It can be repeated and is not compatible with --file."}
      "--no-test" {:kind :multi :short "T" :proxy "name"
                   :help "Set name in the dynamic binding :test/skips for the test files. It is not compatible with --test."}
      "--seed" {:kind :single :proxy "seed" :value :integer
                :help "Set the seed that shuffles the test files and the tests in each file. The default is taken from the clock and is printed when the tests start."}
      "--test" {:kind :multi :short "t" :proxy "name"
                :help "Set name in the dynamic binding :test/tests for the test files. It is not compatible with --no-test."}]})
  (def build-config
    {:validate? validate?
     :short "b"
     :help "Build an artifact from source."
     :rules []
     :subs
     ["exe" {:validate? validate?
             :help "Build the executables that info.edn declares."
             :rules [|cli-target-rules
                     :name {:proxy "name"
                            :help "The executable to build. The default is every executable."}]}
      "img" {:validate? validate?
             :help "Compile a source file into an image."
             :rules ["--lib" {:kind :multi :short "l" :proxy "module"
                              :help "Use a module before the source is compiled."}
                     :source {:req? true :proxy "source"
                              :help "The source file to compile."}
                     :output {:proxy "output"
                              :help "The image path. The default is the source path with .wimage in place of .wattle."}]}
      "lib" {:validate? validate?
             :help "Build the native modules that info.edn declares."
             :rules [|cli-target-rules
                     :name {:proxy "name"
                            :help "The native module to build. The default is every native module."}]}
      "web" {:validate? validate?
             :help "Build the web programs that info.edn declares: an image, a runtime for a browser and the JavaScript that loads them."
             :rules [|cli-web-rules
                     :name {:proxy "name"
                            :help "The web program to build. The default is every web program."}]}]})
  (def gum-config
    {:validate? validate?
     :short "g"
     :help "Copy Gum modules into a project, or list them."
     :rules
     ["--dir" {:kind :single :short "d" :proxy "directory"
               :help "Copy into the gum directory of this directory. The default is deps."}
      "--force" {:kind :flag :short "f"
                 :help "Replace a file that differs from the Gum copy."}
      :modules {:splat? true :proxy "module"
                :help "The module to copy. Lists available modules if empty."}]})
  (def pkg-config
    {:validate? validate?
     :short "p"
     :help "Manage installed packages."
     :rules []
     :subs
     ["clean" {:validate? validate?
               :help "Uninstall all packages that are orphaned."
               :rules []}
      "install" {:validate? validate?
                 :help "Install a package from a directory, a tarball or a Git repository."
                 :rules [:source {:proxy "source"
                                  :help "A directory, a URL ending in .tar or .tar.gz, or a Git repository. The default is the current directory."}
                         :ref {:proxy "ref"
                               :help "The branch or tag to clone. It applies only to a Git repository."}]}
      "list" {:validate? validate?
              :help "List all installed packages."
              :rules []}
      "reinstall" {:validate? validate?
                   :help "Reinstall a package by name."
                   :rules [:name {:req? true :proxy "name"
                                  :help "The name of the installed package."}]}
      "uninstall" {:validate? validate?
                   :help "Uninstall a package by name."
                   :rules [:name {:req? true :proxy "name"
                                  :help "The name of the installed package."}]}
      "update" {:validate? validate?
                :help "Reinstall all installed packages."
                :rules []}]})
  {:validate? validate?
   :info {:about "The Wattle programming language."}
   :implicit "run"
   :rules
   ["--color" {:kind :flag :short "c"
               :help "Enable ANSI color output."}
    "--no-color" {:kind :flag :short "C"
                  :help "Disable ANSI color output."}
    "--prefix" {:kind :single :short "p" :proxy "path"
                 :help "Set the prefix, the root that lib/wattle, bin and share/man derive from."}
    "--version" {:kind :flag :short "v"
                 :help "Print the version string and exit."}
    "--help" {:kind :help :short "h"
              :help "Print this usage summary and exit."}]
   :subs
   ["build" build-config
    "check" check-config
    "gum" gum-config
    "pkg" pkg-config
    "run" run-config
    "test" test-config]})

; The rules are fixed, so they are checked here, while the image is generated,
; and not on every start. A parse validates the subcommand it enters, so each
; subcommand is entered once.
(def- cli-validating-config (cli-config true))
(each argv [[] ["check"] ["gum"] ["test"] ["build" "img" "source"] ["build" "exe"] ["build" "lib"] ["build" "web"]
            ["pkg" "install"] ["pkg" "install" "source" "ref"]
            ["pkg" "reinstall" "name"] ["pkg" "uninstall" "name"]
            ["pkg" "update"] ["pkg" "clean"] ["pkg" "list"]]
  (cli-parse-args "wattle" cli-validating-config argv))

(defn- apply-color
  [colorize]
  (setdyn *pretty-format* (if colorize "%.20Q" "%.20q"))
  (setdyn *err-color* (if colorize true))
  (setdyn *doc-color* (if colorize true)))

(defn- getstdin [prompt buf _]
  (file/write stdout prompt)
  (file/flush stdout)
  (file/read stdin :line buf))

(defn- cli-fail [& parts]
  (eprint |parts)
  (os/exit 1))

(def- cli-no-spawn
  """
  How a command that runs a process names what this build lacks. A reduced-OS
  build has neither `os/spawn` nor `os/stat`, and a build without processes,
  which WASI always is, keeps `os/stat`.
  """
  (compif (dyn 'os/stat) "without processes" "with reduced os"))

(defn- cli-exists?
  """
  Checks whether path names anything, a pipe or a device as well as a file, so
  that a script read from /dev/stdin or a process substitution is accepted.
  """
  [path]
  (compif (dyn 'os/stat)
    (truthy? (os/stat path :mode))
    (fexists path)))

(defn- cli-run [opts script]
  (def raw-stdin (get opts "stdin"))
  (def should-repl (or raw-stdin (get opts "repl")))
  (def quiet (get opts "quiet"))
  (def expect-image (get opts "img"))
  (var no-file true)

  ; Options are applied in a fixed order, not the order they were written in.
  (when (get opts "debug") (setdyn *debug* true) (setdyn *redef* true))

  (each library (get opts "lib" [])
    (import* library :prefix "" :exit true))

  (each code (get opts "eval" [])
    (set no-file false)
    (eval-string code))

  (when (> (length script) 0)
    (def path (get script 0))
    (def subargs (array/slice script))
    (set no-file false)
    (unless (cli-exists? path) (cli-fail "error: could not find file " path))
    (if expect-image
      (run-image (slurp path) subargs)
      (do
        (def env (make-env))
        (put! env *args* subargs)
        (dofile path :exit true :env env)
        (run-main env subargs))))

  (when (or should-repl no-file)
    (if-not quiet
      (print "Wattle " wattle/version " " (os/which) "/" (os/arch) "/" (os/compiler) " - '(doc)' for help"))
    (flush)
    (def env (make-env))
    (defn getprompt [p]
      (when-let [custom-prompt (get env *repl-prompt*)] (break (custom-prompt p)))
      (def [line] (parser/where p))
      (string "repl:" line ":" (parser/state p :delimiters) "> "))
    (def getter (if raw-stdin getstdin getline))
    (defn getchunk [buf p]
      (getter (getprompt p) buf env))
    (repl getchunk nil env)))

(defn- cli-require-prefix []
  (def root (dyn *prefix*))
  (when (or (nil? root) (empty? root))
    (cli-fail "the prefix is not set: set WATTLE_PREFIX or pass --prefix")))

(defn- cli-test-setup
  """
  Returns the source that sets the dynamic bindings the test files read.
  """
  [opts seed]
  (def out ![(string "(setdyn :test/seed " seed ") (setdyn :test/runner :wattle)")])
  (when (dyn *err-color*) (array/push! out "(setdyn :test/color? true)"))
  (each key ["test" "no-test"]
    (when-let [names (get opts key)]
      (array/push! out (string/format "(setdyn %s (map symbol %q))"
                                      (if (= key "test") ":test/tests" ":test/skips")
                                      names))))
  (each key ["lint-warn" "lint-error"]
    (when (has-key? opts key)
      (array/push! out (string/format "(setdyn *%s* %q)" key (get opts key)))))
  (string/join " " out))

(defn- cli-test-run
  """
  Runs args as a process and returns [status out err], its exit code and the
  text it wrote to stdout and to stderr.

  With the event loop the two streams are pipes read together, so neither
  fills while the other is read. Without it they are files in the temporary
  directory, read after the process exits and then removed.
  """
  [args]
  (compif (not (dyn 'os/spawn))
    (cli-fail "test is not supported " cli-no-spawn)
    (compif (dyn 'ev/gather)
      (do
        (def p (os/spawn args :p {:out :pipe :err :pipe}))
        (def [out err] (ev/gather (ev/read (p :out) :all) (ev/read (p :err) :all)))
        [(os/proc-wait p) (string (or out "")) (string (or err ""))])
      (do
        (def dir (or (os/getenv "TMPDIR") (os/getenv "TEMP") (os/getenv "TMP") "/tmp"))
        (def base (string dir "/wattle-test-" (os/getpid)))
        (def paths [(string base ".out") (string base ".err")])
        (def files (map #(file/open $ :wb) paths))
        (def status (os/proc-wait (os/spawn args :p {:out (get files 0) :err (get files 1)})))
        (each f files (file/close f))
        (def texts (map #(string (slurp $)) paths))
        (each path paths (os/rm path))
        [status |texts]))))

(defn- cli-test
  """
  Runs each test file in ./test in its own process, prints a line for each with
  its counts, prints the output of a file that failed and exits with status 1 if
  a file failed or none was run.
  """
  [opts]
  (compif (and (dyn 'os/spawn) (dyn 'os/dir) (dyn 'os/stat))
    (do
      (when (and (get opts "file") (get opts "no-file"))
        (cli-fail "cannot use both --file and --no-file"))
      (when (and (get opts "test") (get opts "no-test"))
        (cli-fail "cannot use both --test and --no-test"))
      (unless (= :directory (os/stat "test" :mode))
        (cli-fail "no directory ./test"))
      (def only (get opts "file"))
      (def skip (get opts "no-file"))
      (defn use? [path]
        (defn match? [x] (string/has-suffix? x path))
        (cond
          only (find match? only)
          skip (not (find match? skip))
          true))
      ; The files ending in .wattle under dir, in order, descending into each
      ; directory.
      (defn test-files [dir]
        (def out ![])
        (each name (sort (os/dir dir))
          (def path (string dir "/" name))
          (case (os/stat path :mode)
            :file (when (string/has-suffix? ".wattle" path) (array/push! out path))
            :directory (array/concat! out (test-files path))))
        out)
      (def files (filter use? (test-files "./test")))
      (when (empty? files) (cli-fail "no test files to run in ./test"))
      (def seed
        (or (get opts "seed")
            (math/floor (% (* 1000 (os/clock :realtime :double)) 2147483648))))
      (print "seed: " seed)
      (print)
      ; Fisher-Yates, so that a seed gives one order.
      (def rng (math/rng (string seed)))
      (var i (- (length files) 1))
      (while (> i 0)
        (def j (math/rng-int rng (+ i 1)))
        (def tmp (get files i))
        (put! files i (get files j))
        (put! files j tmp)
        (-- i))
      (def setup (cli-test-setup opts seed))
      (def exe (dyn *executable* "wattle"))
      (def prefix (if-let [p (dyn *prefix*)] ["--prefix" p] []))
      (def bail? (get opts "bail" false))
      (defn paint [code text]
        (if (dyn *err-color*) (string "\e[" code "m" text "\e[0m") text))
      (defn shown [path] (if (string/has-prefix? "./" path) (string/slice path 2) path))
      ; Each line of text after a border, which is red when colour is on.
      (defn bordered [text]
        (def border (paint 31 (if (dyn *err-color*) "│" "|")))
        (string/join "\n" (map #(string "  " border (if (empty? $) "" " ") $)
                                (string/split "\n" (string/trim text)))))
      ; Returns [tests assertions passed skipped] from the result line that the
      ; Gum test module prints when :test/runner is :wattle, or nil.
      (defn result-of [text]
        (var found nil)
        (each line (string/split "\n" text)
          (when (string/has-prefix? "wattle-test-result: " line)
            (set found (map scan-number (string/split " " (string/slice line 20))))))
        found)
      (defn without-result [text]
        (string/join "\n" (filter #(not (string/has-prefix? "wattle-test-result: " $))
                                  (string/split "\n" text))))
      (def width (apply max (map #(length (shown $)) files)))
      (def failed ![])
      (var total-tests 0)
      (var last-failed? false)
      (each path files
        (when (and bail? (not (empty? failed))) (break))
        (def [status out err]
          (cli-test-run [exe |prefix "run" |(if (empty? setup) [] ["-e" setup]) path]))
        (def result (result-of out))
        (def counts
          (if result
            (let [[tests asserts passed skipped] result]
              (+= total-tests tests)
              (string tests " tests"
                      (if (zero? status)
                        (string ", " asserts " assertions")
                        (string ", " (- tests passed skipped) " failed"))
                      (if (pos? skipped) (string ", " skipped " skipped") "")))
            ""))
        (set last-failed? (not (zero? status)))
        (def label (string (shown path) (string/repeat " " (- width (length (shown path))))))
        (if (zero? status)
          (print "  " (paint 32 (if (dyn *err-color*) "✓" "pass")) " " label "  " counts)
          (do
            (print "  " (paint 31 (if (dyn *err-color*) "✗" "fail")) " " label "  " counts)
            (each text [(without-result out) err]
              (unless (empty? (string/trim text))
                (print)
                (print (bordered text))))
            (print)
            (array/push! failed path))))
      (unless last-failed? (print))
      (print (length files) (if (= 1 (length files)) " file, " " files, ") total-tests " tests: "
             (if (empty? failed)
               "all passed"
               (string (length failed) " failed")))
      (unless (empty? failed)
        (each path failed (print "  " (shown path)))
        (os/exit 1)))
    (cli-fail "test is not supported " cli-no-spawn)))

(defn- cli-check [opts params]
  (when (has-key? opts "lint-warn") (setdyn *lint-warn* (get opts "lint-warn")))
  (when (has-key? opts "lint-error") (setdyn *lint-error* (get opts "lint-error")))
  (def bail? (get opts "bail" false))
  (if-let [path (get params :script)]
    (do
      (unless (cli-exists? path)
        (eprint "error: could not find file " path)
        (os/exit (if bail? 1 0)))
      (flycheck path :exit bail? :env (make-env)))
    (flycheck stdin :source :stdin :exit bail?)))

(defn- cli-build-img [image]
  (def params (get image :params))
  (each library (get (get image :opts) "lib" [])
    (import* library :prefix "" :exit true))
  (def path (get params :source))
  (unless (cli-exists? path) (cli-fail "error: could not find file " path))
  (def e (dofile path))
  (def output-path
    (or (get params :output)
        (string
          (if (string/has-suffix? ".wattle" path) (string/slice path 0 -8) path)
          ".wimage")))
  (spit output-path (make-image e)))

(def- cli-release-modes {"safe" "ReleaseSafe" "fast" "ReleaseFast" "small" "ReleaseSmall"})

; Kept apart from the separator so that the image holds no string that reads as
; an absolute path to a .zig file, which `res/check/image-diff.wattle` counts.
(def- cli-zig-build-file "build.zig")
(def- cli-zig-cache ".zig-cache")

(defn- cli-build-artifacts
  """
  Builds the artifacts of kind, `:exe`, `:lib` or `:web`, that the info.edn in the
  current directory declares, by writing a build.zig and a build.zig.zon under
  .zig-cache and running zig build on them. Exits with status 1 and a message
  on a failure that is not zig's own.
  """
  [kind cmd]
  (compif (dyn 'os/spawn)
    (do
      (def opts (get cmd :opts))
      (def mode (get cli-release-modes (get opts "release" (if (= kind :web) "small" "safe"))))
      (unless mode (cli-fail "release must be safe, fast or small"))
      (def dir (os/realpath (os/cwd)))
      (def info-path
        (find fexists [(string dir "/pkg/info.edn") (string dir "/info.edn")]))
      (unless info-path (cli-fail "no info.edn in " dir))
      (def info (parse (slurp info-path)))
      (def gen (string dir "/" cli-zig-cache "/wattle-build"))
      (def [src-ok src] (protect (wattle/srcpath)))
      (unless src-ok (cli-fail "error: " src))
      ; A relative prefix is relative to the working directory.
      (def [real-ok real] (protect (os/realpath src)))
      (def srcpath (if real-ok real (pkg-absolute-path dir src)))
      (def [ok files]
        (protect (pkg/zig-files info kind (get (get cmd :params) :name)
                                 {:dir dir :srcpath srcpath :gen gen})))
      (unless ok (cli-fail "error: " files))
      (def zon-path (string srcpath "/" cli-zig-build-file ".zon"))
      (unless (fexists zon-path)
        (cli-fail "the Wattle package is not at " srcpath ": " zon-path " does not exist"))
      (def [zig-ok _]
        ; A build without the event loop gives `os/spawn` a file for each pipe
        ; rather than a stream, and `file/read` reads it.
        (protect (let [p (os/spawn ["zig" "version"] :p {:out :pipe})
                       out (compif (dyn 'ev/read)
                             (ev/read (p :out) :all)
                             (file/read (p :out) :all))]
                   (os/proc-wait p)
                   (string/trim out))))
      (unless zig-ok (cli-fail "zig was not found on the PATH, and wattle build needs it"))
      (pkg-mkdirs gen)
      (each [file text] [[cli-zig-build-file (get files :build)] [(string cli-zig-build-file ".zon") (get files :zon)]]
        (def path (string gen "/" file))
        (unless (and (os/stat path :mode) (= text (slurp path)))
          (spit path text)))
      (def args
        ["zig" "build" "--build-file" (string gen "/" cli-zig-build-file)
         "--prefix" (string dir "/zig-out") "--cache-dir" (string dir "/" cli-zig-cache)
         (string "-Doptimize=" mode)
         |(if-let [triple (get opts "target")] [(string "-Dtarget=" triple)] [])])
      (def status (os/execute args :p))
      (unless (zero? status) (os/exit status))
      (print "built " kind " in " dir "/zig-out"))
    (cli-fail "build " kind " is not supported " cli-no-spawn)))

(defn- cli-build [build]
  (def sub (get build :sub))
  (case (get sub :cmd)
    "img" (cli-build-img sub)
    "exe" (cli-build-artifacts :exe sub)
    "lib" (cli-build-artifacts :lib sub)
    "web" (cli-build-artifacts :web sub)))

(defn- cli-pkg-hint
  """
  Returns the line that follows the message of err, or nil. The line names the
  command that installs a package again, for the error that a package is
  already installed.
  """
  [err]
  (def before "package \"")
  (def after "\" is already installed")
  (when (and (string? err) (string/has-prefix? before err) (string/has-suffix? after err))
    (def name (string/slice err (length before) (- (length err) (length after))))
    (string "use 'wattle pkg reinstall " name "' to install it again")))

(defn- cli-pkg [pkg]
  (def verb (get pkg :sub))
  (def params (get verb :params))
  (compif (dyn 'pkg/list)
    (do
      (cli-require-prefix)
      (try
        (case (get verb :cmd)
          "install" (let [ref (get params :ref)]
                      (pkg/install (get params :source ".") |(if ref [:ref ref] [])))
          "reinstall" (pkg/reinstall (get params :name))
          "uninstall" (pkg/uninstall (get params :name))
          "update" (pkg/update-all)
          "clean" (pkg/prune)
          "list" (each l (pkg/list) (print l)))
        ([err fib]
          ; Only a message that pkg raised on purpose is printed without a trace.
          (unless (and (string? err) (get pkg-expected err))
            (propagate err fib))
          (eprint "error: " err)
          (when-let [hint (cli-pkg-hint err)] (eprint hint))
          (os/exit 1))))
    (cli-fail "pkg " (get verb :cmd) " is not supported with reduced os")))

(defn- cli-gum
  """
  Prints `Available modules:` and then the name and description of each module
  that modules.edn in the installed Gum lists, or, given names, copies the
  files of those modules, and the Gum LICENSE once, into the gum directory of
  the --dir option, `deps` by default. Copies nothing and exits with status 1
  and a message on a name the list does not hold or on a destination file that
  differs from its source, unless --force is set.
  """
  [opts params]
  (compif (and (dyn 'os/stat) (dyn 'os/mkdir))
    (do
      (cli-require-prefix)
      (def source-dir (string (wattle/srcpath) "/src/gum"))
      (def list-path (string source-dir "/modules.edn"))
      (unless (fexists list-path)
        (cli-fail "the Gum modules are not at " source-dir ": " list-path " does not exist"))
      (def modules (edn/decode (slurp list-path) :p))
      (def names (get params :modules []))
      (if (empty? names)
        (do
          (print "Available modules:\n")
          (print (cli-format-columns (map #(tuple (get $ :name) (get $ :help)) modules))))
        (do
          (def by-name !{})
          (each module modules (put! by-name (get module :name) module))
          (def unknown (filter #(not (get by-name $)) names))
          (unless (empty? unknown)
            (cli-fail "unknown Gum module: " (string/join ", " unknown)
                  "\nrun gum with no arguments to list the modules"))
          (def target-dir (string (get opts "dir" "deps") "/gum"))
          (def force? (get opts "force" false))
          (def copies ![])
          (defn plan [from to]
            (def content (string (slurp from)))
            (def present? (fexists to))
            (def same? (and present? (= content (string (slurp to)))))
            (when (and present? (not same?) (not force?))
              (cli-fail to " exists and differs from the Gum copy; use --force to replace it"))
            (array/push! copies [to content same?]))
          (each name names
            (each file (get (get by-name name) :files)
              (plan (string source-dir "/" file) (string target-dir "/" file))))
          (plan (string source-dir "/LICENSE") (string target-dir "/LICENSE"))
          (pkg-mkdirs target-dir)
          (each [to content same?] copies
            (unless same? (spit to content))
            (print (if same? "unchanged " "copied ") to)))))
    (cli-fail "gum is not supported with reduced os")))

(defn cli-main
  """
  Entrance for the Wattle CLI tool. Invokes the CLI interface when called with the command line
  arguments as an array or tuple of strings.
  """
  [args]

  (setdyn *args* args)

  (when-let [home (getenv-alias "WATTLE_PREFIX")]
    (setdyn *prefix* home))
  (apply-color
    (and
      (not (getenv-alias "NO_COLOR"))
      (os/isatty stdout)
      (os/isatty stderr)))

  (def executable (dyn *executable* "wattle"))
  (def result (cli-parse-args executable (cli-config false) args))
  (unless (empty? (get result :err))
    (eprin (get result :err))
    (os/exit 1))
  (unless (empty? (get result :help))
    (prin (get result :help))
    (os/exit 0))

  (def opts (get result :opts))
  (when (get opts "version") (print wattle/version) (os/exit 0))
  (when (has-key? opts "prefix") (setdyn *prefix* (get opts "prefix")))
  (when (get opts "color") (apply-color true))
  (when (get opts "no-color") (apply-color false))

  (def sub (get result :sub))
  (case (get sub :cmd)
    "run" (cli-run (get sub :opts) (or (get (get sub :params) :script) []))
    "check" (cli-check (get sub :opts) (get sub :params))
    "test" (cli-test (get sub :opts))
    "build" (cli-build sub)
    "gum" (cli-gum (get sub :opts) (get sub :params))
    "pkg" (cli-pkg sub)))

;;;
;;;
;;; Bootstrap
;;;
;;;

(do

  ; Modify root-env to remove private symbols and
  ; flatten nested tables.
  (loop [[k v] :in (pairs root-env)
         :when (symbol? k)]
    (def flat (table/proto-flatten v))
    (when (boot/config :no-docstrings)
      (put! flat :doc nil)
      (put! flat :sigs nil))
    (when (boot/config :no-sourcemaps)
      (put! flat :source-map nil))
    (unless (boot/config :no-docstrings)
      (unless (v :private)
        (unless (v :doc)
          (errorf "no docs: %v %p" k v)))) ; make sure we have docs
    ; Fix directory separators on windows to make image identical between windows and non-windows
    (when-let [sm (get flat :source-map)]
      (put! flat :source-map [(string/replace-all "\\" "/" (sm 0)) (sm 1) (sm 2)]))
    (if (v :private)
      (put! root-env k nil)
      (put! root-env k flat)))
  (put! root-env 'boot/config nil)
  (put! root-env 'boot/args nil)

  ; Build dictionary for loading images
  (def load-dict (env-lookup root-env))
  (each [k v] (pairs load-dict)
    ; Drop simple types, otherwise we get odd issues when loading foreign data from a different Janet version.
    ; It also doesn't usually save any space to encode these anyway.
    (if (or (string? v) (keyword? v) (number? v)) (put! load-dict k nil)))
  (merge! load-image-dict load-dict)

  (def image
    (let [env-pairs (pairs (env-lookup root-env))
          essential-pairs (filter (fn [[k v]] (or (nfunction? v) (abstract? v))) env-pairs)
          lookup (from-pairs essential-pairs)
          reverse-lookup (invert lookup)]
      ; Check no duplicate values
      (def temp !{})
      (each [k v] lookup
        (if (in temp v) (errorf "duplicate value: %v" v))
        (put! temp v k))
      (marshal root-env reverse-lookup)))

  ; Write the core image out. `src/runtime/env.zig` embeds the file with
  ; `@embedFile`. `spit` defaults to `:wb`, which writes a marshalled stream
  ; without translating a 0x0A.
  (var image-out nil)
  (each [k v] (partition 2 (tuple/slice boot/args 2))
    (when (= k "image-out") (set image-out v)))
  (unless image-out (error "boot: no `image-out <path>` in boot/args"))
  (spit image-out image))
