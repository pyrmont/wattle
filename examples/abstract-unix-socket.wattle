; A server and a client on an abstract Unix domain socket. A name that begins
; with @ is an abstract socket, which has no file in the file system. Abstract
; sockets exist only on Linux.
;
;     wattle examples/abstract-unix-socket.wattle

(ev/spawn (net/server :unix "@abc123" (fn [conn] (print (:read conn 1024)) (:close conn))))
(ev/sleep 1)
(def s (net/connect :unix "@abc123" :stream))
(:write s "hello")
(:close s)
