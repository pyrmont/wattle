; Tables with weak keys, weak values, or both. After `gccollect`, an entry
; whose weak key or weak value is not referenced elsewhere is removed.
;
;     wattle examples/weak-tables.wattle

(def weak-k (table/weak-keys 10))
(def weak-v (table/weak-values 10))
(def weak-kv (table/weak 10))

(put! weak-kv (gensym) 10)
(put! weak-kv :hello :world)
(put! weak-k :abc123zz77asda :stuff)
(put! weak-k true :abc123zz77asda)
(put! weak-k :zyzzyz false)
(put! weak-v (gensym) 10)
(put! weak-v 20 (gensym))
(print "before gc")
(tracev weak-k)
(tracev weak-v)
(tracev weak-kv)
(gccollect)
(print "after gc")
(tracev weak-k)
(tracev weak-v)
(tracev weak-kv)
