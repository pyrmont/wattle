; Finds the largest sum along a path from the top of a triangle of numbers to
; its bottom row. `reduce` folds the rows from the top.
;
;     wattle examples/maxtriangle.wattle

(defn myfold [xs ys]
  (let [m1 (map + [|xs 0] ys)
        m2 (map + [0 |xs] ys)]
    (map max m1 m2)))

(defn maxpath [t]
  (extreme > (reduce myfold () t)))

; Maximum path is 3 -> 10 -> 3 -> 9 for a total of 25

(def triangle 
  [[3]
   [7 10]
   [4 3 7]
   [8 9 1 3]])

(print (maxpath triangle))
