; A SIGTERM handler set with `os/sigaction`. The argument selects one of four
; cases. A handler set with interrupt true runs while the script is busy. A
; handler set without it runs only when the event loop runs, so in case 2,
; which loops without yielding, the handler never runs.
;
;     wattle res/examples/sigaction.wattle 1|2|3|4 &
;     kill -s TERM $!

(defn action
  []
  (print "Handled SIGTERM!")
  (flush)
  (os/exit 1))

(defn main1
  []
  (os/sigaction :term action true)
  (forever))

(defn main2
  []
  (os/sigaction :term action)
  (forever))

(defn main3
  []
  (os/sigaction :term action true)
  (forever (ev/sleep math/inf)))

(defn main4
  []
  (os/sigaction :term action)
  (forever (ev/sleep math/inf)))

(defn main
  [& args]
  (def which (scan-number (get args 1 "1")))
  (case which
    1 (main1) ; should work
    2 (main2) ; will not work
    3 (main3) ; should work
    4 (main4) ; should work
    (error "bad main")))
