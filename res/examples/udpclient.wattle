; A client for `res/examples/udpserver.wattle`. It sends sixteen random bytes,
; formatted as a string, to 127.0.0.1 port 8009 and prints the reply.
;
;     wattle res/examples/udpclient.wattle

(def conn (net/connect "127.0.0.1" "8009" :datagram))
(:write conn (string/format "%q" (os/cryptorand 16)))
(def x (:read conn 1024))
(pp x)

