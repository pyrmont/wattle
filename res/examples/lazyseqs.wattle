; An implementation of lazy sequences. A sequence is a function that returns
; nil when the sequence is empty, and otherwise returns a vector of the first
; value and the rest of the sequence. The function computes the vector on its
; first call and returns the same vector on later calls. Import it with:
;
;     (import "./res/examples/lazyseqs" :prefix "seq.")

(defmacro dolazy
  "Returns a function that evaluates forms on its first call and returns the
  value of the last one. Later calls return that value without evaluating
  forms again."
  [& forms]
  (def state (gensym))
  (def loaded (gensym))
  `(do
     (var ~state nil)
     (var ~loaded nil)
     (fn []
       (if ~loaded
         ~state
         (do
           (set ~loaded true)
           (set ~state (do ~|forms)))))))

(def- HEAD 0)
(def- TAIL 1)

(defn empty-seq
  "The empty sequence."
  [] nil)

(defn cons
  "Returns a sequence of h followed by the values of s."
  [h s]
  (fn [] [h s]))

(defn lazy-empty?
  "Returns true if s has no values."
  [s]
  (not (s)))

(defn head
  "Returns the first value of s."
  [s]
  (get (s) HEAD))

(defn tail
  "Returns the sequence of the values of s after the first."
  [s]
  (get (s) TAIL))

(defn lazy-range
  "Returns a sequence of the integers from start up to but not including end.
  With one argument, start is 0."
  ([end] (lazy-range 0 end))
  ([start end]
    (dolazy
      (when (< start end)
        [start (lazy-range (+ 1 start) end)]))))

(defn lazy-map
  "Returns a sequence of the results of calling f on each value of s."
  [f s]
  (dolazy
    (def x (s))
    (when x
      [(f (get x HEAD)) (lazy-map f (get x TAIL))])))

(defn realize
  "Computes every value of s."
  [s]
  (when (s) (realize (tail s))))

(defn realize-map
  "Calls f on each value of s in turn."
  [f s]
  (when (s) (f (head s)) (realize-map f (tail s))))

(defn lazy-drop
  "Returns the sequence of the values of s after the first n."
  [n s]
  (dolazy
    (def x (s))
    (if (and x (pos? n))
      ((lazy-drop (- n 1) (get x TAIL)))
      x)))

(defn lazy-take
  "Returns a sequence of at most the first n values of s."
  [n s]
  (dolazy
    (def x (s))
    (when (and x (pos? n))
      [(get x HEAD) (lazy-take (- n 1) (get x TAIL))])))

(defn randseq
  "Returns an infinite sequence of random numbers."
  []
  (dolazy [(math/random) (randseq)]))

(defn lazy-take-while
  "Returns a sequence of the values of s up to the first one for which pred is
  false."
  [pred s]
  (dolazy
    (def x (s))
    (when (and x (pred (get x HEAD)))
      [(get x HEAD) (lazy-take-while pred (get x TAIL))])))
