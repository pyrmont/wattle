; Phase 9 benchmark corpus.
;
; Seven workloads chosen to separate what the interpreter loop does from what
; it calls: two that are almost pure dispatch, two that are call-heavy, one
; that builds data structures, one that spends its time in the compiler, and
; one that spends it in the PEG engine and should therefore move least. Each
; prints its own elapsed time, so the runner never pays for process startup.

(defn- bench [name f]
  (def start (os/clock :monotonic))
  (f)
  (def stop (os/clock :monotonic))
  (printf "%s %.6f" name (- stop start)))

; Arithmetic and jumps only: the highest density of dispatches per unit of work
; anywhere in the corpus, and the closest thing to the probe's `loop` program.
(defn- arithmetic []
  (var acc 0)
  (for i 0 5000000
    (set acc (+ acc (* i 3) (- i 1))))
  acc)

; Naive recursion: one Janet call per node, so every iteration pays a frame
; push, a JOP_CALL, and a return.
(defn- fib [n] (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))

; Method dispatch: JOP_CALL through resolve_method and a table lookup.
(def- counter-proto
  !{:bump (fn [self n] (set (self :count) (+ (self :count) n)) self)
    :read (fn [self] (self :count))})

(defn- methods []
  (def obj (table/setproto !{:count 0} counter-proto))
  (for i 0 400000
    (:bump obj 1))
  (:read obj))

; Data structures: JOP_MAKE_TABLE, JOP_MAKE_STRUCT, JOP_PUT, JOP_IN and the
; iteration protocol behind them.
(defn- tables []
  (var total 0)
  (for i 0 60000
    (def t !{:a i :b (+ i 1) :c (string i)})
    (def s {:a i :b (+ i 1)})
    (set (t :d) (s :a))
    (each [k v] (pairs t)
      (when (number? v) (set total (+ total v)))))
  total)

; Strings and buffers: JOP_MAKE_STRING plus the string nfunctions.
(defn- strings []
  (def b !"")
  (for i 0 200000
    (buffer/push-string b (string "item-" i ";")))
  (length (string/split ";" (string b))))

; The compiler front end: parse and compile, with the interpreter mostly idle.
(def- compile-source
  (string/repeat
    "(defn f [a b] (let [c (+ a b) d (* a b)] (if (< c d) [c d] {:c c :d d})))\n"
    40))

(defn- compiler []
  (var n 0)
  (for i 0 200
    (def p (parser/new))
    (parser/consume p compile-source)
    (while (parser/has-more p)
      (compile (parser/produce p) (make-env) "bench")
      (set n (+ n 1))))
  n)

; A PEG match: the work happens inside peg.c, so this is the control. A
; dispatch change that moves this number is measuring something else.
(def- word-peg (peg/compile '(any (+ (<- (some (range "az" "AZ"))) 1))))
(def- peg-text (string/repeat "the quick brown fox jumps over 13 lazy dogs. " 400))

(defn- pegmatch []
  (var n 0)
  (for i 0 200
    (set n (+ n (length (peg/match word-peg peg-text)))))
  n)


; --- The entry points above the loop -------------------------------------
;
; Nothing above reaches them. A Janet function called from Janet goes through
; JOP_CALL, not through janet_call, so Part 4's increment was invisible to the
; seven workloads above and had to be measured with loops built for it. The
; gate keeps them, so that the corpus covers the phase rather than its loop.

; janet_call by way of the binary operator fallback: JOP_ADD meets a value it
; cannot add and janet_binop_call enters the method through janet_call.
(def- adder-proto !{:+ (fn [self other] (+ (self :v) other))})

(defn- opfallback []
  (def o (table/setproto !{:v 1} adder-proto))
  (var acc 0)
  (for i 0 300000
    (set acc (+ acc (+ o i))))
  acc)

; janet_call by way of a PEG capture holding a function constant: the PEG
; engine is C, so the only way back into Janet is an entry point.
(def- double-it (fn [s] (* 2 (scan-number s))))
(def- digit-peg (peg/compile `(any (+ (/ (<- (some (range "09"))) ~double-it) 1))))
(def- digit-text (string/repeat "ab 12 cd 345 ef 6 " 300))

(defn- pegcall []
  (var n 0)
  (for i 0 60
    (set n (+ n (length (peg/match digit-peg digit-text)))))
  n)

; janet_continue and the resume check: every resume re-enters the interpreter
; from the top, and janet_pcall wraps the fiber the loop runs in.
(defn- fibers []
  (var n 0)
  (for i 0 150000
    (def f (fiber/new (fn [] (yield 1) 2)))
    (resume f)
    (resume f)
    (set n (+ n 1)))
  n)

(bench "arithmetic" arithmetic)
(bench "fib" (fn [] (fib 28)))
(bench "methods" methods)
(bench "tables" tables)
(bench "strings" strings)
(bench "compiler" compiler)
(bench "pegmatch" pegmatch)
(bench "opfallback" opfallback)
(bench "pegcall" pegcall)
(bench "fibers" fibers)
