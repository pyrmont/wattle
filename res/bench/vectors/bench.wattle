; The vector corpus: persistent vectors against tuples and arrays, from 2
; elements to 1,000, reading, building and binding.
;
; Written on 2026-09-17 to decide whether a vector should be a built-in type
; rather than an abstract, which notes/LANGUAGE.md records with the figures
; this gave. A tuple is a built-in type the interpreter reaches by tag, so a
; vector's time over a tuple's is an upper bound on what making the vector
; built-in could win. A vector of up to 32 elements is its tail alone, one
; flat run as a tuple is, so at those sizes the gap is dispatch rather than
; the trie. The array rows are a built-in type with the same storage as a
; tuple, for reference.
;
; Elements are built at runtime and every constructor is a call, so nothing
; folds. The `lit` rows build a tuple through the `[...]` literal, which is
; the `make_bracket_tuple` opcode, against the same tuple built by calling
; `tuple`: the difference is what an opcode saves over a call.
;
; The workloads pair up by name, `-tuple-` against `-vector-`, and the result
; is the ratio of each pair at each size. The loop around a read costs more
; than many reads do, so each size has a `loop-` row running the same loop
; with no read, and a read's own time is its row less that one. The counts are sized for
; `ReleaseFast`. On a runtime with no `vector` the vector rows do not run, so
; the corpus also runs on C Janet.

(defn- bench [name f]
  (def start (os/clock :monotonic))
  (f)
  (def stop (os/clock :monotonic))
  (printf "%s %.6f" name (- stop start)))

(def- kinds
  (array/concat
    ![["tuple" 'tuple] ["array" 'array]]
    (if (dyn 'vector) ![["vector" 'vector]] ![])))

; Every read workload makes this many reads, and `each` and `splice` read this
; many elements, whatever the size.
(def- ops 8000000)

(defn- run-size [n reps]
  (bench (string "loop-" n)
         (fn [] (var a 0) (for i 0 ops (+= a (% i n))) a))
  (each [name ctor] kinds
    (def f (eval `(fn [i] (~ctor ~|(map (fn [_] 'i) (range n))))))
    (def v (f 7))
    (bench (string "build-" name "-" n) (fn [] (for i 0 reps (f i))))
    (bench (string "get-" name "-" n)
           (fn [] (var a 0) (for i 0 ops (+= a (get v (% i n)))) a))
    (bench (string "in-" name "-" n)
           (fn [] (var a 0) (for i 0 ops (+= a (in v (% i n)))) a))
    (bench (string "call-" name "-" n)
           (fn [] (var a 0) (for i 0 ops (+= a (v (% i n)))) a))
    (bench (string "length-" name "-" n)
           (fn [] (var a 0) (for i 0 ops (+= a (length v))) a))
    (bench (string "indexed-" name "-" n)
           (fn [] (var a 0) (for i 0 ops (if (indexed? v) (++ a))) a))
    (bench (string "each-" name "-" n)
           (fn [] (var a 0) (for i 0 (div ops n) (each x v (+= a x))) a))
    (bench (string "splice-" name "-" n)
           (fn [] (var a 0) (for i 0 (div ops n) (+= a (+ |v))) a))
    (bench (string "bind-" name "-" n)
           (fn [] (var a 0) (for i 0 ops (def [x y] v) (+= a x y)) a)))
  (when (<= n 32)
    (def f (eval `(fn [i] [~|(map (fn [_] 'i) (range n))])))
    (bench (string "build-lit-" n) (fn [] (for i 0 reps (f i))))))

(run-size 2 2000000)
(run-size 8 1000000)
(run-size 32 300000)
(run-size 100 100000)
(run-size 1000 10000)
